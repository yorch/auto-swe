---
/**
 * Real screens from the dashboard, captured from a fresh local install.
 *
 * Each frame is chosen to show one idea the docs otherwise only describe in prose:
 * a workflow is a versioned graph, an agent is a row of data, a security rule is
 * something an admin edits, and a setting says which scope it resolved from. The run
 * viewer and the approvals inbox are absent on purpose: a fresh install has no runs
 * to show, and a screenshot of seeded fake runs would claim something nobody saw.
 */

import { Image } from 'astro:assets';
import agents from '../assets/screens/agents-library.webp';
import settings from '../assets/screens/govern-platform-settings.webp';
import scanner from '../assets/screens/govern-scanner-patterns.webp';
import template from '../assets/screens/template-detail-default-engineering.webp';

const lead = {
  alt: 'The default-engineering template in the dashboard: its workflow graph on a canvas, with version, run schema, and webhook trigger cards beside it.',
  body: 'Every workflow is a versioned graph. Edit it on the canvas, save a new version, and A/B test it against the one running now.',
  image: template,
  title: 'Workflows you can read and edit',
};

const rest = [
  {
    alt: 'The Agent Library table, listing agents with their model, skills, tools, scope, and version.',
    body: 'Model, prompt, skills, and tools per agent, overridable per team — data, not code.',
    image: agents,
    title: 'Agents are rows',
  },
  {
    alt: 'The Scanner Patterns page listing built-in injection-detection regexes with toggles.',
    body: 'The patterns the six runtime scanners match, extendable by an admin.',
    image: scanner,
    title: 'Security rules you can see',
  },
  {
    alt: 'The platform settings form, each setting showing its key, default, and which scope its value came from.',
    body: 'Each setting says which scope its value resolved from, and who may change it.',
    image: settings,
    title: 'Policy with a source',
  },
];
---

<section class="frames" aria-labelledby="frames-title">
  <h2 id="frames-title" class="frames__title">Inside the dashboard</h2>

  <figure class="frame frame--lead">
    <Image
      src={lead.image}
      alt={lead.alt}
      widths={[720, 1080, 1440]}
      sizes="(min-width: 78rem) 72rem, 92vw"
      loading="lazy"
    />
    <figcaption>
      <strong>{lead.title}</strong>
      {lead.body}
    </figcaption>
  </figure>

  <div class="frames__rest">
    {rest.map((frame) => (
      <figure class="frame">
        <Image
          src={frame.image}
          alt={frame.alt}
          widths={[480, 720, 960]}
          sizes="(min-width: 60rem) 24rem, 92vw"
          loading="lazy"
        />
        <figcaption>
          <strong>{frame.title}</strong>
          {frame.body}
        </figcaption>
      </figure>
    ))}
  </div>
</section>

<style>
  .frames {
    margin-top: clamp(4rem, 8vw, 6.5rem);
  }

  .frames__title {
    margin: 0 0 1.75rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--step-4);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .frame {
    margin: 0;
  }

  /*
   * The dashboard is dark, so each screen sits in a panel-coloured bezel — the
   * same material as the hero — rather than floating on the enamel with a shadow.
   */
  .frame img {
    display: block;
    width: 100%;
    height: auto;
    padding: 6px;
    background: var(--panel);
    border-radius: 12px;
    box-shadow: inset 0 0 0 1px var(--panel-line);
  }

  .frame figcaption {
    max-width: 60ch;
    margin-top: 0.85rem;
    font-size: var(--step--1);
    line-height: 1.5;
    color: var(--ink-muted);
  }

  .frame figcaption strong {
    display: block;
    margin-bottom: 0.15rem;
    font-size: var(--step-0);
    font-weight: 700;
    color: var(--ink);
  }

  .frames__rest {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem clamp(1rem, 2.5vw, 2rem);
    margin-top: 2.5rem;
  }

  @media (max-width: 60rem) {
    .frames__rest {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
