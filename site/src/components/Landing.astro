---
/**
 * The landing page.
 *
 * The signal panel at the top is the one bold thing on the page; everything below
 * it is set quietly on the enamel, so the panel keeps its weight. The use-case rows
 * are read from the data file the sync script generates from the built-in templates,
 * so the people listed against each row are the gates its spec actually has.
 */

import useCases from '../data/useCases.json';
import SignalPanel from './SignalPanel.astro';
import SystemDiagram from './SystemDiagram.astro';

const BASE = '/auto-swe';

/**
 * Which use cases the landing page shows, one or two per team, in this order. Every
 * other template is one click away on the index; this list only chooses the
 * examples that best show the range.
 */
const FEATURED = [
  'default-engineering',
  'dependency-update',
  'migration',
  'four-eyes',
  'security-triage',
  'canary-rollout',
  'prd-decomposition',
  'zendesk-ticket-reply',
  'notion-content-brand-review',
];

const GROUP_LABEL: Record<string, string> = {
  content: 'Content and comms',
  engineering: 'Ship code changes',
  people: 'People in the loop',
  product: 'Product',
  release: 'Gate a release',
  support: 'Support',
};

const PERSON_KIND: Record<string, string> = {
  approval: 'Approves',
  decision: 'Decides',
  input: 'Fills in',
  merge: 'Merges',
  review: 'Reviews',
};

const featured = FEATURED.map((name) => {
  const useCase = useCases.find((u) => u.name === name);
  if (!useCase) {
    throw new Error(`Landing page features "${name}", which is not a built-in template.`);
  }
  return useCase;
});

const reasons = [
  {
    body: 'Every run is a Temporal workflow, so a crash, a restart, a deploy, or a provider rate limit does not lose it. Determinism is not assumed either — CI replays recorded histories against the current workflow code, because running forward against fakes cannot catch a change that takes a different path on replay.',
    claim: 'It survives things going wrong',
  },
  {
    body: 'Approval, decision, input, and review nodes pause a run and wait for a person. Which model an agent binds, which prompt it carries, which skills and tools it may reach for — all of it resolves per team through a five-level scope cascade, as data rather than code.',
    claim: 'You decide what it may do',
  },
  {
    body: 'Six scanners run during execution. Sensitive-file paths and shell commands are checked before a write lands, the diff is scanned after the commit, and skill text and model output are checked as advisory. The blocking scanners fail closed: a scan that cannot finish cannot call the input clean.',
    claim: 'It watches what the agent writes',
  },
  {
    body: 'Lessons from merged work are embedded into pgvector and retrieved as context for later runs on the same codebase, so a correction made once does not have to be made again.',
    claim: 'It gets better at your repository',
  },
  {
    body: 'Every model call is priced and attributed to the run that made it, under a token budget per tier. A model with no price recorded still records its usage, so a pricing gap costs you a number and never a run.',
    claim: 'You can see what it cost',
  },
];

const starting = [
  {
    blurb: 'The shortest complete picture of the system, and how to run it locally',
    href: `${BASE}/introduction/`,
    title: 'Introduction',
  },
  {
    blurb: 'Who it is for, the capability map, and what is deliberately out of scope',
    href: `${BASE}/docs/product-overview/`,
    title: 'Product overview',
  },
  {
    blurb: 'Run lifecycle, the workflow engine and its node types, the data model',
    href: `${BASE}/docs/architecture/`,
    title: 'Architecture',
  },
  {
    blurb: 'The production runbook, end to end',
    href: `${BASE}/docs/deployment/`,
    title: 'Deployment',
  },
];
---

<div class="landing not-content">
  <SignalPanel />

  <div class="landing__body">
    <section class="band" aria-labelledby="uses-title">
      <h2 id="uses-title" class="band__title">What teams run on it</h2>
      <p class="band__lede">
        One engine, {useCases.length} workflows shipped as templates. Each row lists the places a
        person acts in that run, read from the template's own spec.
      </p>

      <ol class="uses">
        {featured.map((useCase, i) => (
          <li class="use">
            <span class="use__group">
              {(i === 0 || featured[i - 1].group !== useCase.group) && GROUP_LABEL[useCase.group]}
            </span>
            <span class="use__main">
              <a class="use__title" href={useCase.href}>{useCase.title}</a>
              <span class="use__summary">{useCase.summary}</span>
            </span>
            <span class="use__people">
              {useCase.people.length === 0 ? (
                <span class="use__none">No person inside the run</span>
              ) : (
                useCase.people.map((person) => (
                  <span class="use__person">
                    <span class="use__kind">{PERSON_KIND[person.kind] ?? person.kind}</span>
                    {person.label}
                  </span>
                ))
              )}
              {useCase.maturity === 'seeded' && (
                <span class="use__maturity">Seeded, not yet proven</span>
              )}
            </span>
          </li>
        ))}
      </ol>
      <p class="band__more">
        <a href={`${BASE}/use-cases/`}>All {useCases.length} use cases, with their workflow graphs</a>
      </p>
    </section>

    <section class="band" aria-labelledby="fit-title">
      <h2 id="fit-title" class="band__title">How it fits together</h2>
      <p class="band__lede">
        Your team works where it already works. auto-swe runs the workflow durably in between, and
        touches your systems on the far side.
      </p>
      <SystemDiagram />
    </section>

    <section class="band" aria-labelledby="why-title">
      <h2 id="why-title" class="band__title">Why it is built this way</h2>
      <dl class="reasons">
        {reasons.map((reason) => (
          <div class="reason">
            <dt class="reason__claim">{reason.claim}</dt>
            <dd class="reason__body">{reason.body}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="band" aria-labelledby="read-title">
      <h2 id="read-title" class="band__title">Start reading</h2>
      <ul class="starting">
        {starting.map((doc) => (
          <li class="starting__item">
            <a class="starting__link" href={doc.href}>{doc.title}</a>
            <span class="starting__blurb">{doc.blurb}</span>
          </li>
        ))}
      </ul>
      <p class="band__note">
        These docs describe how auto-swe works now, in present tense. Every capability page ends
        with a <a href={`${BASE}/docs/`}>Limitations</a> section stating what is not built, not
        proven, or deliberately constrained — and a page that drops one fails the build. The
        use-case pages say the same of each workflow.
      </p>
    </section>
  </div>
</div>

<style>
  .landing__body {
    max-width: 78rem;
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 5vw, 4rem);
    padding-bottom: 6rem;
  }

  .band {
    margin-top: clamp(4rem, 8vw, 6.5rem);
  }

  .band__title {
    margin: 0 0 1.25rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--step-4);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .band__lede {
    max-width: 58ch;
    margin: 0 0 2.25rem;
    font-size: var(--step-1);
    line-height: 1.55;
    color: var(--ink-muted);
  }

  /* --- Use cases ------------------------------------------------------- */

  /*
   * Rows, not cards. The group sits in its own column and is printed only on the
   * first row of each group, so the column reads as a table of contents down the
   * left edge rather than a label repeated on every line.
   */
  .uses {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 2px solid var(--ink);
  }

  .use {
    display: grid;
    grid-template-columns: minmax(0, 11rem) minmax(0, 1fr) minmax(0, 17rem);
    gap: 0.5rem 2.5rem;
    padding-block: 1.35rem;
    border-bottom: 1px solid var(--rule);
  }

  .use__group {
    font-size: var(--step--1);
    font-weight: 700;
    line-height: 1.6;
    color: var(--ink-faint);
  }

  .use__main {
    display: block;
  }

  .landing .use__title {
    font-size: var(--step-1);
    font-weight: 700;
    line-height: 1.3;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-decoration-color: var(--rule-strong);
    text-underline-offset: 0.22em;
  }

  .landing .use__title:hover {
    text-decoration-color: var(--gate);
  }

  .use__summary {
    display: block;
    max-width: 62ch;
    margin-top: 0.45rem;
    font-size: var(--step-0);
    line-height: 1.55;
    color: var(--ink-muted);
  }

  .use__people {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding-top: 0.2rem;
  }

  /*
   * Each place a person acts, marked with the gate colour — the same amber that
   * lights the held signal in the panel and the gate nodes in the diagrams.
   */
  .use__person {
    position: relative;
    padding-inline-start: 1.05rem;
    font-size: var(--step--1);
    line-height: 1.4;
    color: var(--ink);
  }

  .use__person::before {
    position: absolute;
    top: 0.3em;
    left: 0;
    width: 0.55rem;
    height: 0.55rem;
    content: '';
    background: var(--gate);
    border-radius: 2px;
  }

  .use__kind {
    display: block;
    font-weight: 700;
    color: var(--gate-text);
  }

  .use__none {
    font-size: var(--step--1);
    color: var(--ink-faint);
  }

  .use__maturity {
    align-self: flex-start;
    margin-top: 0.2rem;
    padding: 0.1rem 0.5rem 0;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--ink-muted);
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
  }

  .band__more {
    margin: 1.5rem 0 0;
    font-size: var(--step-1);
    font-weight: 700;
  }

  .landing .band__more a,
  .landing .band__note a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-decoration-color: var(--gate);
    text-underline-offset: 0.22em;
  }

  /* --- Reasons --------------------------------------------------------- */

  .reasons {
    margin: 0;
    border-top: 2px solid var(--ink);
  }

  .reason {
    display: grid;
    grid-template-columns: minmax(0, 17rem) minmax(0, 1fr);
    gap: 0.5rem 2.5rem;
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--rule);
  }

  .reason__claim {
    font-size: var(--step-1);
    font-weight: 700;
    line-height: 1.3;
    color: var(--ink);
  }

  .reason__body {
    max-width: 62ch;
    margin: 0;
    font-size: var(--step-0);
    line-height: 1.6;
    color: var(--ink-muted);
  }

  /* --- Start reading --------------------------------------------------- */

  .starting {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 2px solid var(--ink);
  }

  .starting__item {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.25rem 1.5rem 1.4rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .landing .starting__link {
    font-size: var(--step-1);
    font-weight: 700;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-decoration-color: var(--gate);
    text-underline-offset: 0.22em;
  }

  .landing .starting__link:hover {
    background: var(--gate-wash);
  }

  .starting__blurb {
    font-size: var(--step--1);
    line-height: 1.5;
    color: var(--ink-muted);
  }

  .band__note {
    max-width: 62ch;
    margin-top: 2rem;
    font-size: var(--step-0);
    line-height: 1.6;
    color: var(--ink-muted);
  }

  @media (max-width: 60rem) {
    .use {
      grid-template-columns: minmax(0, 1fr);
    }

    .use__group:empty {
      display: none;
    }

    .reason {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
