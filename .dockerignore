# ── Dependencies ────────────────────────────────────────────────
# Node (yarn-4 monorepo: gateway / web / worker / defaults)
node_modules
**/node_modules
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# ── Build output ────────────────────────────────────────────────
**/.next
**/*.tsbuildinfo

# ── Env files ───────────────────────────────────────────────────
# Ignore every env file except the committed examples.
# `.env.*` does not match `.env` itself, hence both lines; the negations come
# last so they win regardless of what appears above.
.env
.env.*
!.env.example
!**/.env.example

# ── Local infra state ───────────────────────────────────────────
# Local infra volumes created by `docker:infra:up` (root-owned).
# Anchored to the repo root so it never shadows a source dir named `data`.
# Root-owned volumes: sending them as build context bloats it and can fail with
# "error from sender: ... permission denied".
data/

# ── Docs ────────────────────────────────────────────────────────────────
# The web image's build stage runs `COPY docs/*.md docs/` — only the top level
# is served (`lib/docs.ts`), so the top-level `.md` files must stay in the
# context. `history/` (frozen plans, the HTML mocks) and `redesign/`
# (screenshots) are never copied into an image; keep them out of the context.
docs/history/
docs/redesign/

# ── Editor / IDE ────────────────────────────────────────────────
# Share project editor config; ignore everything else the editor writes.
.idea
.vscode

# ── OS ──────────────────────────────────────────────────────────
.DS_Store

# ── Logs & caches ───────────────────────────────────────────────
*.log

# ── Testing & coverage ──────────────────────────────────────────
coverage
**/coverage

# ── Project-specific ────────────────────────────────────────────
.git
.gitignore
**/dist
# Docker meta — not needed inside any image
Dockerfile
.dockerignore
docker-compose*.yml
README.md
