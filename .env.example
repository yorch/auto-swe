# ── Docker image versions (used by docker-compose.infra.yml) ───────────────
# Override to test newer/older images without editing the compose files.
# PGVECTOR_TAG=pg18                                  # pgvector/pgvector
# POSTGRES_TEMPORAL_TAG=18-alpine                    # postgres
# TEMPORAL_VERSION=1.31.0                            # temporalio/server
# TEMPORAL_ADMINTOOLS_VERSION=1.31.0                 # temporalio/admin-tools
# TEMPORAL_UI_VERSION=2.49.1                         # temporalio/ui
# MINIO_VERSION=RELEASE.2025-04-22T22-12-26Z         # minio/minio
# MINIO_MC_VERSION=RELEASE.2025-04-16T18-13-26Z      # minio/mc (bucket bootstrap)

# ── Local Docker port bindings (host side) ─────────────────────────────────
# Override any of these to avoid conflicts with other local services.
# Defaults match what `yarn docker:infra:up` and `yarn docker:up` bind by
# default; container-side ports are not affected.
# POSTGRES_PORT=5432
# TEMPORAL_GRPC_PORT=7233
# TEMPORAL_UI_PORT=8233
# GATEWAY_PORT=8080
# WEB_PORT=3000
# MINIO_API_PORT=9000                              # S3-compatible API
# MINIO_CONSOLE_PORT=9001                          # MinIO web console

# ── Gateway / Web runtime ──────────────────────────────────────────────────
# PORT — port the gateway listens on (default 8080). Overrides GATEWAY_PORT
# when the gateway runs outside Docker.
# PORT=8080
# CORS_ORIGIN — comma-separated list of allowed browser origins. First entry
# is used as the better-auth client origin / OAuth redirect base. Defaults to
# http://localhost:3000.
# CORS_ORIGIN=http://localhost:3000
# PUBLIC_URL — public base URL of the gateway, used for the Slack OAuth
# callback (`{PUBLIC_URL}/api/v1/auth/slack/callback`). Defaults to
# http://localhost:8080.
# PUBLIC_URL=http://localhost:8080
# DEFAULT_TEAM_SLUG — slug of the team that new better-auth sign-ups are
# auto-enrolled into. Defaults to `default` (seeded by `yarn db:seed`).
# DEFAULT_TEAM_SLUG=default

# ── Web app (Next.js) ──────────────────────────────────────────────────────
# NEXT_PUBLIC_* vars are injected at request time via window.__APP_CONFIG__ by
# the root Server Component (layout.tsx) — no rebuild required to change them.
# Set them as runtime env vars on the web container (docker -e / compose
# environment:). For local `yarn dev:web` put them in packages/web/.env.local.
# NEXT_PUBLIC_API_URL=https://api.example.com      # public gateway URL seen by the browser
# NEXT_PUBLIC_APP_VERSION=0.1.0
# NEXT_PUBLIC_TEMPORAL_UI_URL=https://temporal.example.com  # internal Temporal UI; omit to hide the link

# ── Database (Postgres + pgvector) ─────────────────────────────────────────
# POSTGRES_* vars are consumed by docker-compose.infra.yml when starting
# the postgres container. DATABASE_URL is read by app processes
# (gateway / worker / prisma) via Node `--env-file` and must be a literal
# DSN — Node's --env-file does not expand `${VAR}` references. Keep the
# host/credentials in DATABASE_URL in sync with the POSTGRES_* parts above.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=engineering_system
DATABASE_URL=postgresql://postgres:password@localhost:5432/engineering_system

# ── Temporal ───────────────────────────────────────────────────────────────
# TEMPORAL_NAMESPACE is the namespace created on first start by the
# temporal-setup-namespace container.
TEMPORAL_NAMESPACE=default
TEMPORAL_ADDRESS=localhost:7233

# ── LLM Providers ───────────────────────────────────────────────────────────
# LLM model + credential configuration is fully DB-driven via the dashboard
# at /admin/model-config (admins) and /teams/<id> (team owners). There are
# no model/credential env vars anymore. On a fresh deployment:
#
#   1. Run db:migrate + db:seed (creates admin user)
#   2. Start gateway + web only
#   3. Sign in as admin, click "Seed Anthropic defaults" on /admin/model-config
#      then add at least one ProviderCredential
#   4. Start the worker — it refuses to start until config is complete
#
# See docs/model-configuration.md for the full bootstrap walk-through.

# Encryption key for provider_credentials.api_key_ciphertext. AES-256-GCM,
# base64-encoded 32 bytes. REQUIRED for gateway + worker to start.
# Generate with EITHER:
#   openssl rand -base64 32
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
CONFIG_ENCRYPTION_KEY=

# Override the in-process cache TTL for resolved model config (default 30s).
# Lower for snappier dashboard edits; raise to reduce DB load.
# CONFIG_CACHE_TTL_MS=30000

# Max entries in the in-process config cache before LRU eviction (default 1000).
# CONFIG_CACHE_MAX_ENTRIES=1000

# ── Per-model price overrides (optional) ───────────────────────────────────
# Format: MODEL_PRICE_<PROVIDER>_<MODEL>=<input>:<output>  (USD per million tokens).
# Non-alphanumerics in the spec become underscores. Negative values are rejected.
# Use these for models not in the built-in MODEL_PRICES table, to apply
# enterprise-negotiated rates, or to account for caching/batch discounts.
# Example — local Ollama models cost nothing:
# MODEL_PRICE_OLLAMA_LLAMA3_1_70B=0:0

# ── GitHub integration ─────────────────────────────────────────────────────────
# These vars are accepted as bootstrap fallbacks. The preferred path is to set
# them via the admin UI at /admin/integrations → GitHub after first boot.
# Once saved in the DB you can remove them from here.
# GITHUB_TOKEN=ghp_...
# GITHUB_WEBHOOK_SECRET=whsec_...
# GITHUB_URL=https://github.com                  # GHE only — omit for github.com
# GITHUB_API_URL=https://api.github.com          # GHE only — omit for github.com

# ── Workflow defaults (env fallback — prefer /admin/workflow) ──────────────────
# BRANCH_PREFIX=auto                  # git branch name prefix (auto/<ticketId>)
# PR_TITLE_TEMPLATE=[auto-swe] {{ticketId}}
# PR_BODY_TEMPLATE=                   # leave empty to use the baked-in default
# DEFAULT_TEAM_SLUG=default           # team new sign-ups auto-join

# ── Artifact store (env fallback — prefer /admin/integrations → Storage) ───────
# If unset the worker stores blobs inline in Postgres (fine for local dev).
# For MinIO local dev: yarn docker:infra:up starts MinIO and creates the bucket.
# Console: http://localhost:9001  credentials: minioadmin/minioadmin
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=minioadmin
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin
# ARTIFACT_S3_BUCKET=auto-swe-artifacts
# ARTIFACT_S3_REGION=us-east-1
# ARTIFACT_S3_ENDPOINT=http://localhost:9000     # MinIO; omit for AWS S3
# ARTIFACT_S3_FORCE_PATH_STYLE=true              # required for MinIO
# ARTIFACT_S3_PREFIX=workflow-artifacts

# ── Slack (env fallback — prefer /admin/integrations → Slack) ──────────────────
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_SIGNING_SECRET=
# SLACK_BOT_TOKEN=

# ── Seed / admin provisioning ──────────────────────────────────────────────
# Used by `yarn db:seed` and `packages/gateway/src/scripts/provisionAuthAdmin.ts`.
# SEED_ADMIN_PASSWORD — required for the legacy bcrypt admin seed (rejected if
# unset in production). Generate with `openssl rand -base64 24`.
# SEED_ADMIN_EMAIL — defaults to admin@auto-swe.local.
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_EMAIL=admin@auto-swe.local

# ── Observability ──────────────────────────────────────────────────────────
# OTLP/HTTP endpoint for traces + logs. Defaults to disabled — set to the
# Grafana LGTM container address when running `yarn docker:up`.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ── CLI (`auto-swe` binary) ─────────────────────────────────────────────────
# Read by `packages/cli` when invoking the gateway. Set either a JWT token or
# a username/password pair — the CLI exchanges the latter for a token on first
# use.
# AUTO_SWE_API_URL=http://localhost:8080
# AUTO_SWE_TOKEN=
# AUTO_SWE_USERNAME=
# AUTO_SWE_PASSWORD=

# JWT
# Two modes are supported:
#   1. HS256 (default for local / Docker Compose): set JWT_SECRET to a strong
#      random string. Used automatically when JWT_PRIVATE_KEY_PATH is unset.
#   2. RS256 (recommended for K8s / production): set both key paths below.
# JWT_SECRET=replace-me-with-a-long-random-string
# JWT_PRIVATE_KEY_PATH=/path/to/private.pem
# JWT_PUBLIC_KEY_PATH=/path/to/public.pem

# ── Better Auth (browser sign-in: email+password / GitHub / Google / magic link) ──
# Base URL the gateway is reachable at. Used as the OAuth callback origin.
# BETTER_AUTH_URL=http://localhost:8080
# Secret for signing session cookies — must be ≥32 chars, generated with crypto
# rand. Defaults to a dev-only placeholder if unset (do not ship the default).
# BETTER_AUTH_SECRET=replace-me-with-a-long-random-string-at-least-32-chars

# Magic-link email delivery. Without any transport configured, magic links
# print to gateway stdout (dev convenience). Resolution order:
#   1. SMTP_HOST + SMTP_PORT + AUTH_FROM_EMAIL → nodemailer (Mailgun /
#      Postmark / SES via SMTP creds / self-hosted Postfix / etc.)
#   2. RESEND_API_KEY + AUTH_FROM_EMAIL → POST to Resend (HTTP API)
#   3. Console fallback (dev only)
# Choose ONE transport for production.
#
# Option A — SMTP (works with any provider that speaks SMTP)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587                          # 587 = STARTTLS, 465 = implicit TLS
# SMTP_USER=postmaster@your-domain.dev   # omit for unauthenticated relays
# SMTP_PASS=...
# AUTH_FROM_EMAIL=auth@your-domain.dev
#
# Option B — Resend (HTTP API)
# RESEND_API_KEY=re_...
# AUTH_FROM_EMAIL=auth@your-domain.dev   # must be a Resend-verified sender

# ── OAuth social sign-in (env fallback — prefer /admin/integrations → OAuth) ───
# Requires a gateway restart after changing. See docs/oauth-setup.md.
# GitHub OAuth — register at https://github.com/settings/developers
# Authorisation callback URL: {BETTER_AUTH_URL}/api/auth/callback/github
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Google OAuth — register at https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── Docker deploy ─────────────────────────────────────────────────────────────
# APP_PORT=8080                # host port for gateway (set to change the external port)
# APP_IMAGE_GATEWAY=ghcr.io/yorch/auto-swe/gateway:latest  # production image (gateway)
# APP_IMAGE_WEB=ghcr.io/yorch/auto-swe/web:latest          # production image (web)
# APP_IMAGE_WORKER=ghcr.io/yorch/auto-swe/worker:latest    # production image (worker)
# DATABASE_URL_OVERRIDE=       # optional: managed DB URL overrides compose service
# DOMAIN_API=                  # domain for the API gateway (used by Traefik)
# DOMAIN_APP=                  # domain for the web app (used by Traefik)
# TRAEFIK_NAME_GATEWAY=auto-swe-gateway  # service name label for Traefik (gateway)
# TRAEFIK_NAME_WEB=auto-swe              # service name label for Traefik (web)
# WATCHTOWER_POLL_INTERVAL=86400  # seconds between watchtower polls
# WATCHTOWER_SCOPE=auto-swe    # scope name for watchtower labeling
# DOCKER_GID=                  # host docker group ID (for dind socket access)
#
# NOTE: Most integration credentials (GitHub, Slack, S3, OAuth) are stored
# encrypted in the DB and managed via /admin/integrations. Env vars above are
# accepted as bootstrap fallbacks only. The only truly required secrets are
# CONFIG_ENCRYPTION_KEY (encrypts all DB-stored secrets) and the JWT/auth vars.
