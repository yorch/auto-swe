# ── Docker image versions (used by docker-compose.infra.yml) ───────────────
# Override to test newer/older images without editing the compose files.
# PGVECTOR_TAG=pg17                                  # pgvector/pgvector
# POSTGRES_TEMPORAL_TAG=17-alpine                    # postgres
# TEMPORAL_VERSION=1.31.0                            # temporalio/server
# TEMPORAL_ADMINTOOLS_VERSION=1.31.0                 # temporalio/admin-tools
# TEMPORAL_UI_VERSION=2.49.1                         # temporalio/ui

# ── Local Docker port bindings (host side) ─────────────────────────────────
# Override any of these to avoid conflicts with other local services.
# Defaults match what `yarn docker:infra:up` and `yarn docker:up` bind by
# default; container-side ports are not affected.
# POSTGRES_PORT=5432
# TEMPORAL_GRPC_PORT=7233
# TEMPORAL_UI_PORT=8233
# GATEWAY_PORT=8080
# WEB_PORT=3000
# MINIO_API_PORT=9000                              # S3-compatible API
# MINIO_CONSOLE_PORT=9001                          # MinIO web console

# ── Gateway / Web runtime ──────────────────────────────────────────────────
# PORT — port the gateway listens on (default 8080). Overrides GATEWAY_PORT
# when the gateway runs outside Docker.
# PORT=8080
# CORS_ORIGIN — comma-separated list of allowed browser origins. First entry
# is used as the better-auth client origin / OAuth redirect base. Defaults to
# http://localhost:3000.
# CORS_ORIGIN=http://localhost:3000
# PUBLIC_URL — public base URL of the gateway, used for the Slack OAuth
# callback (`{PUBLIC_URL}/api/v1/auth/slack/callback`). Defaults to
# http://localhost:8080.
# PUBLIC_URL=http://localhost:8080
# DEFAULT_TEAM_SLUG — slug of the team that new better-auth sign-ups are
# auto-enrolled into. Defaults to `default` (seeded by `yarn db:seed`).
# DEFAULT_TEAM_SLUG=default

# ── Web app (Next.js) ──────────────────────────────────────────────────────
# Read by `packages/web` at build time. The NEXT_PUBLIC_ prefix is required
# for Next.js to expose the value to the browser bundle.
# NEXT_PUBLIC_API_URL=http://localhost:8080
# NEXT_PUBLIC_APP_VERSION=0.1.0

# ── Database (Postgres + pgvector) ─────────────────────────────────────────
# POSTGRES_* vars are consumed by docker-compose.infra.yml when starting
# the postgres container. DATABASE_URL is read by app processes
# (gateway / worker / prisma) via Node `--env-file` and must be a literal
# DSN — Node's --env-file does not expand `${VAR}` references. Keep the
# host/credentials in DATABASE_URL in sync with the POSTGRES_* parts above.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=engineering_system
DATABASE_URL=postgresql://postgres:password@localhost:5432/engineering_system

# ── Temporal ───────────────────────────────────────────────────────────────
# TEMPORAL_NAMESPACE is the namespace created on first start by the
# temporal-setup-namespace container.
TEMPORAL_NAMESPACE=default
TEMPORAL_ADDRESS=localhost:7233

# ── LLM Providers ───────────────────────────────────────────────────────────
# Set the API key for any provider you want to use. Anthropic is the default.
ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_GENERATIVE_AI_API_KEY=...             # Required if any *_MODEL uses google/*

# Per-role model selection. Format: <provider>/<model-id>.
# Built-in providers: anthropic, openai, google.
# Any other name is treated as an OpenAI-compatible endpoint and requires
# <PROVIDER>_API_BASE (and usually <PROVIDER>_API_KEY) — covers OpenRouter,
# Ollama, vLLM, Groq, Cerebras, Inflection Pi, etc.
# Defaults are baked in; uncomment to override.
# IMPLEMENTER_MODEL=anthropic/claude-opus-4-7
# REVIEWER_MODEL=anthropic/claude-opus-4-7
# PLANNER_MODEL=anthropic/claude-sonnet-4-6
# SECURITY_REVIEW_MODEL=anthropic/claude-sonnet-4-6
# CONTEXT_VALIDATOR_MODEL=anthropic/claude-sonnet-4-6
# MEMORY_SUMMARIZER_MODEL=anthropic/claude-opus-4-7

# Note: claude-sonnet-4-20250514 (the previous default for planner /
# securityReview / validateContext) retires 2026-06-15. Migrate any pinned
# overrides to claude-sonnet-4-6 before that date.

# Example: route the planner through OpenRouter.
# OPENROUTER_API_BASE=https://openrouter.ai/api/v1
# OPENROUTER_API_KEY=sk-or-...
# PLANNER_MODEL=openrouter/anthropic/claude-opus-4-7

# Example: run the validator on a local Ollama model.
# OLLAMA_API_BASE=http://localhost:11434/v1
# CONTEXT_VALIDATOR_MODEL=ollama/llama3.1:70b

# ── Embeddings (semantic memory / pgvector) ────────────────────────────────
# Same `<provider>/<model>` syntax as the *_MODEL variables above. Anything
# other than `openai` is treated as OpenAI-compatible and requires
# <PROVIDER>_API_BASE. The model MUST produce 1536-dim vectors — that's the
# fixed width of the agent_lessons.embedding pgvector column.
# EMBEDDING_MODEL=openai/text-embedding-3-large

# ── Per-model price overrides (optional) ───────────────────────────────────
# Format: MODEL_PRICE_<PROVIDER>_<MODEL>=<input>:<output>  (USD per million tokens).
# Non-alphanumerics in the spec become underscores. Negative values are rejected.
# Use these for models not in the built-in MODEL_PRICES table, to apply
# enterprise-negotiated rates, or to account for caching/batch discounts.
# Example — local Ollama models cost nothing:
# MODEL_PRICE_OLLAMA_LLAMA3_1_70B=0:0

# GitHub (supports github.com and GitHub Enterprise Server)
GITHUB_TOKEN=ghp_...
GITHUB_WEBHOOK_SECRET=whsec_...
GITHUB_URL=https://github.com                  # Base URL for git clone (omit for github.com)
GITHUB_API_URL=https://api.github.com          # API base URL for Octokit (omit for github.com)

# Branch naming (optional — default: auto)
# BRANCH_PREFIX=auto                           # Branches created as auto/<ticketId>

# Artifact store — large step outputs (diffs, logs, scan reports) are
# kept out of the Temporal history by storing them via the artifact backend.
# If ARTIFACT_S3_BUCKET is unset, the worker falls back to Postgres-inline
# storage (WorkflowArtifact.inline_blob) which is fine for local dev. Set
# bucket + endpoint to use any S3-compatible store (S3, MinIO, R2).
#
# Local dev with MinIO: `yarn docker:infra:up` starts a MinIO container and
# auto-creates the `auto-swe-artifacts` bucket. To activate the S3 backend
# uncomment the block below (the defaults match the MinIO container) and
# restart the worker. Console: http://localhost:9001 (minioadmin/minioadmin).
# ARTIFACT_S3_BUCKET=auto-swe-artifacts
# ARTIFACT_S3_REGION=us-east-1
# ARTIFACT_S3_ENDPOINT=http://localhost:9000     # MinIO; omit for AWS S3
# ARTIFACT_S3_FORCE_PATH_STYLE=true              # required for MinIO
# ARTIFACT_S3_PREFIX=workflow-artifacts
#
# MinIO credentials — used by the local container and as the AWS_* creds the
# worker reads when ARTIFACT_S3_ENDPOINT points at MinIO. Change both for
# anything beyond local dev.
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=minioadmin
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin

# PR Templates (optional — defaults shown)
# PR_TITLE_TEMPLATE=[auto-swe] {{ticketId}}
# PR_BODY_TEMPLATE=see createOrUpdatePullRequest.ts for default

# OpenAI (used for pgvector embeddings, and for *_MODEL=openai/* selections)
OPENAI_API_KEY=sk-...

# Slack (Phase 3+)
# OAuth credentials for the "Connect Slack" flow in the dashboard.
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_SIGNING_SECRET=
# Bot token used by the worker to post run notifications via chat.postMessage
# (xoxb-…). Without it, slackNotify falls back to a no-op.
# SLACK_BOT_TOKEN=

# ── Seed / admin provisioning ──────────────────────────────────────────────
# Used by `yarn db:seed` and `packages/gateway/src/scripts/provisionAuthAdmin.ts`.
# SEED_ADMIN_PASSWORD — required for the legacy bcrypt admin seed (rejected if
# unset in production). Generate with `openssl rand -base64 24`.
# SEED_ADMIN_EMAIL — defaults to admin@auto-swe.local.
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_EMAIL=admin@auto-swe.local

# ── Observability ──────────────────────────────────────────────────────────
# OTLP/HTTP endpoint for traces + logs. Defaults to disabled — set to the
# Grafana LGTM container address when running `yarn docker:up`.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ── CLI (`auto-swe` binary) ─────────────────────────────────────────────────
# Read by `packages/cli` when invoking the gateway. Set either a JWT token or
# a username/password pair — the CLI exchanges the latter for a token on first
# use.
# AUTO_SWE_API_URL=http://localhost:8080
# AUTO_SWE_TOKEN=
# AUTO_SWE_USERNAME=
# AUTO_SWE_PASSWORD=

# JWT
# Two modes are supported:
#   1. HS256 (default for local / Docker Compose): set JWT_SECRET to a strong
#      random string. Used automatically when JWT_PRIVATE_KEY_PATH is unset.
#   2. RS256 (recommended for K8s / production): set both key paths below.
# JWT_SECRET=replace-me-with-a-long-random-string
# JWT_PRIVATE_KEY_PATH=/path/to/private.pem
# JWT_PUBLIC_KEY_PATH=/path/to/public.pem

# ── Better Auth (browser sign-in: email+password / GitHub / Google / magic link) ──
# Base URL the gateway is reachable at. Used as the OAuth callback origin.
# BETTER_AUTH_URL=http://localhost:8080
# Secret for signing session cookies — must be ≥32 chars, generated with crypto
# rand. Defaults to a dev-only placeholder if unset (do not ship the default).
# BETTER_AUTH_SECRET=replace-me-with-a-long-random-string-at-least-32-chars

# Magic-link email delivery. Without any transport configured, magic links
# print to gateway stdout (dev convenience). Resolution order:
#   1. SMTP_HOST + SMTP_PORT + AUTH_FROM_EMAIL → nodemailer (Mailgun /
#      Postmark / SES via SMTP creds / self-hosted Postfix / etc.)
#   2. RESEND_API_KEY + AUTH_FROM_EMAIL → POST to Resend (HTTP API)
#   3. Console fallback (dev only)
# Choose ONE transport for production.
#
# Option A — SMTP (works with any provider that speaks SMTP)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587                          # 587 = STARTTLS, 465 = implicit TLS
# SMTP_USER=postmaster@your-domain.dev   # omit for unauthenticated relays
# SMTP_PASS=...
# AUTH_FROM_EMAIL=auth@your-domain.dev
#
# Option B — Resend (HTTP API)
# RESEND_API_KEY=re_...
# AUTH_FROM_EMAIL=auth@your-domain.dev   # must be a Resend-verified sender

# GitHub OAuth — register an app at https://github.com/settings/developers
# Authorisation callback URL: {BETTER_AUTH_URL}/api/auth/callback/github
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Google OAuth — register a client at https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
