# ── Dependencies ────────────────────────────────────────────────
node_modules/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# ── Build output ────────────────────────────────────────────────
dist/
*.tsbuildinfo
# Prisma generated client — regenerated via `yarn db:generate`
packages/shared/src/generated/
# Next.js
.next/

# ── Env files ───────────────────────────────────────────────────
# Ignore every env file except the committed examples.
# `.env.*` does not match `.env` itself, hence both lines; the negations come
# last so they win regardless of what appears above.
.env
.env.*
!.env.example
!.env.*.example

# ── Local infra state ───────────────────────────────────────────
# Local infra volumes created by `docker:infra:up` (root-owned).
# Anchored to the repo root so it never shadows a source dir named `data`.
# Docker bind-mount data directories (Postgres, Temporal Postgres)
/data/

# ── Editor / IDE ────────────────────────────────────────────────
# Share project editor config; ignore everything else the editor writes.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json

# ── OS ─────────────────────────────────────────────────────────
.DS_Store

# ── Testing & coverage ──────────────────────────────────────────
test-results/
# vitest coverage output
coverage/

# ── Project-specific ────────────────────────────────────────────
# npm lockfile — this is a Yarn 4 project
package-lock.json
# Regenerated by `next dev` / `next build` with different content per mode — track noise not worth it
packages/web/next-env.d.ts
# AI
.claude/settings.local.json
.claude/*.lock
.claude/worktrees/
tmp/
.superpowers/
docs/superpowers/
# Generated codebase reference artifacts
output/
.worktrees/
