{
  "name": "auto-swe",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "yarn workspaces foreach -At run build",
    "typecheck": "yarn workspace @auto-swe/shared run build && yarn workspaces foreach -A run typecheck",
    "dev:gateway": "yarn workspace @auto-swe/gateway dev",
    "dev:worker": "yarn workspace @auto-swe/worker dev",
    "dev:web": "yarn workspace @auto-swe/web dev",
    "db:migrate": "yarn workspace @auto-swe/shared prisma migrate dev",
    "db:generate": "yarn workspace @auto-swe/shared prisma generate",
    "db:seed": "yarn workspace @auto-swe/shared prisma db seed",
    "db:studio": "yarn workspace @auto-swe/shared prisma studio",
    "docker": "docker compose -f docker-compose.infra.yml -f docker-compose.yml",
    "docker:up": "yarn docker up -d",
    "docker:down": "yarn docker down",
    "docker:logs": "yarn docker logs -f",
    "docker:build": "yarn docker build",
    "docker:infra": "docker compose -f docker-compose.infra.yml",
    "docker:infra:ps": "yarn docker:infra ps",
    "docker:infra:up": "yarn docker:infra up -d",
    "docker:infra:down": "yarn docker:infra down",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "format": "biome format . --write"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.14",
    "tsx": "4.21.0",
    "vitest": "4.1.5"
  },
  "packageManager": "yarn@4.14.1"
}
