{
  "name": "auto-swe",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "yarn workspaces foreach -At run build",
    "typecheck": "yarn workspace @auto-swe/shared run build && yarn workspaces foreach -A run typecheck",
    "dev": "yarn workspaces foreach -Api run dev",
    "dev:gateway": "yarn workspace @auto-swe/gateway dev",
    "dev:worker": "yarn workspace @auto-swe/worker dev",
    "dev:web": "yarn workspace @auto-swe/web dev",
    "db:migrate": "yarn workspace @auto-swe/shared prisma migrate deploy",
    "db:migrate:dev": "yarn workspace @auto-swe/shared prisma migrate dev",
    "db:generate": "yarn workspace @auto-swe/shared prisma generate",
    "db:seed": "yarn workspace @auto-swe/shared prisma db seed && yarn db:seed:auth",
    "db:seed:auth": "yarn workspace @auto-swe/gateway exec tsx src/scripts/provisionAuthAdmin.ts",
    "db:studio": "yarn workspace @auto-swe/shared prisma studio",
    "docker:infra": "docker compose -f docker-compose.infra.yml",
    "docker:infra:ps": "run docker:infra ps",
    "docker:infra:up": "run docker:infra up -d",
    "docker:infra:down": "run docker:infra down",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "format": "biome format . --write",
    "docker:app": "docker compose -f docker-compose.app.yml -f docker-compose.infra.yml",
    "docker:app:up": "run docker:app up -d",
    "docker:app:down": "run docker:app down",
    "docker:app:logs": "run docker:app logs -f",
    "docker:app:build": "run docker:app build"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "tsx": "4.22.1",
    "vitest": "4.1.6"
  },
  "packageManager": "yarn@4.14.1"
}
