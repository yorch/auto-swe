{
  "name": "auto-swe",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "workspaces": [
    "packages/*",
    "site"
  ],
  "scripts": {
    "build": "yarn workspaces foreach -At run build",
    "typecheck": "yarn workspaces foreach -At --exclude @auto-swe/web run build && yarn workspaces foreach -A run typecheck",
    "dev": "yarn workspaces foreach -Api run dev",
    "dev:gateway": "yarn workspace @auto-swe/gateway dev",
    "dev:worker": "yarn workspace @auto-swe/worker dev",
    "dev:web": "yarn workspace @auto-swe/web dev",
    "db:migrate": "yarn workspace @auto-swe/shared db:migrate",
    "db:generate": "yarn workspace @auto-swe/shared db:generate",
    "db:reset": "yarn workspace @auto-swe/shared db:reset",
    "db:push": "yarn workspace @auto-swe/shared db:push",
    "db:deploy": "yarn workspace @auto-swe/shared db:deploy",
    "postinstall": "yarn db:generate",
    "db:seed": "yarn workspace @auto-swe/shared build && yarn workspace @auto-swe/shared db:seed && yarn db:seed:auth",
    "db:seed:auth": "yarn workspace @auto-swe/gateway exec tsx src/scripts/provisionAuthAdmin.ts",
    "db:studio": "yarn workspace @auto-swe/shared db:studio",
    "docker:infra": "docker compose -f docker-compose.infra.yml",
    "docker:infra:ps": "run docker:infra ps",
    "docker:infra:up": "run docker:infra up -d",
    "docker:infra:down": "run docker:infra down",
    "docker:app": "docker compose -f docker-compose.app.yml -f docker-compose.infra.yml",
    "docker:app:up": "run docker:app up -d",
    "docker:app:down": "run docker:app down",
    "docker:app:logs": "run docker:app logs -f",
    "docker:app:build": "run docker:app build",
    "docs:check": "node scripts/check-doc-drift.mjs",
    "invariants:check": "node scripts/check-invariants.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "format": "biome format . --write",
    "keys:rotate": "yarn workspace @auto-swe/shared keys:rotate"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "resolutions": {
    "next/postcss": "8.5.26"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@vitest/coverage-v8": "4.1.11",
    "tsx": "4.23.12",
    "vitest": "4.1.11"
  },
  "packageManager": "yarn@4.18.0"
}
