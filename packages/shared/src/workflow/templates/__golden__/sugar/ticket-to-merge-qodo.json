{
  "description": "ticket-to-merge, with a Qodo review of the final commit once CI is green: a review with an open action_required finding asks a person to continue or stop, and anything else goes on to the merge wait. It does nothing while qodo.enabled is off. With it on, a repository without the Qodo pull request bot waits the configured Qodo review wait on every run.",
  "entry": "gatherTicket",
  "name": "ticket-to-merge-qodo",
  "nodes": {
    "checkActionable": {
      "expr": "nodes.validate.output.actionable == false",
      "onFalse": "setSuccessCriteria",
      "onTrue": "terminateNotActionable",
      "type": "cond"
    },
    "checkApproval": {
      "expr": "nodes.review.output.approved == true",
      "onFalse": "storeRejection",
      "onTrue": "forgetRejection",
      "type": "cond"
    },
    "checkCI": {
      "expr": "context.ciResultPayload.passed == true",
      "onFalse": "fetchLogs",
      "onTrue": "qodoReview",
      "type": "cond"
    },
    "checkStalled": {
      "expr": "nodes.review.output.stalled == true",
      "onFalse": "reviewFix",
      "onTrue": "lessonReviewFailed",
      "type": "cond"
    },
    "ciFix": {
      "inputs": {
        "failureContext": {
          "from": "context.lastCILogs"
        },
        "previousCodeResult": {
          "from": "context.currentCodeResult"
        }
      },
      "next": "clearCiResult",
      "step": "executeCIFixImplementation",
      "storeAs": "context.currentCodeResult",
      "type": "step"
    },
    "clearCiResult": {
      "next": "review",
      "type": "set",
      "values": {
        "context.ciResultPayload": {
          "literal": null
        }
      }
    },
    "commitLesson": {
      "inputs": {
        "outcome": {
          "literal": "MERGED"
        }
      },
      "next": "done",
      "onError": "continue",
      "step": "commitToMemory",
      "type": "step"
    },
    "done": {
      "result": {
        "prNumber": {
          "from": "context.prNumber"
        },
        "prUrl": {
          "from": "context.prUrl"
        }
      },
      "status": "SUCCESS",
      "type": "terminate"
    },
    "fetchLogs": {
      "inputs": {
        "logsUrl": {
          "from": "context.ciResultPayload.logsUrl"
        }
      },
      "maxVisits": 2,
      "next": "ciFix",
      "onExhausted": "lessonCIFailed",
      "step": "fetchCILogs",
      "storeAs": "context.lastCILogs",
      "type": "step"
    },
    "forgetRejection": {
      "next": "openPR",
      "type": "set",
      "values": {
        "context.lastReviewFingerprint": {
          "literal": ""
        }
      }
    },
    "gatherTicket": {
      "next": "setTicket",
      "onError": "continue",
      "status": "VALIDATING_CONTEXT",
      "step": "gatherTicketContext",
      "type": "step"
    },
    "implement": {
      "inputs": {
        "successCriteria": {
          "default": [],
          "from": "context.successCriteria"
        },
        "ticket": {
          "from": "context.ticket"
        }
      },
      "next": "uiVerify",
      "status": "IMPLEMENTING",
      "step": "executeImplementation",
      "storeAs": "context.currentCodeResult",
      "type": "step"
    },
    "lessonCIFailed": {
      "inputs": {
        "outcome": {
          "literal": "CI_FAILED"
        }
      },
      "next": "terminateCIFailed",
      "onError": "continue",
      "step": "commitToMemory",
      "type": "step"
    },
    "lessonMergeTimedOut": {
      "inputs": {
        "outcome": {
          "literal": "MERGE_TIMED_OUT"
        }
      },
      "next": "terminateMergeTimedOut",
      "onError": "continue",
      "step": "commitToMemory",
      "type": "step"
    },
    "lessonReviewFailed": {
      "inputs": {
        "outcome": {
          "literal": "REVIEW_FAILED"
        }
      },
      "next": "terminateReviewFailed",
      "onError": "continue",
      "step": "commitToMemory",
      "type": "step"
    },
    "loadCiWaitConfig": {
      "next": "routeCiWait",
      "step": "resolveCiWaitConfig",
      "type": "step"
    },
    "openPR": {
      "inputs": {
        "codeResult": {
          "from": "context.currentCodeResult"
        }
      },
      "next": "savePrInfo",
      "status": "AWAITING_CI",
      "step": "createOrUpdatePullRequest",
      "type": "step"
    },
    "pollForCI": {
      "inputs": {
        "deadlineSec": {
          "from": "nodes.loadCiWaitConfig.output.deadlineSec"
        },
        "graceSec": {
          "from": "nodes.loadCiWaitConfig.output.graceSec"
        },
        "intervalSec": {
          "from": "nodes.loadCiWaitConfig.output.intervalSec"
        },
        "ref": {
          "from": "context.currentCodeResult.branch"
        }
      },
      "next": "storePollResult",
      "onError": "fail",
      "step": "waitForCiByPolling",
      "type": "step"
    },
    "qodoDecision": {
      "description": "Qodo's review of the final commit has an open action_required finding. Continue to the merge wait, or stop the run.",
      "onTimeout": "terminateQodoTimedOut",
      "options": [
        {
          "label": "Continue to the merge wait",
          "next": "waitForHumanMerge",
          "value": "continue"
        },
        {
          "label": "Stop the run",
          "next": "terminateQodoStopped",
          "value": "stop"
        }
      ],
      "storeAs": "context.qodoChoice",
      "timeout": "24h",
      "title": "Qodo found a blocking issue. Continue anyway?",
      "type": "humanDecision"
    },
    "qodoGate": {
      "expr": "nodes.qodoReview.output.blocking == true",
      "onFalse": "waitForHumanMerge",
      "onTrue": "qodoDecision",
      "type": "cond"
    },
    "qodoReview": {
      "inputs": {
        "headSha": {
          "from": "context.currentCodeResult.headSha"
        },
        "prUrl": {
          "from": "context.prUrl"
        }
      },
      "next": "qodoGate",
      "onFail": "warn",
      "step": "awaitQodoReview",
      "type": "step"
    },
    "review": {
      "inputs": {
        "codeResult": {
          "from": "context.currentCodeResult"
        },
        "previousFingerprint": {
          "default": "",
          "from": "context.lastReviewFingerprint"
        },
        "successCriteria": {
          "from": "context.successCriteria"
        }
      },
      "next": "checkApproval",
      "status": "IN_REVIEW",
      "step": "runReviewNetwork",
      "type": "step"
    },
    "reviewFix": {
      "inputs": {
        "previousCodeResult": {
          "from": "context.currentCodeResult"
        },
        "rejectionSummary": {
          "from": "context.lastRejectionSummary"
        }
      },
      "maxVisits": 2,
      "next": "clearCiResult",
      "onExhausted": "lessonReviewFailed",
      "step": "executeReviewFixImplementation",
      "storeAs": "context.currentCodeResult",
      "type": "step"
    },
    "routeCiWait": {
      "expr": "nodes.loadCiWaitConfig.output.mode == 'poll'",
      "onFalse": "waitForCI",
      "onTrue": "pollForCI",
      "type": "cond"
    },
    "savePrInfo": {
      "next": "loadCiWaitConfig",
      "type": "set",
      "values": {
        "context.prNumber": {
          "from": "nodes.openPR.output.prNumber"
        },
        "context.prUrl": {
          "from": "nodes.openPR.output.prUrl"
        }
      }
    },
    "setSuccessCriteria": {
      "next": "implement",
      "type": "set",
      "values": {
        "context.successCriteria": {
          "default": [],
          "from": "nodes.validate.output.successCriteria"
        }
      }
    },
    "setTicket": {
      "next": "validate",
      "type": "set",
      "values": {
        "context.ticket": {
          "default": "",
          "from": "nodes.gatherTicket.output.text"
        }
      }
    },
    "storePollResult": {
      "next": "checkCI",
      "type": "set",
      "values": {
        "context.ciResultPayload.logsUrl": {
          "from": "nodes.pollForCI.output.logsUrl"
        },
        "context.ciResultPayload.passed": {
          "from": "nodes.pollForCI.output.ciPassed"
        }
      }
    },
    "storeRejection": {
      "next": "checkStalled",
      "type": "set",
      "values": {
        "context.lastRejectionSummary": {
          "default": "",
          "from": "nodes.review.output.rejectionSummary"
        },
        "context.lastReviewFingerprint": {
          "default": "",
          "from": "nodes.review.output.rejectionFingerprint"
        }
      }
    },
    "terminateCIFailed": {
      "result": {
        "prNumber": {
          "from": "context.prNumber"
        },
        "prUrl": {
          "from": "context.prUrl"
        }
      },
      "status": "FAILED",
      "type": "terminate"
    },
    "terminateCITimedOut": {
      "result": {
        "prNumber": {
          "from": "context.prNumber"
        },
        "prUrl": {
          "from": "context.prUrl"
        }
      },
      "status": "TIMED_OUT",
      "type": "terminate"
    },
    "terminateMergeTimedOut": {
      "result": {},
      "status": "TIMED_OUT",
      "type": "terminate"
    },
    "terminateNotActionable": {
      "result": {
        "ambiguities": {
          "default": [],
          "from": "nodes.validate.output.ambiguities"
        },
        "message": {
          "literal": "The request is not actionable: validation found nothing it could verify, only the ambiguities listed here. Paste the ticket text or add acceptance criteria to the request, then re-run."
        },
        "ticketUnavailableReason": {
          "default": "",
          "from": "nodes.gatherTicket.output.unavailableReason"
        }
      },
      "status": "FAILED",
      "type": "terminate"
    },
    "terminateQodoStopped": {
      "result": {
        "prNumber": {
          "from": "context.prNumber"
        },
        "prUrl": {
          "from": "context.prUrl"
        }
      },
      "status": "FAILED",
      "type": "terminate"
    },
    "terminateQodoTimedOut": {
      "result": {
        "prNumber": {
          "from": "context.prNumber"
        },
        "prUrl": {
          "from": "context.prUrl"
        }
      },
      "status": "TIMED_OUT",
      "type": "terminate"
    },
    "terminateReviewFailed": {
      "status": "FAILED",
      "type": "terminate"
    },
    "uiVerify": {
      "next": "clearCiResult",
      "onFail": "warn",
      "step": "uiVerify",
      "type": "step"
    },
    "validate": {
      "inputs": {
        "ticket": {
          "from": "context.ticket"
        }
      },
      "next": "checkActionable",
      "onError": "continue",
      "step": "validateContext",
      "type": "step"
    },
    "waitForCI": {
      "name": "ciPipelineSignal",
      "onReceive": "checkCI",
      "onTimeout": "terminateCITimedOut",
      "storeAs": "context.ciResultPayload",
      "timeout": "4h",
      "type": "signal"
    },
    "waitForHumanMerge": {
      "name": "humanMergeSignal",
      "onReceive": "commitLesson",
      "onTimeout": "lessonMergeTimedOut",
      "status": "AWAITING_HUMAN_MERGE",
      "timeout": "7d",
      "type": "signal"
    }
  },
  "schemaVersion": 1
}
