{
  "description": "Review a finished run change with the reviewer network and, for pull requests, read Qodo findings on the same head before publishing the combined result.",
  "entry": "load",
  "name": "code-review-qodo",
  "nodes": {
    "done": {
      "result": {
        "review": {
          "from": "nodes.publish.output"
        }
      },
      "status": "SUCCESS",
      "type": "terminate"
    },
    "doneQodo": {
      "result": {
        "review": {
          "from": "nodes.publishQodo.output"
        }
      },
      "status": "SUCCESS",
      "type": "terminate"
    },
    "isPr": {
      "expr": "request.payload.reviewOf.mode == \"pr\"",
      "onFalse": "publish",
      "onTrue": "qodo",
      "type": "cond"
    },
    "load": {
      "next": "review",
      "step": "loadChangeForReview",
      "type": "step"
    },
    "publish": {
      "inputs": {
        "review": {
          "from": "nodes.review.output"
        }
      },
      "next": "done",
      "step": "publishReviewResult",
      "type": "step"
    },
    "publishQodo": {
      "inputs": {
        "qodo": {
          "from": "nodes.qodo.output"
        },
        "review": {
          "from": "nodes.review.output"
        }
      },
      "next": "doneQodo",
      "step": "publishReviewResult",
      "type": "step"
    },
    "qodo": {
      "inputs": {
        "headSha": {
          "from": "nodes.load.output.headSha"
        },
        "prUrl": {
          "from": "nodes.load.output.prUrl"
        }
      },
      "next": "publishQodo",
      "step": "awaitQodoReview",
      "type": "step"
    },
    "review": {
      "inputs": {
        "codeResult": {
          "from": "nodes.load.output"
        },
        "systemPrompt": {
          "default": "",
          "from": "request.payload.systemPrompt"
        }
      },
      "next": "isPr",
      "step": "runReviewNetwork",
      "type": "step"
    }
  },
  "schemaVersion": 1
}
