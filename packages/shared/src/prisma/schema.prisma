/// Audit trail for changes to ModelRoleConfig and ProviderCredential.
/// Secret material is redacted in beforeJson/afterJson (only `lastFour` is
/// recorded). Written from the gateway routes that mutate these rows.
/// A definition-driven configuration override. Unlike the singleton config
/// tables (GitHubConfig, WorkflowDefaults, …) — whose shape is genuinely
/// relational and stays where it is — these rows hold one JSON value per
/// (key, scope), so a new operator knob costs a definition in
/// `@auto-swe/shared/config/registry` rather than a migration.
///
/// The registry, not this table, is the source of truth for a key's type,
/// default, which scopes it may be overridden at, and who may change it. A row
/// here only ever means "at this scope, use this value instead of the default";
/// a key with no row anywhere resolves to its definition default. Values are
/// validated against the definition's Zod schema before they are written, so a
/// row can only hold a shape the definition accepts.
model ConfigSetting {
  id                 String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Registry key, e.g. `channel.reactiveCooldownMinutes`.
  key                String
  scope              ConfigScope
  teamId             String?     @map("team_id") @db.Uuid
  orgId              String?     @map("org_id") @db.Uuid
  channelId          String?     @map("channel_id") @db.Uuid
  workflowTemplateId String?     @map("workflow_template_id") @db.Uuid
  value              Json
  updatedById        String?     @map("updated_by_id") @db.Uuid
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  team             Team?             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  organization     Organization?     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  channel          SlackChannel?     @relation(fields: [channelId], references: [id], onDelete: Cascade)
  workflowTemplate WorkflowTemplate? @relation(fields: [workflowTemplateId], references: [id], onDelete: Cascade)

  @@index([key])
  @@index([scope, teamId])
  @@index([scope, orgId])
  @@index([scope, channelId])
  @@index([scope, workflowTemplateId])
  @@index([teamId])
  @@index([orgId])
  @@index([channelId])
  @@index([workflowTemplateId])
  @@map("config_settings")
}

/// A grant of write access to configuration: who may change which settings,
/// and where. Deliberately data rather than a static map in code, so widening
/// or narrowing who configures what is an admin action, not a deploy.
///
/// A grant matches when its `keyPattern` covers the setting key (exact,
/// `group.*`, or `*`), its grantee matches the actor (either a specific
/// `userId` or every user holding `role`), and its scope covers the scope being
/// written. Platform ADMINs bypass grants entirely — they can already write
/// every singleton config table, so requiring a self-grant would be ceremony.
/// A definition's `requiredRole` is the floor: no grant can let an actor below
/// it write that key.
model ConfigPermission {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Exact setting key, a `group.*` prefix wildcard, or `*` for everything.
  keyPattern  String      @map("key_pattern")
  /// Grantee. Exactly one of `userId` / `role` is set (CHECK-enforced).
  userId      String?     @map("user_id") @db.Uuid
  role        Role?
  /// Widest scope this grant authorises writes at. A TEAM grant authorises
  /// TEAM and CHANNEL/WORKFLOW_TEMPLATE writes below that team; an
  /// ORGANIZATION grant authorises anything inside the org.
  scope       ConfigScope
  teamId      String?     @map("team_id") @db.Uuid
  orgId       String?     @map("org_id") @db.Uuid
  createdById String?     @map("created_by_id") @db.Uuid
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  team         Team?         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([role])
  @@index([teamId])
  @@index([orgId])
  @@map("config_permissions")
}

model ConfigAuditLog {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityType String            @map("entity_type")
  entityId   String            @map("entity_id") @db.Uuid
  action     ConfigAuditAction
  actorId    String?           @map("actor_id") @db.Uuid
  beforeJson Json?             @map("before_json")
  afterJson  Json?             @map("after_json")
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("config_audit_log")
}

/// A reusable prompt-fragment skill injected into an agent's system prompt.
/// Skills are assigned to Agents via `AgentSkillRef` (see `agentResolver.ts`).
/// Tool access is a separate concern (`Agent.toolKeys`).
///
/// Tenant-scoped by `scope` + `teamId`/`orgId`, like `ProviderCredential` and
/// `Agent`: built-ins are GLOBAL, a custom skill belongs to one team or org. The
/// `skills_scope_keys_check` constraint (hand-written migration) ties the
/// scope to which owner column is set.
model Skill {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  description String?
  promptText  String   @map("prompt_text")
  // Provenance: null = core platform; 'swe-starter' = SWE seed content (removable).
  origin      String?
  isBuiltIn   Boolean  @default(false) @map("is_built_in")
  isVerified  Boolean  @default(false) @map("is_verified")
  isActive    Boolean  @default(true) @map("is_active")
  /// Ownership, mirroring `ProviderCredential`/`Agent`. Built-ins seed as GLOBAL
  /// and stay visible everywhere; a team- or org-authored skill is visible only
  /// within its tenant. Without this a custom skill's `promptText` — which may
  /// encode internal process or domain knowledge — was readable platform-wide.
  scope        ConfigScope   @default(GLOBAL)
  teamId       String?       @map("team_id") @db.Uuid
  team         Team?         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  orgId        String?       @map("org_id") @db.Uuid
  organization Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  /// The revision number whose content `promptText`/`description` mirror. The
  /// columns above stay the live copy (every reader that wants "now" keeps
  /// working); `SkillRevision` is the immutable history a run pins against.
  currentRevision Int @default(1) @map("current_revision")

  /// The tracked external source this skill was imported from, if any. Deleting
  /// the source detaches the skill (it stays, as an ordinary custom skill, with
  /// the provenance its revisions carry).
  sourceId   String?      @map("source_id") @db.Uuid
  source     SkillSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  /// The skill's folder inside the source repository (relative to the repo root).
  sourcePath String?      @map("source_path")

  agentSkillRefs AgentSkillRef[]
  revisions      SkillRevision[]

  @@index([scope, teamId])
  @@index([scope, orgId])
  @@index([teamId])
  @@index([orgId])
  @@index([sourceId])
  @@map("skills")
}

/// One immutable version of a skill's content. Written by every path that
/// changes `Skill.promptText` or `description` (create, edit, built-in sync,
/// bundle install) and never updated afterwards: a run records
/// `{ skillId: revision }` at start (`WorkflowRun.skillRevisions`) and reads the
/// text from here, so a later edit cannot alter an in-flight run.
model SkillRevision {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  skillId       String   @map("skill_id") @db.Uuid
  skill         Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  revision      Int
  promptText    String   @map("prompt_text")
  description   String?
  /// sha256 over promptText + description; equal hashes mean no new revision.
  contentHash   String   @map("content_hash")
  /// Provenance for content imported from a git source; null for authored text.
  sourceSha     String?  @map("source_sha")
  sourcePath    String?  @map("source_path")
  /// Companion text files imported with the skill (`{ path, content }[]`).
  referenceFiles Json?   @map("reference_files")
  /// Advisory `scanSkillContent` warnings for this exact text.
  scanWarnings  Json     @default("[]") @map("scan_warnings")
  createdById   String?  @map("created_by_id") @db.Uuid
  createdBy     User?    @relation("SkillRevisionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([skillId, revision])
  @@index([createdById])
  @@map("skill_revisions")
}

enum SkillSourceStatus {
  OK
  UPDATE_AVAILABLE
  ERROR
  DISABLED
}

/// What an import does with the non-Markdown files beside a skill's SKILL.md.
/// Nothing is ever executed or stored as runnable.
enum SkillSourceScriptMode {
  /// SKILL.md becomes the prompt, .md/.txt siblings are kept as reference text,
  /// everything else is skipped and listed.
  TEXT_ONLY
  /// A skill folder holding any other file is refused.
  REJECT
}

/// An external GitHub / GitHub Enterprise repository skills are imported from,
/// pinned to one commit. Uniqueness per (host, owner, repo, path) within a
/// scope is a set of partial unique indexes (see `custom_constraints_and_indexes`),
/// which Prisma cannot express.
model SkillSource {
  id            String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Lowercased `host[:port]`, e.g. `github.com`.
  host          String
  /// Lowercased: GitHub compares owner and repository names case-insensitively.
  owner         String
  repo          String
  /// Subdirectory the skills live under; empty for the repository root.
  path          String                @default("")
  /// The branch or tag as the admin gave it.
  ref           String
  /// The commit the imported text came from.
  pinnedSha     String                @map("pinned_sha")
  /// Newest commit the ref resolved to at the last check; null until one ran.
  latestSha     String?               @map("latest_sha")
  lastCheckedAt DateTime?             @map("last_checked_at") @db.Timestamptz
  /// A fixed error string, never provider or fetch text.
  lastError     String?               @map("last_error")
  status        SkillSourceStatus     @default(OK)
  scriptMode    SkillSourceScriptMode @default(TEXT_ONLY) @map("script_mode")
  scope         ConfigScope           @default(GLOBAL)
  teamId        String?               @map("team_id") @db.Uuid
  team          Team?                 @relation(fields: [teamId], references: [id], onDelete: Cascade)
  orgId         String?               @map("org_id") @db.Uuid
  organization  Organization?         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdById   String?               @map("created_by_id") @db.Uuid
  createdBy     User?                 @relation("SkillSourceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  skills Skill[]

  @@index([teamId])
  @@index([orgId])
  @@index([createdById])
  @@map("skill_sources")
}

enum ScannerPatternType {
  INJECTION
  EXFILTRATION
  SHELL_COMMAND
  CODE_SECURITY
  SENSITIVE_FILE
  PII
}

model ScannerPattern {
  id        String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  label     String             @unique
  pattern   String
  flags     String             @default("")
  type      ScannerPatternType
  // Provenance: null = core platform default; 'swe-starter' = SWE seed content.
  origin    String?
  isActive  Boolean            @default(true) @map("is_active")
  isBuiltIn Boolean            @default(false) @map("is_built_in")
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("scanner_patterns")
}

/// First-class, versioned Agent entity (P1). Consolidates an agent's identity +
/// governance and OPTIONALLY overrides model / prompt / skills / tools. When an
/// override field is null (no skillRefs / null toolKeys / null modelSpec / null
/// systemPrompt), `resolveAgent` falls through to the legacy per-scope config
/// tables (ModelRoleConfig / AgentSkillAssignment / AgentToolConfig) for `key`,
/// preserving P0 behavior exactly. The override cascade
/// WORKFLOW_TEMPLATE → TEAM → ORGANIZATION → GLOBAL mirrors the other config
/// tables (partial unique indexes live in raw SQL — Prisma can't express
/// `WHERE scope = …`). `version` is
/// bumped on base edits; the active row is the highest `version` with
/// `isActive` at a scope, and runs snapshot the resolved version (P1 WS3).
/// A CHECK constraint enforcing the scope/discriminator-column invariant
/// (`agents_scope_keys_check`, mirroring `provider_credentials_scope_keys_check`)
/// lives in raw SQL in
/// migrations/00000000000001_custom_constraints_and_indexes/migration.sql.
model Agent {
  id                 String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key                String
  scope              ConfigScope
  teamId             String?     @map("team_id") @db.Uuid
  /// Owning Organization for ORGANIZATION-scoped rows (null otherwise) (P5).
  orgId              String?     @map("org_id") @db.Uuid
  /// SlackChannel for CHANNEL-scoped rows (null otherwise) (channel assistant).
  channelId          String?     @map("channel_id") @db.Uuid
  workflowTemplateId String?     @map("workflow_template_id") @db.Uuid
  version            Int         @default(1)
  name               String
  description        String?
  // Optional overrides — null means "inherit from the legacy config cascade".
  modelSpec          String?     @map("model_spec")
  systemPrompt       String?     @map("system_prompt")
  // When set and `modelSpec` is null, resolve the model from this parent agent
  // key instead of this key's own ModelRoleConfig. Lets sub-reviewer personas
  // (e.g. securityReviewer → reviewer, decomposer → planner) inherit a model
  // without their own ModelRoleConfig row. Replaces the implicit SkillOnlyRole
  // inheritance (P1/WS2).
  inheritsModelFrom  String?     @map("inherits_model_from")
  credentialId       String?     @map("credential_id") @db.Uuid
  // P2/WS3: when set AND `toolKeys` includes 'mcp', the run binds the tools
  // from this `mcp`-type Connection (config.url) onto the agent. SetNull so
  // deleting the connection degrades the agent to its non-MCP tools.
  mcpConnectionId    String?     @map("mcp_connection_id") @db.Uuid
  // Nullable JSON array of tool keys. null = no tool override (all workspace
  // tools); [] = explicitly no tools; [...] = exactly these (may include 'mcp').
  toolKeys           Json?       @map("tool_keys")
  // Provenance: null = core platform; 'swe-starter' = SWE seed content.
  origin             String?
  isBuiltIn          Boolean     @default(false) @map("is_built_in")
  isVerified         Boolean     @default(false) @map("is_verified")
  isActive           Boolean     @default(true) @map("is_active")
  createdById        String?     @map("created_by_id") @db.Uuid
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  team             Team?               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  organization     Organization?       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  channel          SlackChannel?       @relation(fields: [channelId], references: [id], onDelete: Cascade)
  workflowTemplate WorkflowTemplate?   @relation(fields: [workflowTemplateId], references: [id], onDelete: Cascade)
  credential       ProviderCredential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)
  mcpConnection    Connection?         @relation("AgentMcpConnection", fields: [mcpConnectionId], references: [id], onDelete: SetNull)
  skillRefs        AgentSkillRef[]

  @@index([scope, teamId])
  @@index([scope, orgId])
  @@index([scope, channelId])
  @@index([scope, workflowTemplateId])
  @@index([teamId])
  @@index([orgId])
  @@index([channelId])
  @@index([workflowTemplateId])
  @@map("agents")
}

/// Skill attached to an Agent (P1) with ordering. When an Agent has any
/// skillRefs, `resolveAgent` uses them in place of the legacy
/// AgentSkillAssignment cascade for that key.
model AgentSkillRef {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agentId   String   @map("agent_id") @db.Uuid
  skillId   String   @map("skill_id") @db.Uuid
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([agentId, skillId])
  @@map("agent_skill_refs")
}

/// Phase-6 audit log: one row per shell node authored in a saved template
/// version. Lets a team admin reconstruct who introduced what command in which
/// version, and supports the editor's "danger zone" diff preview.
model WorkflowShellAudit {
  id                      String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  templateVersionId       String                  @map("template_version_id") @db.Uuid
  templateVersion         WorkflowTemplateVersion @relation(fields: [templateVersionId], references: [id], onDelete: Cascade)
  teamId                  String?                 @map("team_id") @db.Uuid
  team                    Team?                   @relation(fields: [teamId], references: [id], onDelete: SetNull)
  nodeId                  String                  @map("node_id")
  image                   String
  command                 String
  network                 String                  @default("none")
  egressAllowlistSnapshot String[]                @default([]) @map("egress_allowlist_snapshot")
  authorUserId            String?                 @map("author_user_id") @db.Uuid
  createdAt               DateTime                @default(now()) @map("created_at") @db.Timestamptz

  @@index([templateVersionId])
  @@index([teamId])
  @@map("workflow_shell_audit")
}

/// Registry of installed distribution bundles (P4/WS3). One row per bundle name
/// (re-install upserts: version + hash + trust update). `trustState` is VERIFIED
/// when the bundle's detached signature matched a deployment-trusted key at
/// install time, else UNVERIFIED (community / unsigned — still installable).
model InstalledBundle {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String   @unique
  version       String
  source        String?
  contentHash   String   @map("content_hash")
  trustState    String   @default("UNVERIFIED") @map("trust_state")
  signedBy      String?  @map("signed_by")
  installedById String?  @map("installed_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("installed_bundles")
}

// ─── OAuth 2.1 authorization server (MCP) ─────────────────────────────────────
// The eight models below are owned by better-auth: `@better-auth/oauth-provider`
// (oauth*) and its `jwt` plugin (`Jwks`). Better-auth addresses a model by its
// logical name (`prisma.oauthClient`) and a field by its logical camelCase name,
// so the model and field names here are fixed by the plugin; only the table and
// column names are ours (`@@map` / `@map`).
//
// Optional array columns carry no default on purpose. The plugin treats `null`
// and `[]` differently (an `OauthResource.allowedScopes` of null is
// "unrestricted", `[]` is "nothing allowed"), so a column default of `[]` would
// turn an omitted value into deny-all. Only the arrays the plugin requires are
// NOT NULL, and that is set in `00000000000001_custom_constraints_and_indexes`.

/// A registered OAuth client (Dynamic Client Registration in v1). `clientId` is
/// the public identifier other tables reference; `id` is the row key.
model OauthClient {
  id                               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId                         String    @unique @map("client_id")
  clientSecret                     String?   @map("client_secret")
  clientDiscoveryId                String?   @map("client_discovery_id")
  disabled                         Boolean?  @default(false)
  skipConsent                      Boolean?  @map("skip_consent")
  enableEndSession                 Boolean?  @map("enable_end_session")
  subjectType                      String?   @map("subject_type")
  scopes                           String[]
  clientCredentialsScopes          String[]  @default([]) @map("client_credentials_scopes")
  userId                           String?   @map("user_id") @db.Uuid
  createdAt                        DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                        DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  name                             String?
  uri                              String?
  icon                             String?
  contacts                         String[]
  tos                              String?
  policy                           String?
  softwareId                       String?   @map("software_id")
  softwareVersion                  String?   @map("software_version")
  softwareStatement                String?   @map("software_statement")
  redirectUris                     String[]  @map("redirect_uris")
  postLogoutRedirectUris           String[]  @map("post_logout_redirect_uris")
  backchannelLogoutUri             String?   @map("backchannel_logout_uri")
  backchannelLogoutSessionRequired Boolean?  @map("backchannel_logout_session_required")
  tokenEndpointAuthMethod          String?   @map("token_endpoint_auth_method")
  applicationType                  String?   @map("application_type")
  jwks                             String?
  jwksUri                          String?   @map("jwks_uri")
  grantTypes                       String[]  @map("grant_types")
  responseTypes                    String[]  @map("response_types")
  requirePKCE                      Boolean?  @map("require_pkce")
  dpopBoundAccessTokens            Boolean?  @default(false) @map("dpop_bound_access_tokens")
  referenceId                      String?   @map("reference_id")
  metadata                         Json?

  user          User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  resources     OauthClientResource[]
  accessTokens  OauthAccessToken[]
  refreshTokens OauthRefreshToken[]
  consents      OauthConsent[]

  @@index([userId])
  @@map("oauth_clients")
}

/// A protected resource the authorization server issues tokens for (RFC 8707).
/// Seeded at gateway boot from `MCP_RESOURCE`.
model OauthResource {
  id                            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier                    String    @unique
  name                          String
  accessTokenTtl                Int?      @map("access_token_ttl")
  refreshTokenTtl               Int?      @map("refresh_token_ttl")
  signingAlgorithm              String?   @map("signing_algorithm")
  signingKeyId                  String?   @map("signing_key_id")
  allowedScopes                 String[]  @map("allowed_scopes")
  customClaims                  Json?     @map("custom_claims")
  dpopBoundAccessTokensRequired Boolean?  @default(false) @map("dpop_bound_access_tokens_required")
  disabled                      Boolean?  @default(false)
  createdAt                     DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                     DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  policyVersion                 Int?      @default(1) @map("policy_version")
  metadata                      Json?

  clients OauthClientResource[]

  @@map("oauth_resources")
}

/// Which clients may request which resources (`enforcePerClientResources`).
model OauthClientResource {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId   String    @map("client_id")
  resourceId String    @map("resource_id")
  metadata   Json?
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamptz

  client   OauthClient   @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  resource OauthResource @relation(fields: [resourceId], references: [identifier], onDelete: Cascade)

  @@unique([clientId, resourceId])
  @@index([clientId])
  @@index([resourceId])
  @@map("oauth_client_resources")
}

/// A stored (hashed) refresh token, linked to the browser session that granted it.
model OauthRefreshToken {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token                   String    @unique
  clientId                String    @map("client_id")
  sessionId               String?   @map("session_id") @db.Uuid
  userId                  String    @map("user_id") @db.Uuid
  referenceId             String?   @map("reference_id")
  authorizationCodeId     String?   @map("authorization_code_id")
  resources               String[]
  requestedUserInfoClaims String[]  @map("requested_user_info_claims")
  expiresAt               DateTime  @map("expires_at") @db.Timestamptz
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz
  revoked                 DateTime? @db.Timestamptz
  rotatedAt               DateTime? @map("rotated_at") @db.Timestamptz
  rotationReplayResponse  String?   @map("rotation_replay_response")
  rotationReplayExpiresAt DateTime? @map("rotation_replay_expires_at") @db.Timestamptz
  authTime                DateTime? @map("auth_time") @db.Timestamptz
  confirmation            Json?
  scopes                  String[]

  client  OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  session Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  access  OauthAccessToken[]

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@map("oauth_refresh_tokens")
}

/// A stored access token. Only issued for opaque tokens (no resource audience);
/// JWT access tokens for `MCP_RESOURCE` are not stored.
model OauthAccessToken {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token                   String?   @unique
  clientId                String    @map("client_id")
  sessionId               String?   @map("session_id") @db.Uuid
  userId                  String?   @map("user_id") @db.Uuid
  referenceId             String?   @map("reference_id")
  authorizationCodeId     String?   @map("authorization_code_id")
  resources               String[]
  requestedUserInfoClaims String[]  @map("requested_user_info_claims")
  refreshId               String?   @map("refresh_id") @db.Uuid
  expiresAt               DateTime  @map("expires_at") @db.Timestamptz
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz
  revoked                 DateTime? @db.Timestamptz
  confirmation            Json?
  scopes                  String[]

  client  OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  session Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  user    User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  refresh OauthRefreshToken? @relation(fields: [refreshId], references: [id])

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@index([refreshId])
  @@map("oauth_access_tokens")
}

/// What a user has consented to for a client. Its `updatedAt` is the grant's
/// generation: a re-consent moves it.
model OauthConsent {
  id                      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId                String   @map("client_id")
  userId                  String?  @map("user_id") @db.Uuid
  referenceId             String?  @map("reference_id")
  resources               String[]
  requestedUserInfoClaims String[] @map("requested_user_info_claims")
  scopes                  String[]
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  client OauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  user   User?       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([userId])
  @@map("oauth_consents")
}

/// Single-use `jti` ledger for `private_key_jwt` client assertions. Unused while
/// every client is public, but the plugin requires the table. The primary key is
/// a base64url digest (not a UUID), so it is plain text.
model OauthClientAssertion {
  id        String   @id
  expiresAt DateTime @map("expires_at") @db.Timestamptz

  @@map("oauth_client_assertions")
}

/// Signing keys for the `jwt` plugin (EdDSA, rotated; see `betterAuth.ts`).
model Jwks {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  publicKey  String    @map("public_key")
  privateKey String    @map("private_key")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz
  alg        String?
  crv        String?

  @@map("jwks")
}
