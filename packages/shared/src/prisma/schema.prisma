  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz

  @@index([scope, slug])
  @@map("eval_rubrics")
}

/// One tool call, LLM response, or activity event captured during an agent activity execution.
/// `nodeId` is the Temporal activity type (e.g. "executeImplementation"); correlate to a
/// spec node by finding the node where `specSnapshot.nodes[id].step === nodeId`.
/// `attempt` mirrors the Temporal activity attempt number so retry attempts can be separated.
/// Persisted best-effort — failures are swallowed so tracing never breaks runs.
model AgentTrace {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Null for workflows that keep no WorkflowRun row (workflow authoring, scheduled
  /// evals, lesson consolidation, repo-access sync, epic planning). Their traces
  /// are still recorded so their LLM spend is not lost; `workflowId` identifies them.
  runId         String?       @map("run_id") @db.Uuid
  run           WorkflowRun?  @relation(fields: [runId], references: [id], onDelete: Cascade)
  /// Temporal workflow ID that scheduled the activity. Written on every new row;
  /// null only on rows that predate the column, which all have a `run` to read
  /// it from instead.
  workflowId    String?       @map("workflow_id")
  /// Temporal's run id for the execution that wrote the row. A workflow id can be
  /// started again once its execution closes (`repo-dep-infer-<repo>`), so this
  /// is what scopes a runless workflow's spend to one execution. Null on rows
  /// that predate the column.
  temporalRunId String?       @map("temporal_run_id")
  /// Temporal activity type that produced this trace (e.g. "executeImplementation").
  /// This is NOT a workflow-spec node id; `specNodeId` / `recordingId` are.
  nodeId        String        @map("node_id")
  /// The workflow-spec node (key in `spec.nodes`) the activity ran for. Null when
  /// the activity was not dispatched by the interpreter (non-runnable workflows,
  /// human gates) and on rows that predate the column.
  specNodeId    String?       @map("spec_node_id")
  /// The interpreter's recording id for that node: the spec key, prefixed with the
  /// fan-out branch path inside a branch (`fan[0]/impl`, `fan[0]/inner[1]/impl`).
  /// It matches `WorkflowStep.nodeId`. Null in the same cases as `specNodeId`.
  recordingId   String?       @map("recording_id")
  /// The interpreter's 1-based attempt at that node (`onFail.retry` re-dispatches
  /// the activity); `attempt` below is Temporal's own retry of one dispatch. Null
  /// in the same cases as `specNodeId`.
  stepAttempt   Int?          @map("step_attempt")
  /// The agent key (identity) that produced this trace, e.g. "implementer".
  agentKey      String        @map("agent_key")
  /// The resolved `Agent` row that produced an LLM call. No foreign key: Agent rows
  /// cascade-delete and a trace outlives them. Version numbers count per lineage (key,
  /// scope, team/org/channel/template), so `agentVersion` is only meaningful beside this id.
  /// Null on non-LLM rows, on rows that predate the column, and where the call site has no
  /// `Agent` row (embeddings).
  agentId       String?       @map("agent_id") @db.Uuid
  /// The resolved `Agent.version` (display) of `agentId`; null in the same cases.
  agentVersion  Int?          @map("agent_version")
  /// Temporal activity attempt number (1-based). Lets the UI group traces by retry attempt.
  attempt       Int           @default(1)
  seq           Int
  /// "tool_call" | "llm_response" | "activity_event"
  type          String
  toolName      String?       @map("tool_name")
  inputJson     Json?         @map("input_json")
  outputJson    Json?         @map("output_json")
  durationMs    Int?          @map("duration_ms")
  error         String?
  /// `<provider>/<model>` spec used for this LLM call. Null for tool_call and activity_event rows.
  model         String?
  /// Input token count for this LLM call. Null for non-LLM records.
  inputTokens   Int?          @map("input_tokens")
  /// Output token count for this LLM call. Null for non-LLM records.
  outputTokens  Int?          @map("output_tokens")
  /// USD cost of this LLM call, rounded to micro-dollars. Null for non-LLM records.
  costUsd       Float?        @map("cost_usd")
  /// W3C trace-id of the OTel span active when this activity was persisted.
  /// Enables correlation between AgentTrace DB rows and Grafana/Tempo spans.
  otelTraceId   String?       @map("otel_trace_id")
  /// W3C span-id of the OTel span active when this activity was persisted.
  otelSpanId    String?       @map("otel_span_id")
  /// The team whose spend this row is, denormalized at write time (worker
  /// `currentSpendOwner`) so usage can be broken down by tenant without the
  /// run → request → connection join, which a workflow with no run cannot make.
  /// Null when no team is derivable (a GLOBAL eval dataset, an epic's planning)
  /// and on rows that predate the column.
  teamId        String?       @map("team_id") @db.Uuid
  team          Team?         @relation("TeamAgentTraces", fields: [teamId], references: [id], onDelete: SetNull)
  /// The organization of `team`, or the owner itself when only an organization
  /// is known (an ORGANIZATION-scoped eval dataset).
  orgId         String?       @map("org_id") @db.Uuid
  org           Organization? @relation("OrgAgentTraces", fields: [orgId], references: [id], onDelete: SetNull)
  /// The in-app assistant reply whose turn wrote this row, so the admin failure view reads exactly
  /// that turn's rows. Null for every other activity and on rows that predate the column; set null
  /// when the conversation is deleted, so the row's spend survives it.
  assistantMessageId String?           @map("assistant_message_id") @db.Uuid
  assistantMessage   AssistantMessage? @relation(fields: [assistantMessageId], references: [id], onDelete: SetNull)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz

  @@index([runId, nodeId])
  @@index([runId, createdAt])
  @@index([createdAt, runId])
  @@index([createdAt])
  @@index([workflowId, temporalRunId])
  @@index([teamId, createdAt])
  @@index([orgId, createdAt])
  @@index([assistantMessageId])
  @@map("agent_traces")
}

/// One UTC day of `llm_response` traces, summed per
/// (team, org, run, agent, model, activity, launcher). The usage report reads completed days from
/// here and the current days from `agent_traces`; the rollup sweep rewrites a whole day in one
/// transaction (delete the day, insert its groups), so a day is either fully present or absent.
/// Plain columns, no relations: rollup rows are derived data and must survive the deletion of the
/// team, run or user they name. There is deliberately no unique index — most key columns are
/// nullable, and Postgres treats NULLs as distinct in one.
model AgentTraceDailyUsage {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// The UTC calendar day of `agent_traces.created_at`.
  day             DateTime @db.Date
  teamId          String?  @map("team_id") @db.Uuid
  orgId           String?  @map("org_id") @db.Uuid
  runId           String?  @map("run_id") @db.Uuid
  agentKey        String   @map("agent_key")
  /// `AgentTrace.agentId`: null for traces recorded without a resolved `Agent` row and for days
  /// rolled up from rows that predate the column (never rewritten). No foreign key.
  agentId         String?  @map("agent_id") @db.Uuid
  model           String?
  nodeId          String   @map("node_id")
  /// `WorkflowRun.launchedById`, taken only when the trace's Temporal run id is the one the run
  /// row was written by; null otherwise and for runless traces.
  launcherId      String?  @map("launcher_id") @db.Uuid
  calls           Int
  errors          Int
  inputTokens     BigInt   @map("input_tokens")
  outputTokens    BigInt   @map("output_tokens")
  costUsd         Decimal  @map("cost_usd") @db.Decimal(18, 10)
  /// Summed duration of the calls that did not fail, and how many of them recorded one.
  okDurationMs    BigInt   @map("ok_duration_ms")
  okDurationCount Int      @map("ok_duration_count")

  @@index([day, teamId])
  @@index([day, orgId])
  @@index([launcherId, day])
  @@index([runId])
  @@map("agent_trace_daily_usage")
}

/// A full-fidelity record of one activity attempt's model traffic: every
/// recorded model HTTP call (and, for a non-proxied Claude Code turn, each
/// harness message), flushed to `agent_transcript_parts` as gzipped NDJSON.
/// Best-effort persistence: a write failure never fails the activity, it only
/// leaves the row 'incomplete'.
///
/// `runId` is nullable for the same reasons `AgentTrace.runId` is (runless
/// workflows, deleted runs — transcripts outlive their run until retention
/// expires); `SetNull` rather than `Cascade` is what lets them.
model AgentTranscript {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  runId              String?        @map("run_id") @db.Uuid
  run                WorkflowRun?   @relation(fields: [runId], references: [id], onDelete: SetNull)
  /// The in-app assistant reply whose turn this transcript covers; same source
  /// as `AgentTrace.assistantMessageId`.
  assistantMessageId String?        @map("assistant_message_id") @db.Uuid
  assistantMessage   AssistantMessage? @relation(fields: [assistantMessageId], references: [id], onDelete: SetNull)
  workflowId         String         @map("workflow_id")
  temporalRunId      String?        @map("temporal_run_id")
  /// Temporal activity type that produced this transcript (e.g. "executeImplementation").
  activityType       String         @map("activity_type")
  specNodeId         String?        @map("spec_node_id")
  recordingId        String?        @map("recording_id")
  stepAttempt        Int?           @map("step_attempt")
  /// Temporal activity attempt number (1-based).
  attempt            Int            @default(1)
  /// The agent keys that wrote trace rows during this attempt (dedup'd at write).
  agentKeys          String[]       @default([]) @map("agent_keys")
  /// 'ai-sdk' | 'claude-code' — which runtime's capture path wrote the records.
  runtime            String         @default("ai-sdk")
  /// open | complete | truncated | incomplete | abandoned
  status             String         @default("open")
  /// succeeded | failed | cancelled — the activity attempt's own outcome.
  activityOutcome    String?        @map("activity_outcome")
  /// Number of `http_call` records written.
  modelCallCount     Int            @default(0) @map("model_call_count")
  /// Compressed bytes summed over parts.
  sizeBytes          Int            @default(0) @map("size_bytes")
  /// sha256 of the ordered part hashes joined by '\n'.
  sha256             String?
  /// The team/org that owns this transcript; same rule as AgentTrace — absent
  /// when the run lookup failed.
  teamId             String?        @map("team_id") @db.Uuid
  team               Team?          @relation("TeamAgentTranscripts", fields: [teamId], references: [id], onDelete: SetNull)
  orgId              String?        @map("org_id") @db.Uuid
  org                Organization?  @relation("OrgAgentTranscripts", fields: [orgId], references: [id], onDelete: SetNull)
  /// Copied from the run at open time; while true the retention sweep keeps
  /// this transcript and its parts. The hold route keeps the two in step.
  // Per-transcript hold, set directly on this transcript.
  legalHold          Boolean        @default(false) @map("legal_hold")
  legalHoldReason    String?        @map("legal_hold_reason")
  legalHoldById      String?        @map("legal_hold_by_id")
  legalHoldAt        DateTime?      @map("legal_hold_at") @db.Timestamptz
  // The run-level hold, copied at create so it survives the run.
  runLegalHold       Boolean        @default(false) @map("run_legal_hold")
  runLegalHoldReason String?        @map("run_legal_hold_reason")
  runLegalHoldById   String?        @map("run_legal_hold_by_id")
  runLegalHoldAt     DateTime?      @map("run_legal_hold_at") @db.Timestamptz
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz
  closedAt           DateTime?      @map("closed_at") @db.Timestamptz

  parts              AgentTranscriptPart[]

  @@index([runId])
  @@index([workflowId, temporalRunId])
  @@index([orgId, createdAt])
  @@index([teamId, createdAt])
  @@index([createdAt])
  @@index([status, updatedAt])
  @@map("agent_transcripts")
}

/// One flushed chunk of a transcript: gzipped NDJSON in a WorkflowArtifact.
/// `onDelete: Restrict` on the artifact keeps a part row from losing its
/// payload silently — the sweep deletes the artifact first, then the row.
model AgentTranscriptPart {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transcriptId String           @map("transcript_id") @db.Uuid
  transcript   AgentTranscript  @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
  /// 0-based flush order.
  seq          Int              @map("seq")
  artifactId   String           @map("artifact_id") @db.Uuid
  artifact     WorkflowArtifact @relation(fields: [artifactId], references: [id], onDelete: Restrict)
  /// sha256 (hex) of the gzipped bytes.
  sha256       String
  /// Compressed bytes.
  sizeBytes    Int              @map("size_bytes")
  recordCount  Int              @map("record_count")
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz

  @@unique([transcriptId, seq])
  @@index([artifactId])
  @@map("agent_transcript_parts")
}

/// Audit trail of transcript access: content reads, download-link issues,
/// exports, integrity verifications, legal-hold changes, and refused attempts. Deliberately no foreign keys — a row
/// outlives the user, run and transcript it names — and no tenant columns: it
/// is ADMIN-only and pruned by `workflow.transcriptAccessLogRetentionDays`.
model TranscriptAccessLog {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// content_read | download_link | export | verify | legal_hold_set | legal_hold_cleared
  action       String
  /// transcript | run | export
  scope        String
  actorId      String?   @map("actor_id")
  actorRole    String?   @map("actor_role")
  transcriptId String?   @map("transcript_id") @db.Uuid
  runId        String?   @map("run_id") @db.Uuid
  /// format, scrubPii, from, to, agentKey, activityType, reason, via ('api' | 'download_link')
  params       Json?
  /// started | ok | integrity_error | stream_error | aborted | denied
  outcome      String    @default("started")
  ip           String?
  userAgent    String?   @map("user_agent")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  completedAt  DateTime? @map("completed_at") @db.Timestamptz

  @@index([createdAt])
  @@index([transcriptId, createdAt])
  @@index([actorId, createdAt])
  @@index([runId, createdAt])
  @@map("transcript_access_log")
}

/// One node execution within a run. Recorded incrementally so the UI can show
/// live progress and post-mortems can trace which nodes ran in what order.
model WorkflowStep {
  id        String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  runId     String             @map("run_id") @db.Uuid
  run       WorkflowRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  nodeId    String             @map("node_id")
  specNodeId String?           @map("spec_node_id")
  nodeType  String?            @map("node_type")
  stepName  String?            @map("step_name")
  attempt   Int                @default(1)
  status    WorkflowStepStatus @default(PENDING)
  startedAt DateTime?          @map("started_at") @db.Timestamptz
  endedAt   DateTime?          @map("ended_at") @db.Timestamptz
  inputs    Json?
  outputs   Json?
  error     String?

  @@unique([runId, nodeId, attempt])
  @@index([runId])
  @@index([runId, nodeId])
  @@index([endedAt, runId])
  @@map("workflow_steps")
}

/// A human action required to resume a workflow run. Created when the interpreter
/// reaches a humanApproval / humanDecision / humanInput / humanReview node.
/// The run stays RUNNING (workflow paused at condition()) until a human responds
/// via POST /api/v1/human-steps/:id/respond or the step times out.
model WorkflowHumanStep {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  runId             String          @map("run_id") @db.Uuid
  run               WorkflowRun     @relation(fields: [runId], references: [id], onDelete: Cascade)
  nodeId            String          @map("node_id")
  signalName        String          @map("signal_name")
  kind              HumanStepKind
  title             String
  description       String?
  /// Snapshot of relevant workflow context (e.g. the code diff, PR description).
  context           Json?
  /// For DECISION: [{ label, value }] options the human can choose from.
  options           Json?
  /// For INPUT: [{ key, label, type, required?, options? }] field definitions.
  fields            Json?
  status            HumanStepStatus @default(PENDING)
  resolvedAt        DateTime?       @map("resolved_at") @db.Timestamptz
  resolvedBy        String?         @map("resolved_by") @db.Uuid
  resolvedByUser    User?           @relation(fields: [resolvedBy], references: [id], onDelete: SetNull)
  /// web, slack, api_token, mcp, or assistant; null for historical resolutions.
  resolvedVia       String?         @map("resolved_via")
  /// The signal payload submitted by the human (action + optional value).
  payload           Json?
  requestedAt       DateTime        @default(now()) @map("requested_at") @db.Timestamptz
  /// Absolute deadline derived from the node's timeout duration. Null for steps
  /// created before this column was added (backwards-compatible).
  timeoutAt         DateTime?       @map("timeout_at") @db.Timestamptz
  /// Number of distinct approvals required before the step is resolved.
  /// Defaults to 1 for all steps created before this column was added.
  requiredApprovers Int             @default(1) @map("required_approvers")
  /// The Slack message that announced this step: `{ channel, ts, text }`, where `text` is the
  /// message header (no buttons). It lets the step's resolution, from the web or from Slack,
  /// edit that message to show the decision. Null when nothing was posted.
  slackMessage      Json?           @map("slack_message")

  humanApprovals HumanApproval[]

  @@index([runId])
  @@index([runId, nodeId])
  @@index([status])
  @@index([resolvedBy])
  @@index([requestedAt])
  @@index([resolvedAt, runId])
  @@map("workflow_human_steps")
}

/// A single human response recorded against a WorkflowHumanStep.
/// Used to count distinct approvers before the step is finally resolved.
model HumanApproval {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stepId         String            @map("step_id") @db.Uuid
  step           WorkflowHumanStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  resolvedBy     String?           @map("resolved_by") @db.Uuid
  resolvedByUser User?             @relation(fields: [resolvedBy], references: [id], onDelete: SetNull)
  /// web, slack, api_token, mcp, or assistant; null for historical resolutions.
  resolvedVia    String?           @map("resolved_via")
  action         String
  value          Json?
  resolvedAt     DateTime          @default(now()) @map("resolved_at") @db.Timestamptz

  @@unique([stepId, resolvedBy])
  @@index([stepId])
  @@index([resolvedBy])
  @@map("human_approvals")
}

/// A named, team-owned workflow template. Versions are immutable; "edit" creates
/// a new WorkflowTemplateVersion. Exactly one version may be marked active per
/// template (enforced in application code).
model WorkflowTemplate {
  id                                     String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId                                 String?                @map("team_id") @db.Uuid
  /// Restrict, not SetNull: a null `teamId` means GLOBAL, so nulling it on team
  /// deletion would publish that team's private templates to every tenant.
  team                                   Team?                  @relation(fields: [teamId], references: [id], onDelete: Restrict)
  name                                   String
  description                            String                 @default("")
  /// Declarative input contract for run submission — a JSON-Schema-subset
  /// object (`{ type:'object', properties, required }`) the gateway validates
  /// the run-input payload against. Null = no declared schema (accept any
  /// payload). SWE's default template declares `{ ticketId, connectionId,
  /// description, budget }`.
  inputSchema                            Json?                  @map("input_schema")
  /// Workspace provider this template expects for the run. Must be one of the
  /// registered workspace provider types (`git_repo`, `document`, `record`,
  /// `api_only`). Null = legacy behaviour; the runtime falls back to `git_repo`.
  workspaceProvider                      String?                @map("workspace_provider")
  /// Phase-5 assumed human minutes this template saves per run.
  /// Set by template authors; analytics roll it up by team/org.
  estimatedHumanTimeSavedMinutes         Float?                 @map("estimated_human_time_saved_minutes")
  // Provenance: null = core platform; 'swe-starter' = SWE seed content (removable).
  origin                                 String?
  status                                 WorkflowTemplateStatus @default(DRAFT)
  isDefault                              Boolean                @default(false) @map("is_default")
  activeVersion                          Int?                   @map("active_version")
  /// A/B experiment: percent of incoming work requests routed to `experimentVersion`
  /// instead of `activeVersion`. 0 or NULL disables the experiment.
  experimentVersion                      Int?                   @map("experiment_version")
  experimentSplit                        Int?                   @map("experiment_split")
  /// Random token used to trigger this template via the public webhook endpoint.
  /// Null = no webhook configured. Treated as a secret — only shown to LEADs/ADMINs.
  webhookToken                           String?                @unique @map("webhook_token")
  /// HMAC secret a caller signs webhook bodies with (`X-AutoSwe-Signature`, docs/automations.md §5),
  /// sealed with the AES-GCM envelope. Null = no signing secret.
  webhookSigningSecretCiphertext         Bytes?                 @map("webhook_signing_secret_ciphertext")
  webhookSigningSecretNonce              Bytes?                 @map("webhook_signing_secret_nonce")
  webhookSigningSecretAuthTag            Bytes?                 @map("webhook_signing_secret_auth_tag")
  webhookSigningSecretKeyVersion         Int?                   @map("webhook_signing_secret_key_version")
  webhookSigningSecretLastFour           String?                @map("webhook_signing_secret_last_four")
  /// The secret the last rotation replaced, still accepted until `webhookPreviousSigningSecretExpiresAt`.
  webhookPreviousSigningSecretCiphertext Bytes?                 @map("webhook_previous_signing_secret_ciphertext")
  webhookPreviousSigningSecretNonce      Bytes?                 @map("webhook_previous_signing_secret_nonce")
  webhookPreviousSigningSecretAuthTag    Bytes?                 @map("webhook_previous_signing_secret_auth_tag")
  webhookPreviousSigningSecretKeyVersion Int?                   @map("webhook_previous_signing_secret_key_version")
  webhookPreviousSigningSecretLastFour   String?                @map("webhook_previous_signing_secret_last_four")
  webhookPreviousSigningSecretExpiresAt  DateTime?              @map("webhook_previous_signing_secret_expires_at") @db.Timestamptz
  /// Refuse unsigned webhook calls. Policy (`workflow.templateWebhookRequireSignature`, resolved
  /// for the template's team) can require it too when this is false; it never turns it off.
  webhookRequireSignature                Boolean                @default(false) @map("webhook_require_signature")
  createdAt                              DateTime               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                              DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  versions              WorkflowTemplateVersion[]
  workflowRuns          WorkflowRun[]
  attributedPullRequests PullRequest[]
  agents                Agent[]
  scheduledWorkRequests ScheduledWorkRequest[]
  configSettings        ConfigSetting[]
  automations           Automation[]
  autonomyPolicies      AutonomyPolicy[]

  @@unique([teamId, name])
  @@map("workflow_templates")
}

/// Governance policy that decides whether an outcome can be published
/// automatically or must pause for human approval. Resolution cascade:
/// template-specific policy → team default policy → seeded global default.
model AutonomyPolicy {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId      String?           @map("team_id") @db.Uuid
  team        Team?             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  templateId  String?           @map("template_id") @db.Uuid
  template    WorkflowTemplate? @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name        String
  description String?
  isDefault   Boolean           @default(false) @map("is_default")
  /// JSON rules keyed by risk class, e.g.
  /// { "external_communication": { "action": "require_approval" } }
  rules       Json
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([teamId])
  @@index([templateId])
  @@map("autonomy_policies")
}

/// Immutable snapshot of a template at version N. `spec` is validated against
/// WorkflowSpecSchema on insert in the gateway.
model WorkflowTemplateVersion {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  templateId String           @map("template_id") @db.Uuid
  template   WorkflowTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  version    Int
  spec       Json
  /// The template's declared inputs **as of this version**, snapshotted beside the spec. The
  /// schema is what says which connections a payload may name, so a run pins its authorized set
  /// from the version it executes: retyping an input on the template cannot then widen the pin of
  /// a run already under way, nor refuse a connection to an experiment arm or a rollback that
  /// runs an older version.
  ///
  /// Nullable: a version written before this column existed falls back to the template's current
  /// schema, which is the behaviour that predates it.
  inputSchema Json? @map("input_schema")
  createdBy  String?          @map("created_by") @db.Uuid
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz

  /// Set when the version was produced by the workflow author agent
  /// (e.g. 'workflow_author'). Null for manually-authored versions.
  generatedBy String? @map("generated_by")

  /// Human review timestamp + reviewer before a generated version may be
  /// promoted to active. Empty for non-generated versions.
  reviewedAt DateTime? @map("reviewed_at") @db.Timestamptz
  reviewedBy String?   @map("reviewed_by") @db.Uuid

  shellAudits WorkflowShellAudit[]

  @@unique([templateId, version])
  @@index([reviewedBy])
  @@map("workflow_template_versions")
}

/// Encrypted API credential for one LLM provider, scoped GLOBAL, ORGANIZATION,
/// or TEAM. (WORKFLOW_TEMPLATE scope is intentionally unsupported — templates can
/// reference existing credentials via `ModelRoleConfig.credentialId` but
/// can't create their own.) Resolution cascade: TEAM → ORGANIZATION → GLOBAL.
/// API key bytes are AES-256-GCM encrypted with
/// the key from `CONFIG_ENCRYPTION_KEY`; see `packages/shared/src/lib/crypto.ts`.
/// `lastFour` is the trailing four plaintext chars, stored for UI display
/// only. `keyVersion` exists for future key-rotation support.
model ProviderCredential {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider         String
  scope            ConfigScope
  teamId           String?       @map("team_id") @db.Uuid
  team             Team?         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  /// Owning Organization for ORGANIZATION-scoped rows (null otherwise) (P5).
  orgId            String?       @map("org_id") @db.Uuid
  organization     Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  apiBase          String?       @map("api_base")
  apiKeyCiphertext Bytes         @map("api_key_ciphertext")
  apiKeyNonce      Bytes         @map("api_key_nonce")
  apiKeyAuthTag    Bytes         @map("api_key_auth_tag")
  keyVersion       Int           @default(1) @map("key_version")
  lastFour         String        @map("last_four")
  createdById      String?       @map("created_by_id") @db.Uuid
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  embeddingConfigs EmbeddingConfig[]
  agents           Agent[]

  @@index([provider, scope, teamId])
  @@index([provider, scope, orgId])
  @@index([teamId])
  @@index([orgId])
  @@map("provider_credentials")
}

/// System-wide embedding-model selection. Singleton — exactly one row is
/// permitted (enforced by a CHECK constraint on the `id` column in the
/// migration alongside this model). The semantic-memory pipeline reads this
/// row at every `generateEmbedding` call; mutations go through
/// `/api/v1/platform/embedding-config`.
///
/// `credentialId` pins a specific ProviderCredential when set, otherwise the
/// resolver looks up the credential by the provider parsed from `modelSpec`.
/// pgvector storage is fixed at vector(1536), so the chosen model MUST
/// produce 1536-dim embeddings (worker throws if it doesn't).
model EmbeddingConfig {
  id           String              @id @default("default")
  modelSpec    String              @map("model_spec")
  credentialId String?             @map("credential_id") @db.Uuid
  credential   ProviderCredential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)
  updatedById  String?             @map("updated_by_id") @db.Uuid
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("embedding_configs")
}

enum ModelKind {
  CHAT
  EMBEDDING
}

/// Drives the model pickers, never pricing: a RETIRED model is hidden from
/// pickers but still priced, since pinned agent versions keep billing to it.
enum ModelStatus {
  ACTIVE
  DEPRECATED
  RETIRED
}

/// One row per `<provider>/<model-id>` spec: the per-MTok USD prices LLM calls
/// are costed at. Global — prices are facts about a vendor, not policy. Built-in
/// rows are seeded from `BUILTIN_MODELS` by `syncModelCatalog`, which keeps an
/// untouched built-in in step with code and never overwrites a customized one.
/// A 0/0 row is a known, free model (a self-hosted endpoint), not an unknown one.
model ModelCatalogEntry {
  id                     String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Lowercase, as `parseProviderModelSpec` returns it.
  provider               String
  /// Everything after the first `/` of the spec; may itself contain slashes.
  modelId                String      @map("model_id")
  kind                   ModelKind   @default(CHAT)
  displayName            String?     @map("display_name")
  inputUsdPerMTok        Float       @map("input_usd_per_mtok")
  outputUsdPerMTok       Float       @map("output_usd_per_mtok")
  /// Prompt-cache rates as multiples of `inputUsdPerMTok`. Null means "no
  /// override": pricing then uses the code table (`cacheMultipliers`), so a
  /// built-in row seeded without them follows the table as it is corrected.
  cacheReadMultiplier    Float?      @map("cache_read_multiplier")
  /// Input written to the cache with the 5-minute TTL.
  cacheWrite5mMultiplier Float?      @map("cache_write_5m_multiplier")
  /// Input written to the cache with the 1-hour TTL (Anthropic: 2x input).
  cacheWrite1hMultiplier Float?      @map("cache_write_1h_multiplier")
  status                 ModelStatus @default(ACTIVE)
  notes                  String?
  isBuiltIn              Boolean     @default(false) @map("is_built_in")
  /// Set by any admin edit to a built-in row; seeding then leaves it alone.
  isCustomized           Boolean     @default(false) @map("is_customized")
  createdAt              DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([provider, modelId])
  @@map("model_catalog_entries")
}

/// Why a model is on the discovery list. NEW: a provider lists it and nothing
/// prices it. RETIREMENT_CANDIDATE: priced here, but a provider whose listing
/// succeeded no longer lists it. Neither changes the catalog.
enum ModelSuggestionType {
  NEW
  RETIREMENT_CANDIDATE
}

/// A flag raised by model discovery, kept apart from `model_catalog_entries` so
/// that discovery can never make a model "known" at $0 and the pricing path never
/// reads it. Written only by the discovery run; an admin only dismisses it. A NEW
/// row disappears once the model is priced, a RETIREMENT_CANDIDATE once the
/// provider lists it again or the model is retired; nothing here retires a model.
/// A dismissed row is never deleted for being absent from a listing, so a
/// dismissal survives the model leaving and returning; the API hides a dismissed row
/// last seen before its provider's last complete listing.
model ModelSuggestion {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider    String
  modelId     String              @map("model_id")
  type        ModelSuggestionType
  kind        ModelKind           @default(CHAT)
  displayName String?             @map("display_name")
  firstSeenAt DateTime            @default(now()) @map("first_seen_at") @db.Timestamptz
  lastSeenAt  DateTime            @default(now()) @map("last_seen_at") @db.Timestamptz
  dismissedAt DateTime?           @map("dismissed_at") @db.Timestamptz

  @@unique([provider, modelId])
  @@map("model_suggestions")
}

/// What the last discovery run saw for one provider: when it asked, and why it
/// got no answer. A provider whose listing failed keeps its previous suggestions
/// untouched, so this row is the only trace the failure leaves.
model ModelDiscoveryProviderStatus {
  provider      String    @id
  checkedAt     DateTime  @map("checked_at") @db.Timestamptz
  /// Last run whose listing was complete; null until one was. A dismissed row last seen
  /// before this no longer applies, and the API hides it.
  lastSuccessAt DateTime? @map("last_success_at") @db.Timestamptz
  /// Null when the last listing succeeded.
  error         String?

  @@map("model_discovery_provider_status")
}

/// Singleton GitHub integration config. One row (id = "default").
/// Encrypted fields follow the same AES-256-GCM envelope used by
/// ProviderCredential (ciphertext + nonce + authTag per secret).
/// GitHub social sign-in credentials (GITHUB_CLIENT_ID / GITHUB_CLIENT_SECRET)
/// are environment-only: they are read once at gateway boot.
model GitHubConfig {
  id String @id @default("default")

  /// PAT used for cloning repos and creating PRs (required to start worker)
  tokenCiphertext Bytes?  @map("token_ciphertext")
  tokenNonce      Bytes?  @map("token_nonce")
  tokenAuthTag    Bytes?  @map("token_auth_tag")
  tokenKeyVersion Int?    @map("token_key_version")
  tokenLastFour   String? @map("token_last_four")

  /// HMAC secret for validating inbound GitHub webhook payloads
  webhookSecretCiphertext Bytes?  @map("webhook_secret_ciphertext")
  webhookSecretNonce      Bytes?  @map("webhook_secret_nonce")
  webhookSecretAuthTag    Bytes?  @map("webhook_secret_auth_tag")
  webhookSecretKeyVersion Int?    @map("webhook_secret_key_version")
  webhookSecretLastFour   String? @map("webhook_secret_last_four")

  /// GitHub App numeric ID (e.g. "12345678")
  appId String? @map("app_id")

  /// GitHub App client ID (e.g. "Iv1.abc...")
  appClientId String? @map("app_client_id")

  /// Encrypted GitHub App client secret
  appClientSecretCiphertext Bytes?  @map("app_client_secret_ciphertext")
  appClientSecretNonce      Bytes?  @map("app_client_secret_nonce")
  appClientSecretAuthTag    Bytes?  @map("app_client_secret_auth_tag")
  appClientSecretKeyVersion Int?    @map("app_client_secret_key_version")
  appClientSecretLastFour   String? @map("app_client_secret_last_four")

  /// Encrypted PEM private key used to sign GitHub App JWTs
  appPrivateKeyCiphertext Bytes?  @map("app_private_key_ciphertext")
  appPrivateKeyNonce      Bytes?  @map("app_private_key_nonce")
  appPrivateKeyAuthTag    Bytes?  @map("app_private_key_auth_tag")
  appPrivateKeyKeyVersion Int?    @map("app_private_key_key_version")
  appPrivateKeyLastFour   String? @map("app_private_key_last_four")

  /// Installation ID for the GitHub App on the target org/account
  appInstallationId String? @map("app_installation_id")

  /// Auth mode: null = auto (use app if fully configured, else PAT), 'pat', or 'app'
  authMode String? @map("auth_mode")

  /// Base URL for git clone operations; null → https://github.com
  baseUrl String? @map("base_url")
  /// Octokit REST API base URL; null → https://api.github.com (for GHE)
  apiUrl  String? @map("api_url")

  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("github_config")
}

/// Singleton Slack integration config. One row (id = "default").
/// Requires a gateway restart only for clientId / clientSecret (used by the
/// OAuth flow at server init). botToken and signingSecret are resolved
/// fresh per request/activity.
model SlackConfig {
  id String @id @default("default")

  clientId String? @map("client_id")

  clientSecretCiphertext Bytes?  @map("client_secret_ciphertext")
  clientSecretNonce      Bytes?  @map("client_secret_nonce")
  clientSecretAuthTag    Bytes?  @map("client_secret_auth_tag")
  clientSecretKeyVersion Int?    @map("client_secret_key_version")
  clientSecretLastFour   String? @map("client_secret_last_four")

  signingSecretCiphertext Bytes?  @map("signing_secret_ciphertext")
  signingSecretNonce      Bytes?  @map("signing_secret_nonce")
  signingSecretAuthTag    Bytes?  @map("signing_secret_auth_tag")
  signingSecretKeyVersion Int?    @map("signing_secret_key_version")
  signingSecretLastFour   String? @map("signing_secret_last_four")

  botTokenCiphertext Bytes?  @map("bot_token_ciphertext")
  botTokenNonce      Bytes?  @map("bot_token_nonce")
  botTokenAuthTag    Bytes?  @map("bot_token_auth_tag")
  botTokenKeyVersion Int?    @map("bot_token_key_version")
  botTokenLastFour   String? @map("bot_token_last_four")

  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("slack_config")
}

/// Singleton workflow behaviour defaults. One row (id = "default").
/// All fields have fallback values so the row is optional — the worker
/// falls back to the baked-in defaults when no row exists.
model WorkflowDefaults {
  id String @id @default("default")

  branchPrefix    String @default("auto") @map("branch_prefix")
  prTitleTemplate String @default("[auto-swe] {{ticketId}}") @map("pr_title_template")
  prBodyTemplate  String @default("") @map("pr_body_template")
  defaultTeamSlug String @default("default") @map("default_team_slug")

  // Lesson consolidation schedule. The gateway reads these on startup and on
  // every admin save, then syncs the Temporal Schedule accordingly.
  consolidationEnabled             Boolean @default(true) @map("consolidation_enabled")
  consolidationCron                String  @default("0 3 * * 0") @map("consolidation_cron")
  consolidationMinClusterSize      Int     @default(3) @map("consolidation_min_cluster_size")
  consolidationSimilarityThreshold Float   @default(0.85) @map("consolidation_similarity_threshold")

  // Nightly eval-regression schedule. Synced to a Temporal Schedule the same way
  // as consolidation. Disabled by default — it needs a seeded benchmark dataset
  // and a worker that can reach Docker + the model provider.
  evalScheduleEnabled      Boolean @default(false) @map("eval_schedule_enabled")
  evalScheduleCron         String  @default("0 7 * * *") @map("eval_schedule_cron")
  evalScheduleDatasetSlug  String  @default("swe-implementer-golden") @map("eval_schedule_dataset_slug")
  evalScheduleCandidateRef String  @default("main") @map("eval_schedule_candidate_ref")
  evalScheduleBaselineRef  String  @default("last-release") @map("eval_schedule_baseline_ref")

  // Eval golden-set re-validation schedule. The gateway reads these on startup
  // and on PUT /api/v1/platform/config/revalidation. Disabled by default — needs seeded
  // EvalDatasets and a Docker-capable worker.
  revalidationEnabled     Boolean @default(false) @map("revalidation_enabled")
  revalidationCron        String  @default("0 5 * * 0") @map("revalidation_cron")
  revalidationDatasetSlug String? @map("revalidation_dataset_slug")

  // Production canary: routes a configured fraction of work-requests to a
  // candidate agent version for fast per-change A/B comparison (evals P2).
  // Disabled by default.
  canaryEnabled          Boolean @default(false) @map("canary_enabled")
  canaryAgentKey         String? @map("canary_agent_key")
  canaryCandidateVersion Int?    @map("canary_candidate_version")
  canaryPercent          Float   @default(0) @map("canary_percent")

  // ── Tier-2 operator knobs (GLOBAL) — previously hardcoded in the worker,
  //    now DB-tunable via /admin/workflow. Consumers read them through
  //    resolveWorkflowDefaults() (cached), falling back to these defaults. ──

  // Per-tier token budgets enforced by the worker's cost tracker.
  budgetStandardInputTokens  Int @default(2000000) @map("budget_standard_input_tokens")
  budgetStandardOutputTokens Int @default(500000) @map("budget_standard_output_tokens")
  budgetLargeInputTokens     Int @default(8000000) @map("budget_large_input_tokens")
  budgetLargeOutputTokens    Int @default(2000000) @map("budget_large_output_tokens")
  budgetEpicInputTokens      Int @default(20000000) @map("budget_epic_input_tokens")
  budgetEpicOutputTokens     Int @default(5000000) @map("budget_epic_output_tokens")

  // Agent refine-loop caps (quality/cost).
  maxTddIterations  Int @default(5) @map("max_tdd_iterations")
  maxEvalIterations Int @default(3) @map("max_eval_iterations")

  // Lesson (semantic-memory) retrieval relevance knobs.
  lessonRetrievalLimit     Int   @default(5) @map("lesson_retrieval_limit")
  lessonRetrievalThreshold Float @default(0.7) @map("lesson_retrieval_threshold")

  // CI-wait strategy. `signal` blocks for a GitHub webhook; `poll` actively
  // queries the CI APIs, for deployments no inbound webhook can reach
  // (local dev, air-gapped). Nullable so an unset row keeps the env fallback.
  ciWaitMode        String? @map("ci_wait_mode")
  ciPollIntervalSec Int?    @map("ci_poll_interval_sec")
  ciPollGraceSec    Int?    @map("ci_poll_grace_sec")
  ciPollDeadlineSec Int?    @map("ci_poll_deadline_sec")

  // Eval-suite health gate + LLM-judge decision thresholds.
  evalHealthMaxFlakeRate Float @default(0.1) @map("eval_health_max_flake_rate")
  evalHealthMaxStaleRate Float @default(0.1) @map("eval_health_max_stale_rate")
  evalHealthMinKappa     Float @default(0.4) @map("eval_health_min_kappa")
  evalJudgeThreshold     Float @default(0.5) @map("eval_judge_threshold")

  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("workflow_defaults")
}

