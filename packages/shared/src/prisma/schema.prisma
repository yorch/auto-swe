generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

enum Role {
  ADMIN
  LEAD
  ENGINEER
}

enum WorkflowRunStatus {
  RUNNING
  SUCCESS
  FAILED
  TIMED_OUT
  SKIPPED
  CANCELLED
}

enum WorkflowStepStatus {
  PENDING
  RUNNING
  PASSED
  FAILED
  SKIPPED
}

enum WorkflowTemplateStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ConfigScope {
  GLOBAL
  TEAM
  WORKFLOW_TEMPLATE
}

enum SkillType {
  TOOL
  PROMPT_FRAGMENT
}

enum AgentRole {
  IMPLEMENTER
  REVIEWER
  PLANNER
  SECURITY_REVIEW
  VALIDATE_CONTEXT
  COMMIT_TO_MEMORY
}

enum ConfigAuditAction {
  CREATE
  UPDATE
  DELETE
}

enum HumanStepKind {
  APPROVAL
  DECISION
  INPUT
  REVIEW
}

enum HumanStepStatus {
  PENDING
  RESOLVED
  TIMED_OUT
  CANCELLED
}

model ActiveWorkflow {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  temporalWorkflowId String         @unique @map("temporal_workflow_id")
  parentWorkflowId   String?        @map("parent_workflow_id")
  workRequestId      String?        @map("work_request_id") @db.Uuid
  workRequest        WorkRequest?   @relation(fields: [workRequestId], references: [id])
  repoId             String?        @map("repo_id") @db.Uuid
  repository         Repository?    @relation(fields: [repoId], references: [id])
  currentStatus      String         @map("current_status")
  assignedBranch     String?        @map("assigned_branch")
  budgetTier         String         @default("STANDARD") @map("budget_tier")
  tokensInputUsed    Int            @default(0) @map("tokens_input_used")
  tokensOutputUsed   Int            @default(0) @map("tokens_output_used")
  costUsdAccrued     Float          @default(0) @map("cost_usd_accrued")
  updatedAt          DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  pullRequests       PullRequest[]
  agentLessons       AgentLesson[]

  @@map("active_workflows")
}

// HNSW index on `embedding` is defined in raw SQL inside
// migrations/20260510000001_pgvector_hnsw_index/migration.sql. Prisma's schema
// DSL cannot model pgvector index types, so `prisma migrate dev` will report
// drift here. Use `yarn db:migrate` (= migrate deploy) for routine application;
// run `yarn db:migrate:dev` only when authoring a new migration.
model AgentLesson {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workflowId      String?         @map("workflow_id") @db.Uuid
  workflow        ActiveWorkflow? @relation(fields: [workflowId], references: [id])
  repoId          String?         @map("repo_id") @db.Uuid
  repository      Repository?     @relation(fields: [repoId], references: [id])
  rationale       String
  lessonSummary   String          @map("lesson_summary")
  embedding       Unsupported("vector(1536)")?
  failureType     String?         @map("failure_type")
  metadata        Json?
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz
  // Soft-delete: set when this lesson has been merged into a consolidated one.
  // Active lessons always have consolidatedAt = null.
  consolidatedAt  DateTime?       @map("consolidated_at") @db.Timestamptz

  @@map("agent_lessons")
}

model ContextSnapshot {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workRequestId    String       @unique @map("work_request_id") @db.Uuid
  workRequest      WorkRequest  @relation(fields: [workRequestId], references: [id], onDelete: Cascade)
  rawTicketData    Json?        @map("raw_jira_epic")
  rawDocumentation Json?        @map("raw_confluence")
  successCriteria  String[]     @map("success_criteria")
  capturedAt       DateTime     @default(now()) @map("captured_at") @db.Timestamptz

  @@map("context_snapshots")
}

model PullRequest {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workflowId      String?         @map("workflow_id") @db.Uuid
  workflow        ActiveWorkflow? @relation(fields: [workflowId], references: [id])
  repoId          String?         @map("repo_id") @db.Uuid
  repository      Repository?     @relation(fields: [repoId], references: [id])
  prNumber        Int?            @map("pr_number")
  headSha         String          @map("head_sha")
  status          String
  ciStatus        String          @default("PENDING") @map("ci_status")

  @@index([workflowId])
  @@index([repoId])
  @@map("pull_requests")
}

model RefreshToken {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash      String    @unique @map("token_hash")
  family         String    @default(dbgenerated("gen_random_uuid()"))
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId])
  @@index([family])
  @@map("refresh_tokens")
}

/// Phase-8 long-lived API token for CI / CLI use. The plaintext token is
/// returned exactly once on create (`ats_<random>` format); only the sha-256
/// hash is stored. `lastUsedAt` is updated best-effort on each successful
/// auth so admins can prune stale tokens.
model PersonalAccessToken {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  tokenHash   String    @unique @map("token_hash")
  /// The first 12 chars of the plaintext token (`ats_` + 8 random chars).
  /// Non-secret — exists so the admin UI can disambiguate listed tokens
  /// without re-issuing them.
  prefix      String
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz
  lastUsedAt  DateTime? @map("last_used_at") @db.Timestamptz
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId])
  @@map("personal_access_tokens")
}

model Repository {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationName String           @map("organization_name")
  repoName         String           @map("repo_name")
  defaultBranch    String           @default("main") @map("default_branch")
  language         String?          @map("language")
  description      String?          @map("description")
  githubUrl        String?          @map("github_url")
  githubApiUrl     String?          @map("github_api_url")
  mcpServerRef     String?          @map("mcp_server_ref")
  teamId           String           @map("team_id") @db.Uuid
  team             Team             @relation(fields: [teamId], references: [id], onDelete: Restrict)
  executorImage    String?          @default("node:24-alpine") @map("executor_image")
  isActive         Boolean          @default(true) @map("is_active")
  consolidationEnabled Boolean      @default(true) @map("consolidation_enabled")
  /// Optional per-repo overrides for phase-2 quality-gate commands. Shape:
  /// { runLint?: string; runTypecheck?: string; runTests?: string; ... }
  /// Resolution order: step config → this field → built-in defaults.
  gateCommands     Json?            @map("gate_commands")

  activeWorkflows  ActiveWorkflow[]
  pullRequests     PullRequest[]
  agentLessons     AgentLesson[]

  @@unique([organizationName, repoName])
  @@map("repositories")
}

model Team {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique
  slug        String   @unique
  description String   @default("")
  isActive    Boolean  @default(true) @map("is_active")
  /// Per-team additions to the phase-6 shell-step image allowlist. The built-in
  /// images (BUILTIN_SHELL_IMAGES in shared/workflow/shellImageAllowlist.ts) are
  /// always allowed; entries here grant additional `image:tag` strings.
  /// Managed by team admins via the gateway.
  shellImageAllowlist String[] @default([]) @map("shell_image_allowlist")
  egressAllowlist  String[]  @default([]) @map("egress_allowlist")
  /// Phase-7 optional Slack channel ID (e.g. `C0123456`) for per-step failure
  /// notifications. When set + SLACK_BOT_TOKEN is configured, the worker posts
  /// a message on FAILED step records that aren't expected to retry. Null disables.
  slackNotifyChannel String? @map("slack_notify_channel")
  /// Phase-8 opt-in for terminal-run notifications. When true and a notify
  /// channel is resolvable (originating channel on the WorkRequest, or
  /// `slackNotifyChannel`), the worker also posts on SUCCESS / final FAILED
  /// from `finalizeWorkflowRun`. Default false so existing teams don't get
  /// a sudden notification firehose.
  slackNotifySuccess Boolean @default(false) @map("slack_notify_success")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  memberships            TeamMembership[]
  repositories           Repository[]
  workflowTemplates      WorkflowTemplate[]
  shellAudits            WorkflowShellAudit[]
  modelRoleConfigs       ModelRoleConfig[]
  providerCredentials    ProviderCredential[]
  agentSkillAssignments  AgentSkillAssignment[]

  @@map("teams")
}

model TeamMembership {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId    String   @map("team_id") @db.Uuid
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  role      Role     @default(ENGINEER)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([userId, teamId])
  @@index([userId])
  @@index([teamId])
  @@map("team_memberships")
}

model User {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email          String         @unique
  /// Legacy bcrypt hash. Optional because OAuth-only / magic-link-only
  /// users have no password; better-auth stores its own credential hash
  /// in the `accounts` table.
  passwordHash   String?        @map("password_hash")
  /// Better-auth canonical fields.
  name           String?
  emailVerified  Boolean        @default(false) @map("email_verified")
  image          String?
  slackId        String?        @unique @map("slack_id")
  role           Role           @default(ENGINEER)
  isActive       Boolean        @default(true) @map("is_active")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  refreshTokens         RefreshToken[]
  memberships           TeamMembership[]
  accessTokens          PersonalAccessToken[]
  /// Better-auth relations.
  accounts              Account[]
  sessions              Session[]
  humanStepsResolved    WorkflowHumanStep[]

  @@map("users")
}

/// Better-auth `Account` model — one row per linked provider per user.
/// `providerId='credential'` holds the email+password account; OAuth rows
/// carry the access/refresh/id tokens from the upstream provider.
model Account {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId              String    @map("account_id")
  providerId             String    @map("provider_id")
  userId                 String    @map("user_id") @db.Uuid
  accessToken            String?   @map("access_token")
  refreshToken           String?   @map("refresh_token")
  idToken                String?   @map("id_token")
  accessTokenExpiresAt   DateTime? @map("access_token_expires_at") @db.Timestamptz
  refreshTokenExpiresAt  DateTime? @map("refresh_token_expires_at") @db.Timestamptz
  scope                  String?
  /// Better-auth's own credential hash (scrypt) for `providerId='credential'`.
  password               String?
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

/// Better-auth `Session` model — one row per active browser session.
/// Distinct from `RefreshToken` (which the hand-rolled JWT path uses).
model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token     String   @unique
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Better-auth `Verification` model — short-lived tokens for email
/// verification and magic-link sign-in.
model Verification {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([identifier])
  @@map("verifications")
}

model WorkRequest {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  externalTicketId   String           @map("external_ticket_id")
  description        String           @default("")
  requestPayload     String           @map("request_payload")
  slackMessageTs     String?          @map("slack_message_ts")
  /// Channel that originated the request (paired with slackMessageTs to thread
  /// per-step failure notifications back to the source conversation). Populated
  /// when the work request was created via the Slack slash command.
  slackChannelId     String?          @map("slack_channel_id")
  isCrossRepo        Boolean          @default(false) @map("is_cross_repo")
  /// Optional template override; null → use team default. Snapshotted into
  /// WorkflowRun at start so live edits to templates don't affect in-flight runs.
  templateId         String?          @map("template_id") @db.Uuid
  templateVersion    Int?             @map("template_version")
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz

  contextSnapshot    ContextSnapshot?
  activeWorkflows    ActiveWorkflow[]
  workflowRuns       WorkflowRun[]

  @@map("work_requests")
}

/// Large step outputs (diffs, logs, scan artifacts) are kept out of the
/// workflow-history context to stay under Temporal's 50MB cap. The interpreter
/// passes the artifact ID around; activities fetch the blob on demand.
///
/// `backend` is "s3" when ARTIFACT_S3_BUCKET is configured, "pg" otherwise.
/// For "pg" the bytes live in `inlineBlob`; for "s3" only `s3Key` is set.
model WorkflowArtifact {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  runId       String?      @map("run_id") @db.Uuid
  run         WorkflowRun? @relation(fields: [runId], references: [id], onDelete: Cascade)
  kind        String
  contentType String       @default("application/octet-stream") @map("content_type")
  sizeBytes   Int          @map("size_bytes")
  backend     String
  s3Bucket    String?      @map("s3_bucket")
  s3Key       String?      @map("s3_key")
  inlineBlob  Bytes?       @map("inline_blob")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz

  @@index([runId])
  @@map("workflow_artifacts")
}

/// One execution of a template. `specSnapshot` is the parsed WorkflowSpec at
/// start time, so live edits to the template do not affect this run.
model WorkflowRun {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workflowId      String             @unique @map("workflow_id")
  templateId      String             @map("template_id") @db.Uuid
  template        WorkflowTemplate   @relation(fields: [templateId], references: [id], onDelete: Restrict)
  templateVersion Int                @map("template_version")
  workRequestId   String?            @map("work_request_id") @db.Uuid
  workRequest     WorkRequest?       @relation(fields: [workRequestId], references: [id])
  specSnapshot    Json               @map("spec_snapshot")
  contextSnapshot Json?              @map("context_snapshot")
  status          WorkflowRunStatus  @default(RUNNING)
  startedAt       DateTime           @default(now()) @map("started_at") @db.Timestamptz
  endedAt         DateTime?          @map("ended_at") @db.Timestamptz
  /// Phase-8 cost denormalization. Populated by `finalizeWorkflowRun` from
  /// `WorkRequest → ActiveWorkflow.costUsdAccrued` so analytics queries don't
  /// have to re-join through the work-request graph (also keeps numbers stable
  /// if `ActiveWorkflow.costUsdAccrued` is later re-shaped).
  costUsdAccrued  Float              @default(0) @map("cost_usd_accrued")

  steps           WorkflowStep[]
  artifacts       WorkflowArtifact[]
  traces          AgentTrace[]
  humanSteps      WorkflowHumanStep[]

  @@index([templateId])
  @@index([workRequestId])
  @@map("workflow_runs")
}

/// One tool call, LLM response, or activity event captured during an agent activity execution.
/// `nodeId` is the Temporal activity type (e.g. "executeImplementation"); correlate to a
/// spec node by finding the node where `specSnapshot.nodes[id].step === nodeId`.
/// `attempt` mirrors the Temporal activity attempt number so retry attempts can be separated.
/// Persisted best-effort — failures are swallowed so tracing never breaks runs.
model AgentTrace {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  runId      String      @map("run_id") @db.Uuid
  run        WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  /// Temporal activity type that produced this trace (e.g. "executeImplementation").
  nodeId     String      @map("node_id")
  agentRole  String      @map("agent_role")
  /// Temporal activity attempt number (1-based). Lets the UI group traces by retry attempt.
  attempt    Int         @default(1)
  seq        Int
  /// "tool_call" | "llm_response" | "activity_event"
  type       String
  toolName   String?     @map("tool_name")
  inputJson  Json?       @map("input_json")
  outputJson Json?       @map("output_json")
  durationMs Int?        @map("duration_ms")
  error      String?
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz

  @@index([runId, nodeId])
  @@map("agent_traces")
}

/// One node execution within a run. Recorded incrementally so the UI can show
/// live progress and post-mortems can trace which nodes ran in what order.
model WorkflowStep {
  id        String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  runId     String              @map("run_id") @db.Uuid
  run       WorkflowRun         @relation(fields: [runId], references: [id], onDelete: Cascade)
  nodeId    String              @map("node_id")
  attempt   Int                 @default(1)
  status    WorkflowStepStatus  @default(PENDING)
  startedAt DateTime?           @map("started_at") @db.Timestamptz
  endedAt   DateTime?           @map("ended_at") @db.Timestamptz
  inputs    Json?
  outputs   Json?
  error     String?

  @@index([runId])
  @@index([runId, nodeId])
  @@map("workflow_steps")
}

/// A human action required to resume a workflow run. Created when the interpreter
/// reaches a humanApproval / humanDecision / humanInput / humanReview node.
/// The run stays RUNNING (workflow paused at condition()) until a human responds
/// via POST /api/v1/inbox/:id/respond or the step times out.
model WorkflowHumanStep {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  runId        String          @map("run_id") @db.Uuid
  run          WorkflowRun     @relation(fields: [runId], references: [id], onDelete: Cascade)
  nodeId       String          @map("node_id")
  signalName   String          @map("signal_name")
  kind         HumanStepKind
  title        String
  description  String?
  /// Snapshot of relevant workflow context (e.g. the code diff, PR description).
  context      Json?
  /// For DECISION: [{ label, value }] options the human can choose from.
  options      Json?
  /// For INPUT: [{ key, label, type, required?, options? }] field definitions.
  fields       Json?
  status       HumanStepStatus @default(PENDING)
  resolvedAt   DateTime?       @map("resolved_at") @db.Timestamptz
  resolvedBy   String?         @map("resolved_by") @db.Uuid
  resolvedByUser User?         @relation(fields: [resolvedBy], references: [id], onDelete: SetNull)
  /// The signal payload submitted by the human (action + optional value).
  payload      Json?
  requestedAt  DateTime        @default(now()) @map("requested_at") @db.Timestamptz

  @@index([runId])
  @@index([status])
  @@map("workflow_human_steps")
}

/// A named, team-owned workflow template. Versions are immutable; "edit" creates
/// a new WorkflowTemplateVersion. Exactly one version may be marked active per
/// template (enforced in application code).
model WorkflowTemplate {
  id                String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId            String?                   @map("team_id") @db.Uuid
  team              Team?                     @relation(fields: [teamId], references: [id], onDelete: SetNull)
  name              String
  description       String                    @default("")
  status            WorkflowTemplateStatus    @default(DRAFT)
  isDefault         Boolean                   @default(false) @map("is_default")
  activeVersion     Int?                      @map("active_version")
  /// A/B experiment: percent of incoming work requests routed to `experimentVersion`
  /// instead of `activeVersion`. 0 or NULL disables the experiment.
  experimentVersion Int?                      @map("experiment_version")
  experimentSplit   Int?                      @map("experiment_split")
  createdAt         DateTime                  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  versions              WorkflowTemplateVersion[]
  workflowRuns          WorkflowRun[]
  modelRoleConfigs      ModelRoleConfig[]
  agentSkillAssignments AgentSkillAssignment[]

  @@unique([teamId, name])
  @@map("workflow_templates")
}

/// Immutable snapshot of a template at version N. `spec` is validated against
/// WorkflowSpecSchema on insert in the gateway.
model WorkflowTemplateVersion {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  templateId   String           @map("template_id") @db.Uuid
  template     WorkflowTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  version      Int
  spec         Json
  createdBy    String?          @map("created_by") @db.Uuid
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz

  shellAudits  WorkflowShellAudit[]

  @@unique([templateId, version])
  @@map("workflow_template_versions")
}

/// Per-role model spec (`<provider>/<model-id>`) at one of three scopes:
/// GLOBAL (system-wide default), TEAM (overrides global for one team), or
/// WORKFLOW_TEMPLATE (overrides team+global for one template). Resolution
/// cascade is template → team → global; the first match wins. At most one
/// row per (role, scope, scope-key) — enforced by partial unique indexes
/// defined in raw SQL alongside this migration since Prisma's DSL can't
/// express WHERE clauses on unique indexes.
///
/// `credentialId` is an optional override that points at a specific
/// `ProviderCredential` row. When null the resolver looks up the credential
/// by provider name using the same scope cascade. Typically set only at
/// WORKFLOW_TEMPLATE scope to pin a template to a specific credential set.
model ModelRoleConfig {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  role               AgentRole
  scope              ConfigScope
  teamId             String?             @map("team_id") @db.Uuid
  team               Team?               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  workflowTemplateId String?             @map("workflow_template_id") @db.Uuid
  workflowTemplate   WorkflowTemplate?   @relation(fields: [workflowTemplateId], references: [id], onDelete: Cascade)
  modelSpec          String              @map("model_spec")
  systemPrompt       String?             @map("system_prompt")
  credentialId      String?              @map("credential_id") @db.Uuid
  credential        ProviderCredential?  @relation(fields: [credentialId], references: [id], onDelete: SetNull)
  createdById       String?              @map("created_by_id") @db.Uuid
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([scope, teamId])
  @@index([scope, workflowTemplateId])
  @@map("model_role_configs")
}

/// Encrypted API credential for one LLM provider, scoped GLOBAL or TEAM.
/// (WORKFLOW_TEMPLATE scope is intentionally unsupported — templates can
/// reference existing credentials via `ModelRoleConfig.credentialId` but
/// can't create their own.) API key bytes are AES-256-GCM encrypted with
/// the key from `CONFIG_ENCRYPTION_KEY`; see `packages/shared/src/lib/crypto.ts`.
/// `lastFour` is the trailing four plaintext chars, stored for UI display
/// only. `keyVersion` exists for future key-rotation support.
model ProviderCredential {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider        String
  scope           ConfigScope
  teamId          String?           @map("team_id") @db.Uuid
  team            Team?             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  apiBase         String?           @map("api_base")
  apiKeyCiphertext Bytes            @map("api_key_ciphertext")
  apiKeyNonce     Bytes             @map("api_key_nonce")
  apiKeyAuthTag   Bytes             @map("api_key_auth_tag")
  keyVersion      Int               @default(1) @map("key_version")
  lastFour        String            @map("last_four")
  createdById     String?           @map("created_by_id") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  modelRoleConfigs ModelRoleConfig[]
  embeddingConfigs EmbeddingConfig[]

  @@index([provider, scope, teamId])
  @@map("provider_credentials")
}

/// System-wide embedding-model selection. Singleton — exactly one row is
/// permitted (enforced by a CHECK constraint on the `id` column in the
/// migration alongside this model). The semantic-memory pipeline reads this
/// row at every `generateEmbedding` call; mutations go through
/// `/api/v1/admin/embedding-config`.
///
/// `credentialId` pins a specific ProviderCredential when set, otherwise the
/// resolver looks up the credential by the provider parsed from `modelSpec`.
/// pgvector storage is fixed at vector(1536), so the chosen model MUST
/// produce 1536-dim embeddings (worker throws if it doesn't).
model EmbeddingConfig {
  id           String              @id @default("default")
  modelSpec    String              @map("model_spec")
  credentialId String?             @map("credential_id") @db.Uuid
  credential   ProviderCredential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)
  updatedById  String?             @map("updated_by_id") @db.Uuid
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("embedding_configs")
}

/// Singleton GitHub integration config. One row (id = "default").
/// Encrypted fields follow the same AES-256-GCM envelope used by
/// ProviderCredential (ciphertext + nonce + authTag per secret).
/// oauthClientId / oauthClientSecret enable GitHub social sign-in via
/// BetterAuth; changes require a gateway restart to take effect.
model GitHubConfig {
  id String @id @default("default")

  /// PAT used for cloning repos and creating PRs (required to start worker)
  tokenCiphertext Bytes?  @map("token_ciphertext")
  tokenNonce      Bytes?  @map("token_nonce")
  tokenAuthTag    Bytes?  @map("token_auth_tag")
  tokenKeyVersion Int?    @map("token_key_version")
  tokenLastFour   String? @map("token_last_four")

  /// HMAC secret for validating inbound GitHub webhook payloads
  webhookSecretCiphertext Bytes?  @map("webhook_secret_ciphertext")
  webhookSecretNonce      Bytes?  @map("webhook_secret_nonce")
  webhookSecretAuthTag    Bytes?  @map("webhook_secret_auth_tag")
  webhookSecretKeyVersion Int?    @map("webhook_secret_key_version")
  webhookSecretLastFour   String? @map("webhook_secret_last_four")

  /// GitHub OAuth app credentials for browser social sign-in (BetterAuth)
  oauthClientId String? @map("oauth_client_id")

  oauthClientSecretCiphertext Bytes?  @map("oauth_client_secret_ciphertext")
  oauthClientSecretNonce      Bytes?  @map("oauth_client_secret_nonce")
  oauthClientSecretAuthTag    Bytes?  @map("oauth_client_secret_auth_tag")
  oauthClientSecretKeyVersion Int?    @map("oauth_client_secret_key_version")
  oauthClientSecretLastFour   String? @map("oauth_client_secret_last_four")

  /// Base URL for git clone operations; null → https://github.com
  baseUrl String? @map("base_url")
  /// Octokit REST API base URL; null → https://api.github.com (for GHE)
  apiUrl  String? @map("api_url")

  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("github_config")
}

/// Singleton Slack integration config. One row (id = "default").
/// Requires a gateway restart only for clientId / clientSecret (used by the
/// OAuth flow at server init). botToken and signingSecret are resolved
/// fresh per request/activity.
model SlackConfig {
  id String @id @default("default")

  clientId String? @map("client_id")

  clientSecretCiphertext Bytes?  @map("client_secret_ciphertext")
  clientSecretNonce      Bytes?  @map("client_secret_nonce")
  clientSecretAuthTag    Bytes?  @map("client_secret_auth_tag")
  clientSecretKeyVersion Int?    @map("client_secret_key_version")
  clientSecretLastFour   String? @map("client_secret_last_four")

  signingSecretCiphertext Bytes?  @map("signing_secret_ciphertext")
  signingSecretNonce      Bytes?  @map("signing_secret_nonce")
  signingSecretAuthTag    Bytes?  @map("signing_secret_auth_tag")
  signingSecretKeyVersion Int?    @map("signing_secret_key_version")
  signingSecretLastFour   String? @map("signing_secret_last_four")

  botTokenCiphertext Bytes?  @map("bot_token_ciphertext")
  botTokenNonce      Bytes?  @map("bot_token_nonce")
  botTokenAuthTag    Bytes?  @map("bot_token_auth_tag")
  botTokenKeyVersion Int?    @map("bot_token_key_version")
  botTokenLastFour   String? @map("bot_token_last_four")

  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("slack_config")
}

/// Singleton artifact storage config. One row (id = "default").
/// backend="inline" stores blobs in Postgres; backend="s3" uses any
/// S3-compatible endpoint (AWS S3, MinIO, R2). Changes take effect on the
/// next worker activity call — no restart required.
model StorageConfig {
  id      String @id @default("default")
  backend String @default("inline") // "inline" | "s3"

  s3Bucket         String?  @map("s3_bucket")
  s3Region         String?  @map("s3_region")
  s3Endpoint       String?  @map("s3_endpoint")
  s3Prefix         String?  @map("s3_prefix")
  s3ForcePathStyle Boolean  @default(false) @map("s3_force_path_style")

  awsAccessKeyId String? @map("aws_access_key_id")

  awsSecretAccessKeyCiphertext Bytes?  @map("aws_secret_access_key_ciphertext")
  awsSecretAccessKeyNonce      Bytes?  @map("aws_secret_access_key_nonce")
  awsSecretAccessKeyAuthTag    Bytes?  @map("aws_secret_access_key_auth_tag")
  awsSecretAccessKeyKeyVersion Int?    @map("aws_secret_access_key_key_version")
  awsSecretAccessKeyLastFour   String? @map("aws_secret_access_key_last_four")

  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("storage_config")
}

/// Singleton workflow behaviour defaults. One row (id = "default").
/// All fields have fallback values so the row is optional — the worker
/// falls back to the baked-in defaults when no row exists.
model WorkflowDefaults {
  id String @id @default("default")

  branchPrefix    String @default("auto") @map("branch_prefix")
  prTitleTemplate String @default("[auto-swe] {{ticketId}}") @map("pr_title_template")
  prBodyTemplate  String @default("") @map("pr_body_template")
  defaultTeamSlug String @default("default") @map("default_team_slug")

  // Lesson consolidation schedule. The gateway reads these on startup and on
  // every admin save, then syncs the Temporal Schedule accordingly.
  consolidationEnabled          Boolean @default(true) @map("consolidation_enabled")
  consolidationCron             String  @default("0 3 * * 0") @map("consolidation_cron")
  consolidationMinClusterSize   Int     @default(3) @map("consolidation_min_cluster_size")
  consolidationSimilarityThreshold Float @default(0.85) @map("consolidation_similarity_threshold")

  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("workflow_defaults")
}

/// Singleton Google OAuth config for BetterAuth social sign-in.
/// Changes require a gateway restart to take effect.
model GoogleOAuthConfig {
  id       String  @id @default("default")
  clientId String? @map("client_id")

  clientSecretCiphertext Bytes?  @map("client_secret_ciphertext")
  clientSecretNonce      Bytes?  @map("client_secret_nonce")
  clientSecretAuthTag    Bytes?  @map("client_secret_auth_tag")
  clientSecretKeyVersion Int?    @map("client_secret_key_version")
  clientSecretLastFour   String? @map("client_secret_last_four")

  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("google_oauth_config")
}

/// Audit trail for changes to ModelRoleConfig and ProviderCredential.
/// Secret material is redacted in beforeJson/afterJson (only `lastFour` is
/// recorded). Written from the gateway routes that mutate these rows.
model ConfigAuditLog {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityType  String            @map("entity_type")
  entityId    String            @map("entity_id") @db.Uuid
  action      ConfigAuditAction
  actorId     String?           @map("actor_id") @db.Uuid
  beforeJson  Json?             @map("before_json")
  afterJson   Json?             @map("after_json")
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz

  @@index([entityType, entityId])
  @@index([actorId])
  @@map("config_audit_log")
}

/// A reusable agent capability: either a named tool reference or a prompt
/// fragment injected after the base system prompt. Skills are assigned to
/// agent roles at GLOBAL / TEAM / WORKFLOW_TEMPLATE scope via
/// AgentSkillAssignment rows (same cascade model as ModelRoleConfig).
/// Built-in skills (isBuiltIn=true) map to the four hardcoded workspace
/// tools; they cannot be deleted through the API.
model Skill {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  description String?
  type        SkillType
  /// TOOL: one of "readFile" | "writeFile" | "listDirectory" | "bash"
  toolKey     String?   @map("tool_key")
  /// PROMPT_FRAGMENT: text injected after the base system prompt
  promptText  String?   @map("prompt_text")
  isBuiltIn   Boolean   @default(false) @map("is_built_in")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  assignments AgentSkillAssignment[]

  @@map("skills")
}

/// Assigns a Skill to an AgentRole at a specific scope. Partial unique indexes
/// (defined in raw SQL in the migration) enforce one assignment per
/// (role, skill, scope-key). Resolution cascade mirrors ModelRoleConfig:
/// WORKFLOW_TEMPLATE → TEAM → GLOBAL. The first scope that has any
/// assignments for the role wins.
model AgentSkillAssignment {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agentRole          AgentRole         @map("agent_role")
  skillId            String            @map("skill_id") @db.Uuid
  scope              ConfigScope
  teamId             String?           @map("team_id") @db.Uuid
  workflowTemplateId String?           @map("workflow_template_id") @db.Uuid
  sortOrder          Int               @default(0) @map("sort_order")
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz

  skill              Skill             @relation(fields: [skillId], references: [id], onDelete: Cascade)
  team               Team?             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  workflowTemplate   WorkflowTemplate? @relation(fields: [workflowTemplateId], references: [id], onDelete: Cascade)

  @@index([agentRole, scope, teamId])
  @@index([agentRole, scope, workflowTemplateId])
  @@map("agent_skill_assignments")
}

/// Phase-6 audit log: one row per shell node authored in a saved template
/// version. Lets a team admin reconstruct who introduced what command in which
/// version, and supports the editor's "danger zone" diff preview.
model WorkflowShellAudit {
  id                String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  templateVersionId String                  @map("template_version_id") @db.Uuid
  templateVersion   WorkflowTemplateVersion @relation(fields: [templateVersionId], references: [id], onDelete: Cascade)
  teamId            String?                 @map("team_id") @db.Uuid
  team              Team?                   @relation(fields: [teamId], references: [id], onDelete: SetNull)
  nodeId            String                  @map("node_id")
  image             String
  command           String
  network           String                  @default("none")
  egressAllowlistSnapshot  String[]  @default([]) @map("egress_allowlist_snapshot")
  authorUserId      String?                 @map("author_user_id") @db.Uuid
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamptz

  @@index([templateVersionId])
  @@index([teamId])
  @@map("workflow_shell_audit")
}
