  enabled Boolean @default(false)

  // AES-256-GCM encrypted Figma personal access / REST token
  apiTokenCiphertext Bytes?  @map("api_token_ciphertext")
  apiTokenNonce      Bytes?  @map("api_token_nonce")
  apiTokenAuthTag    Bytes?  @map("api_token_auth_tag")
  apiTokenKeyVersion Int?    @map("api_token_key_version")
