generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

enum Role {
  ADMIN
  LEAD
  ENGINEER
}

/// A source-control host's answer about one user's access to one repository.
/// Mirrors GitHub's collaborator permission levels, weakest first.
enum RepoPermissionLevel {
  NONE
  READ
  WRITE
  ADMIN
}

enum OrgRole {
  ORG_ADMIN
  ORG_MEMBER
}

enum ReportDigestScope {
  ORGANIZATION
  TEAM
}

enum WorkflowRunStatus {
  RUNNING
  SUCCESS
  FAILED
  TIMED_OUT
  SKIPPED
  CANCELLED
}

enum WorkflowStepStatus {
  PENDING
  RUNNING
  PASSED
  FAILED
  SKIPPED
}

enum WorkflowTemplateStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum KnowledgeType {
  LEARNING
  REFERENCE
  DECISION
  POLICY
}

enum KnowledgeStatus {
  UNREVIEWED
  APPROVED
  REJECTED
  SUPERSEDED
}

enum KnowledgeVisibility {
  REPOSITORY
  TEAM
  SELECTED_TEAMS
  ORGANIZATION
}

enum ConfigScope {
  GLOBAL
  ORGANIZATION
  TEAM
  // Slack-channel scope (channel assistant): a SlackChannel-resident assistant can
  // override agent/skill/tool config more specifically than its owning team.
  // Inserted between WORKFLOW_TEMPLATE and TEAM in the resolver cascade.
  CHANNEL
  WORKFLOW_TEMPLATE
}

// NOTE: agent identity is a free-form string (camelCase, e.g. 'implementer',
// 'securityReviewer'), not a DB enum. The platform pivot (P0) removed the
// `AgentRole` enum so new agents can be added as data without a migration.
// Canonical values are the worker's `AnySkillRole` union; the seed writes them.

enum ConfigAuditAction {
  CREATE
  UPDATE
  DELETE
}

enum HumanStepKind {
  APPROVAL
  DECISION
  INPUT
  REVIEW
}

enum HumanStepStatus {
  PENDING
  RESOLVED
  TIMED_OUT
  CANCELLED
}

enum EvalScoreType {
  BOOLEAN
  NUMERIC
  CATEGORICAL
}

enum EvalSignalSource {
  GATE
  ASSERT
  REVIEW
  MERGE
  JUDGE
  TRAJECTORY
  POLICY
  PII
  HUMAN_AUDIT
}

model ActiveWorkflow {
  id                 String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  temporalWorkflowId String      @unique @map("temporal_workflow_id")
  parentWorkflowId   String?     @map("parent_workflow_id")
  workRequestId      String?     @map("work_request_id") @db.Uuid
  workRequest        RunInput?   @relation(fields: [workRequestId], references: [id])
  repoId             String?     @map("repo_id") @db.Uuid
  repository         Connection? @relation(fields: [repoId], references: [id])
  /// Child-run launch identity; scalar values survive nullable relation deletion.
  knowledgeSourceKind WorkflowRunKnowledgeSourceKind? @map("knowledge_source_kind")
  knowledgeSourceRepoId String? @map("knowledge_source_repo_id") @db.Uuid
  knowledgeSourceTeamId String? @map("knowledge_source_team_id") @db.Uuid
  knowledgeSourceOrgId String? @map("knowledge_source_org_id") @db.Uuid
  currentStatus      String      @map("current_status")
  assignedBranch     String?     @map("assigned_branch")
  budgetTier         String      @default("STANDARD") @map("budget_tier")
  /// BigInt: a long-lived ActiveWorkflow row's cumulative token usage can
  /// exceed the INT32 ceiling.
  tokensInputUsed    BigInt      @default(0) @map("tokens_input_used")
  tokensOutputUsed   BigInt      @default(0) @map("tokens_output_used")
  /// The input a run's cap counts: each call in dollar-equivalent tokens (cache
  /// reads and writes at the model's own cache multipliers), fixed when the call is
  /// recorded. `tokensInputUsed` stays the raw total every dashboard and rollup reads.
  tokensInputCountedUsed BigInt @default(0) @map("tokens_input_counted_used")
  costUsdAccrued     Float       @default(0) @map("cost_usd_accrued")
  updatedAt          DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  pullRequests PullRequest[]
  memoryItems  MemoryItem[]

  @@index([workRequestId])
  @@index([repoId, assignedBranch])
  @@map("active_workflows")
}

// HNSW index on `embedding` is defined in raw SQL inside
// migrations/20260618000001_custom_constraints_and_indexes/migration.sql.
// Prisma's schema DSL cannot model pgvector index types, so `prisma migrate dev`
// will report drift here. Use `yarn db:migrate` (= migrate deploy) for routine
// application; run `yarn db:migrate:dev` only when authoring a new migration.
/// Generic semantic-memory item (P3). Replaces the SWE-specific `AgentLesson`.
/// `scope` is the generic partition key — SWE lessons use `'swe-lessons'`; other
/// domains pick their own scope and stay isolated. The SWE-specific columns
/// (repoId/workflowId FK, rationale, failureType, skillsActive) are retained for
/// the SWE memory flow and migrate further in later P3 slices (repoId →
/// Connection); `metadata` is the generic tags bag.
model MemoryItem {
  id             String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scope          String                       @default("swe-lessons")
  workflowId     String?                      @map("workflow_id") @db.Uuid
  workflow       ActiveWorkflow?              @relation(fields: [workflowId], references: [id])
  repoId         String?                      @map("repo_id") @db.Uuid
  repository     Connection?                  @relation(fields: [repoId], references: [id])
  /// Channel assistant scoping. A lesson learned in a Slack channel is scoped to that
  /// channel; `teamId`/`orgId` are denormalized so retrieval can widen to
  /// team- or workspace-level "team memory" without a Connection join. All
  /// null on SWE-repo lessons (which scope via `repoId`).
  channelId      String?                      @map("channel_id") @db.Uuid
  channel        SlackChannel?                @relation(fields: [channelId], references: [id], onDelete: SetNull)
  teamId         String?                      @map("team_id") @db.Uuid
  team           Team?                        @relation("TeamMemoryItems", fields: [teamId], references: [id], onDelete: Cascade)
  orgId          String?                      @map("org_id") @db.Uuid
  org            Organization?                @relation("OrgMemoryItems", fields: [orgId], references: [id], onDelete: Cascade)
  /// WorkflowRun that produced this lesson. Null on rows written before this
  /// column existed. Enables lineage queries: "which run created this lesson?"
  workflowRunId  String?                      @map("workflow_run_id") @db.Uuid
  workflowRun    WorkflowRun?                 @relation(fields: [workflowRunId], references: [id])
  /// Agent key that produced this lesson (e.g. "commitToMemory").
  agentKey       String?                      @map("agent_key")
  /// `<provider>/<model>` spec the LLM summarizer used. Null on pre-tracking rows.
  model          String?
  /// USD cost of the LLM call that produced this lesson. Null on pre-tracking rows.
  costUsd        Float?                       @map("cost_usd")
  rationale      String
  lessonSummary  String                       @map("lesson_summary")
  embedding      Unsupported("vector(1536)")?
  /// `<provider>/<model>` spec the embedding was generated with. Null on rows
  /// written before tracking existed — those are assumed to share the space
  /// of whatever model was configured at the time (single-model deployments).
  embeddingModel String?                      @map("embedding_model")
  failureType    String?                      @map("failure_type")
  /// Generic entity scoping (P3). `entityType` names the kind of object this
  /// memory is about (e.g. 'connection', 'channel', 'document', 'project');
  /// `entityId` is its id in the same namespace. Replaces repo-centric-only
  /// retrieval while the legacy `repoId`/`channelId` columns remain populated
  /// for backwards compatibility with existing callers.
  entityType     String?                      @map("entity_type")
  entityId       String?                      @map("entity_id")
  metadata       Json?
  skillsActive   String[]                     @default([]) @map("skills_active")
  createdAt      DateTime                     @default(now()) @map("created_at") @db.Timestamptz
  // Soft-delete: set when this item has been merged into a consolidated one.
  // Active items always have consolidatedAt = null.
  consolidatedAt DateTime?                    @map("consolidated_at") @db.Timestamptz
  /// The newer item that replaced this one: a later lesson about the same thing
  /// in the same scope. A superseded item is kept, like a consolidated one, but
  /// never recalled or consolidated again. `supersededAt` is when it happened.
  supersededById String?                      @map("superseded_by_id") @db.Uuid
  supersededBy   MemoryItem?                  @relation("MemorySupersession", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes     MemoryItem[]                 @relation("MemorySupersession")
  supersededAt   DateTime?                    @map("superseded_at") @db.Timestamptz
  /// How directly the writer's evidence supports the lesson, 0–1. Set by the
  /// lesson writer from its own rubric; null where no model judged it (the
  /// model-free writers, rows written before the column existed).
  confidence     Float?
  /// People who think this lesson is wrong (repository lessons only; see `LessonFlag`).
  flags          LessonFlag[]

  @@index([repoId, consolidatedAt])
  @@index([supersededById])
  @@index([scope, consolidatedAt])
  @@index([channelId, consolidatedAt])
  @@index([teamId, consolidatedAt])
  @@index([orgId, consolidatedAt])
  @@index([entityType, entityId, consolidatedAt])
  @@index([workflowId])
  @@index([workflowRunId])
  @@map("memory_items")
}

/// One person's report that a repository lesson is wrong, with their reason.
///
/// Raised by anyone who can read the lesson, one per person per lesson (flagging again replaces the
/// reason). Read and cleared by whoever may delete the lesson: a lead of the repository's owning
/// team, or a platform ADMIN. A flag changes nothing about recall; it is a queue for those people,
/// who then delete the lesson or clear its flags. Deleting the lesson deletes its flags.
model LessonFlag {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  memoryItemId String     @map("memory_item_id") @db.Uuid
  memoryItem   MemoryItem @relation(fields: [memoryItemId], references: [id], onDelete: Cascade)
  flaggedById  String     @map("flagged_by_id") @db.Uuid
  flaggedBy    User       @relation("LessonFlagAuthor", fields: [flaggedById], references: [id], onDelete: Cascade)
  reason       String
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz

  @@unique([memoryItemId, flaggedById])
  @@index([flaggedById])
  @@map("lesson_flags")
}

model ContextSnapshot {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workRequestId    String   @unique @map("work_request_id") @db.Uuid
  workRequest      RunInput @relation(fields: [workRequestId], references: [id], onDelete: Cascade)
  rawTicketData    Json?    @map("raw_ticket_data")
  rawDocumentation Json?    @map("raw_documentation")
  // Compact Figma design summary (FigmaDesignSummary), seeded at submit time
  // when the ticket references a Figma file/node. Best-effort; null otherwise.
  rawDesign        Json?    @map("raw_design")
  successCriteria  String[] @map("success_criteria")
  capturedAt       DateTime @default(now()) @map("captured_at") @db.Timestamptz

  @@map("context_snapshots")
}

// A partial unique index on (repoId, prNumber) WHERE prNumber IS NOT NULL lives
// in raw SQL in migrations/20260618000001_custom_constraints_and_indexes/migration.sql
// — Prisma's schema DSL can't express a partial `@@unique`, so it isn't
// modeled here (same pattern as the 0001 `connections_git_repo_org_repo_uidx`).
model PullRequest {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workflowId String?         @map("workflow_id") @db.Uuid
  workflow   ActiveWorkflow? @relation(fields: [workflowId], references: [id])
  templateId String?         @map("template_id") @db.Uuid
  template   WorkflowTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  templateVersion Int?       @map("template_version")
  runId      String?         @map("run_id") @db.Uuid
  run        WorkflowRun?    @relation("PullRequestAttributionRun", fields: [runId], references: [id], onDelete: SetNull)
  repoId     String?         @map("repo_id") @db.Uuid
  repository Connection?     @relation(fields: [repoId], references: [id])
  prNumber   Int?            @map("pr_number")
  headSha    String          @map("head_sha")
  /// OPEN | MERGED | CLOSED (closed unmerged); see `PULL_REQUEST_STATES`.
  status     String
  ciStatus   String          @default("PENDING") @map("ci_status")
  /// The title the PR carried when opened, refreshed by `edited` webhooks. Host
  /// text, untrusted: capped on write and rendered as plain text.
  title      String?
  isDraft    Boolean         @default(false) @map("is_draft")
  openedAt   DateTime        @default(now()) @map("opened_at") @db.Timestamptz
  mergedAt   DateTime?       @map("merged_at") @db.Timestamptz
  closedAt   DateTime?       @map("closed_at") @db.Timestamptz
  updatedAt  DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([workflowId])
  @@index([repoId])
  @@index([templateId, openedAt])
  // The pull-request list filters by state and pages newest-first.
  @@index([status, openedAt])
  @@index([openedAt])
  @@index([mergedAt, runId])
  @@index([closedAt, runId])
  @@index([updatedAt, runId])
  @@map("pull_requests")
}

/// One risk evaluation of a platform-opened pull request at a head commit. The class
/// comes from deterministic rules only; `badMerge` marks a merged LOW change that was
/// later reverted, and feeds the auto-mode evidence gate.
model PrEvaluation {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  connectionId      String     @map("connection_id") @db.Uuid
  connection        Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  prNumber          Int        @map("pr_number")
  headSha           String     @map("head_sha")
  baseBranch        String     @map("base_branch")
  /// LOW | STANDARD | HIGH (CHECK `pr_evaluations_risk_class_check`).
  riskClass         String     @map("risk_class")
  requiredApprovers Int        @map("required_approvers")
  /// off | advisory | enforce | auto, the effective mode when evaluated (CHECK `pr_evaluations_mode_check`).
  mode              String
  reasons           Json
  brief             Json
  readiness         Json?
  statusState       String     @map("status_state")
  autoMergeEnabled  Boolean    @default(false) @map("auto_merge_enabled")
  triggeredBy       String     @map("triggered_by")
  mergedAt          DateTime?  @map("merged_at") @db.Timestamptz
  closedAt          DateTime?  @map("closed_at") @db.Timestamptz
  badMerge          Boolean    @default(false) @map("bad_merge")
  badMergeReason    String?    @map("bad_merge_reason")
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz

  @@index([connectionId, prNumber])
  @@index([riskClass, mergedAt])
  @@map("pr_evaluations")
}

/// Long-lived API token for CI / CLI use. Exactly one owner (the hand-written
/// CHECK `api_tokens_exactly_one_owner`): a user — a personal access token
/// (Settings → API tokens) — or a team's service principal. The plaintext token
/// is returned exactly once on create (`ats_<random>` format); only the sha-256
/// hash is stored. `lastUsedAt` is updated best-effort on each successful auth
/// so admins can prune stale tokens.
model ApiToken {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String?           @map("user_id") @db.Uuid
  user               User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  servicePrincipalId String?           @map("service_principal_id") @db.Uuid
  servicePrincipal   ServicePrincipal? @relation(fields: [servicePrincipalId], references: [id], onDelete: Cascade)
  /// What a service token may do (`SERVICE_TOKEN_SCOPES`). Empty, and ignored,
  /// on a user's token, which acts with its user's role instead.
  scopes             String[]          @default([])
  name               String
  tokenHash          String            @unique @map("token_hash")
  /// The first 12 chars of the plaintext token (`ats_` + 8 random chars).
  /// Non-secret — exists so the admin UI can disambiguate listed tokens
  /// without re-issuing them.
  prefix             String
  expiresAt          DateTime?         @map("expires_at") @db.Timestamptz
  lastUsedAt         DateTime?         @map("last_used_at") @db.Timestamptz
  revokedAt          DateTime?         @map("revoked_at") @db.Timestamptz
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId])
  @@index([servicePrincipalId])
  @@map("api_tokens")
}

/// A team-owned machine identity: another service that starts and follows runs
/// without acting as a person. It authenticates with `ApiToken` rows of its own
/// and may launch only what its allowlists name — an empty list allows nothing.
/// Its runs use the platform credential.
model ServicePrincipal {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId        String     @map("team_id") @db.Uuid
  team          Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  createdById   String?    @map("created_by_id") @db.Uuid
  createdBy     User?      @relation("ServicePrincipalCreator", fields: [createdById], references: [id], onDelete: SetNull)
  /// Set while disabled: every token of a disabled principal is refused.
  disabledAt    DateTime?  @map("disabled_at") @db.Timestamptz
  /// Runs it may start in any 24 hours.
  maxRunsPerDay Int        @default(50) @map("max_runs_per_day")
  /// Runs of its own that may be in flight at once.
  maxInFlight   Int        @default(5) @map("max_in_flight")
  /// Connections it may launch on. Adding one is a launch decision of the lead who adds it.
  connectionIds String[]   @default([]) @map("connection_ids") @db.Uuid
  /// Workflow templates it may run through `POST /workflow-templates/:id/runs`.
  templateIds   String[]   @default([]) @map("template_ids") @db.Uuid
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  tokens      ApiToken[]
  runRequests RunInput[] @relation("RunInputServiceRequester")

  @@unique([teamId, name])
  @@index([createdById])
  @@map("service_principals")
}

/// Generic integration target (P3). Replaces the SWE-specific `Repository`.
/// `type` is the discriminator — SWE git repos use `'git_repo'`; other domains
/// define their own connection types (e.g. `'http_api'`, `'database'`) and stash
/// type-specific settings in the generic `config` bag. The engine treats `type`
/// and `config` as opaque; only type-specific worker code reads them. The SWE
/// `git_repo` specifics (GitHub coords, default branch, gate commands) stay as
/// typed columns for parity and migrate further in later slices.
model Connection {
  id                   String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Connection-type discriminator. Defaults to SWE's `'git_repo'`.
  type                 String              @default("git_repo")
  /// Generic typed config for non-`git_repo` types. SWE `git_repo` connections
  /// keep their specifics in the typed columns below; other types use this bag.
  config               Json?
  /// Human label for non-`git_repo` connections (e.g. an `mcp` server name).
  /// git_repo connections identify by org/repo below and may leave this null.
  name                 String?
  /// git_repo identity — nullable so non-git connection types (e.g. `mcp`) need
  /// not supply them. Uniqueness is enforced by a partial unique index
  /// (`WHERE type = 'git_repo'`) in the custom-constraints migration.
  organizationName     String?             @map("organization_name")
  repoName             String?             @map("repo_name")
  defaultBranch        String              @default("main") @map("default_branch")
  language             String?             @map("language")
  description          String?             @map("description")
  githubUrl            String?             @map("github_url")
  githubApiUrl         String?             @map("github_api_url")
  teamId               String              @map("team_id") @db.Uuid
  team                 Team                @relation(fields: [teamId], references: [id], onDelete: Restrict)
  /// Which GitHub App installation reaches this repository. Null means "the
  /// singleton `GitHubConfig.appInstallationId`", which is what every row meant
  /// before more than one installation was expressible — so an existing
  /// single-org deployment keeps working with every row null.
  ///
  /// `Restrict` rather than `SetNull`: silently reverting a repository to the
  /// default installation would send its clone and permission lookups to a
  /// different GitHub account, and a permission answer from the wrong account
  /// is worse than an error.
  installationId       String?             @map("installation_id") @db.Uuid
  installation         GitHubInstallation? @relation(fields: [installationId], references: [id], onDelete: Restrict)
  /// Per-connection base image override. NULL means "inherit", and it must stay
  /// NULL-able with NO column default: a default writes a literal into every row
  /// the create path omits, which makes it indistinguishable from a deliberate
  /// pin and silently shadows the `workspaceImage` Tier-2 default the worker
  /// resolves at /admin/workflow.
  executorImage        String?             @map("executor_image")
  /// How the executor image was built, for the scheduled rebuild workflow:
  /// { stack: 'node'|'python'|'jvm'|'go', useRepoDockerfile: boolean }.
  executorImageBuild   Json?               @map("executor_image_build")
  /// Per-repository PR evaluation mode: 'off' | 'advisory' | 'enforce' | 'auto'. NULL means
  /// "inherit `prEvaluation.defaultMode`", and it must stay NULL-able with NO column
  /// default: a default writes a literal into every row and shadows the registry value.
  prEvaluationMode     String?             @map("pr_evaluation_mode")
  isActive             Boolean             @default(true) @map("is_active")
  consolidationEnabled Boolean             @default(true) @map("consolidation_enabled")
  /// Optional per-connection overrides for phase-2 quality-gate commands. Shape:
  /// { runLint?: string; runTypecheck?: string; runTests?: string; ... }
  /// Resolution order: step config → this field → built-in defaults.
  gateCommands         Json?               @map("gate_commands")

  /// The stack the scheduled dependency scan detected from the repository's
  /// root files, as `DetectedStack` (stacks, primary, suggestedGateCommands,
  /// suggestedDockerfile, evidence). A suggestion shown in settings — never
  /// applied to gate commands or executorImage on its own. Null until a scan ran.
  detectedStack        Json?               @map("detected_stack")
  detectedStackAt      DateTime?           @map("detected_stack_at") @db.Timestamptz

  /// Declared package name(s) this git_repo publishes (e.g. `@acme/payments-sdk`,
  /// `github.com/acme/payments-sdk`). The resolution key manifest detection matches
  /// a dependency string against (P1). Null/empty = match on org/repo identity only.
  packageNames String[] @default([]) @map("package_names")

  /// Encrypted API token for token-based connection types (Notion, Zendesk,
  /// HubSpot, http_api). Stored as AES-256-GCM ciphertext with nonce and auth tag.
  apiKeyCiphertext Bytes? @map("api_key_ciphertext")
  apiKeyNonce      Bytes? @map("api_key_nonce")
  apiKeyAuthTag    Bytes? @map("api_key_auth_tag")
  apiKeyVersion    Int    @default(1) @map("api_key_version")

  /// `mcp` connections only: custom request headers as one AES-256-GCM envelope over a JSON list
  /// of `{ name, value }`. Write-only through the API; sent only to the connection's own origin.
  headersCiphertext Bytes? @map("headers_ciphertext")
  headersNonce      Bytes? @map("headers_nonce")
  headersAuthTag    Bytes? @map("headers_auth_tag")
  headersKeyVersion Int    @default(1) @map("headers_key_version")

  /// Added late: this model was one of the few without them, and the gap has
  /// already cost something. Without `updatedAt` there is no way to tell a
  /// column value an operator chose from one a column default wrote, which
  /// makes any "clear the rows nobody set" question undecidable — as it was for
  /// `executorImage` below.
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  activeWorkflows       ActiveWorkflow[]
  pullRequests          PullRequest[]
  memoryItems           MemoryItem[]
  runInputs             RunInput[]
  scheduledWorkRequests ScheduledWorkRequest[]
  workflowRuns          WorkflowRun[]
  mcpAgents             Agent[]                @relation("AgentMcpConnection")
  /// Repo dependency graph edges (repo-dependency-graph feature). `dependenciesFrom`
  /// are edges where this repo is the dependent; `dependenciesTo` where it is depended upon.
  dependenciesFrom      RepoDependency[]       @relation("RepoDependencyFrom")
  dependenciesTo        RepoDependency[]       @relation("RepoDependencyTo")
  /// Cached host permission answers for this repository (see `RepoAccess`).
  repoAccess            RepoAccess[]
  /// Per-user GitHub tokens for this repository (see `ConnectionCredential`).
  credentials           ConnectionCredential[]
  /// Further teams whose members may see and launch on this repository. The
  /// owning team (`teamId`) keeps management, budgets and settings.
  shares                ConnectionTeamShare[]
  automations           Automation[]
  /// Team automations whose runs act on this repository (`Automation.targetConnectionId`).
  targetedByAutomations Automation[]          @relation("AutomationTargetConnection")
  automationFires       AutomationFire[]
  knowledgeItems        KnowledgeItem[]
  prEvaluations         PrEvaluation[]

  @@index([teamId])
  @@index([installationId])
  @@map("connections")
}

/// Governed knowledge is separate from legacy MemoryItem retrieval. The vector
/// is populated by the runtime embedding stage; policy and projections do not
/// expose source evidence or the vector itself.
model KnowledgeItem {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerTeamId       String              @map("owner_team_id") @db.Uuid
  ownerTeam         Team                @relation("KnowledgeOwnerTeam", fields: [ownerTeamId], references: [id], onDelete: Cascade)
  orgId             String              @map("org_id") @db.Uuid
  organization      Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  originTeamId      String              @map("origin_team_id") @db.Uuid
  originTeam        Team                @relation("KnowledgeOriginTeam", fields: [originTeamId], references: [id], onDelete: Cascade)
  repoId            String?             @map("repo_id") @db.Uuid
  repository        Connection?         @relation(fields: [repoId], references: [id], onDelete: Cascade)
  type              KnowledgeType       @default(LEARNING)
  status            KnowledgeStatus     @default(UNREVIEWED)
  visibility        KnowledgeVisibility @default(REPOSITORY)
  title             String
  content           String
  tags              String[]            @default([])
  entityType        String?             @map("entity_type")
  entityId          String?             @map("entity_id")
  version           Int                 @default(1)
  approvedVersion   Int?                @map("approved_version")
  producerRunId     String?             @map("producer_run_id") @db.Uuid
  producerNodeId    String?             @map("producer_node_id")
  producerAgentKey  String?             @map("producer_agent_key")
  modelSpec         String?             @map("model_spec")
  idempotencyKey    String?             @map("idempotency_key")
  contentDigest     String              @map("content_digest")
  evidence          Json?
  embedding         Unsupported("vector(1536)")?
  embeddingModel    String?             @map("embedding_model")
  embeddingDigest   String?             @map("embedding_digest")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  approvedById      String?             @map("approved_by_id") @db.Uuid
  approvedBy        User?               @relation("KnowledgeItemApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt        DateTime?           @map("approved_at") @db.Timestamptz
  grants            KnowledgeItemTeamGrant[]
  events            KnowledgeItemEvent[]

  @@unique([producerRunId, producerNodeId, idempotencyKey])
  @@index([ownerTeamId, status, visibility])
  @@index([orgId, status, visibility])
  @@index([repoId, status])
  @@index([originTeamId])
  @@index([approvedById])
  @@map("knowledge_items")
}

model KnowledgeItemTeamGrant {
  knowledgeItemId String        @map("knowledge_item_id") @db.Uuid
  teamId          String        @map("team_id") @db.Uuid
  knowledgeItem   KnowledgeItem @relation(fields: [knowledgeItemId], references: [id], onDelete: Cascade)
  team            Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([knowledgeItemId, teamId])
  @@index([teamId])
  @@map("knowledge_item_team_grants")
}

model KnowledgeItemEvent {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  knowledgeItemId String        @map("knowledge_item_id") @db.Uuid
  knowledgeItem   KnowledgeItem @relation(fields: [knowledgeItemId], references: [id], onDelete: Cascade)
  actorId         String?       @map("actor_id") @db.Uuid
  actor           User?         @relation("KnowledgeEventActor", fields: [actorId], references: [id], onDelete: SetNull)
  action          String
  version         Int
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz

  @@index([knowledgeItemId, createdAt])
  @@map("knowledge_item_events")
}

/// What the source-control host last said about one user's access to one
/// repository.
///
/// **This is a cache, not a grant table.** Nothing here is authored: every row
/// is an answer GitHub gave, and the only writer is the sync. Editing a row by
/// hand grants access that GitHub does not back, until the next sweep silently
/// takes it away again. To change someone's access, change it on GitHub.
///
/// Rows exist only for (user, repository) pairs that team membership already
/// allows — the projection is the second of two conditions, never a way to
/// reach a repository whose team you do not belong to.
///
/// Not tenant-scoped in `tenantGuard`'s sense: it carries no `teamId`/`orgId`,
/// and every query against it is narrowed by `userId` or `connectionId`, which
/// are stronger.
model RepoAccess {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String     @map("user_id") @db.Uuid
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectionId String     @map("connection_id") @db.Uuid
  connection   Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  permission RepoPermissionLevel

  /// When the host last answered. A failed lookup does not update this — the
  /// row keeps saying what was last actually known, and grows stale rather than
  /// recording an outage as a denial.
  checkedAt DateTime @default(now()) @map("checked_at") @db.Timestamptz

  @@unique([userId, connectionId])
  @@index([connectionId])
  @@index([checkedAt])
  @@map("repo_access")
}

/// One further team a repository is shared with.
///
/// Members of a shared team reach the repository exactly as owning-team
/// members do for seeing it and launching runs on it — every membership test
/// accepts either. They do NOT manage it: editing, deleting, re-sharing,
/// schedules and dependency edges stay with the owning team, and runs keep the
/// owning team's budget, default template and settings. Shares are limited to
/// teams in the owning team's organization, so a repository never crosses a
/// tenant boundary this way.
model ConnectionTeamShare {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  connectionId String     @map("connection_id") @db.Uuid
  connection   Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  teamId       String     @map("team_id") @db.Uuid
  team         Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdById  String?    @map("created_by_id") @db.Uuid
  createdBy    User?      @relation("ConnectionShareCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz

  @@unique([connectionId, teamId])
  @@index([teamId])
  @@index([createdById])
  @@map("connection_team_shares")
}

/// One user's own GitHub token for one repository.
///
/// **Used only for that user's runs.** A run resolves the credential of the
/// user who launched it (`WorkflowRun.launchedById`); a run launched by anyone
/// else, or by no one (a webhook, a cron fire), never reads this row. That is what keeps a token
/// someone pasted from becoming a shared team credential.
///
/// Inert unless `github.userCredentialsEnabled` is on and the repository's host
/// is in `github.userCredentialHosts`. Turning the switch off keeps the rows and
/// stops using them, so turning it back on needs no re-entry.
///
/// Not tenant-scoped in `tenantGuard`'s sense: every query is narrowed by
/// `userId` or `connectionId`, which are stronger than a team.
model ConnectionCredential {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  connectionId String     @map("connection_id") @db.Uuid
  connection   Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  userId       String     @map("user_id") @db.Uuid
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenCiphertext Bytes  @map("token_ciphertext")
  tokenNonce      Bytes  @map("token_nonce")
  tokenAuthTag    Bytes  @map("token_auth_tag")
  tokenKeyVersion Int    @map("token_key_version")
  tokenLastFour   String @map("token_last_four")

  /// The origins (`https://host[:port]`) the token was verified against when it
  /// was saved. A team lead can repoint a repository's URLs afterwards; a token
  /// is never sent anywhere but where its owner confirmed it, so a mismatch makes
  /// the row unusable until it is saved again.
  apiOrigin String @map("api_origin")
  webOrigin String @map("web_origin")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([connectionId, userId])
  @@index([userId])
  @@map("connection_credentials")
}

/// The webhook secret of one GitHub Enterprise Server host.
///
/// The `GitHubConfig` singleton carries one webhook secret, which is the right
/// shape while every repository lives on one GitHub instance. Repositories on
/// several hosts (`github.repositoryHosts`) each have their own instance
/// configuring its own webhooks, with its own secret. GitHub Enterprise Server
/// names the sending host in `X-GitHub-Enterprise-Host`; a delivery naming a
/// host that has a row here is verified with that row's secret and no other.
///
/// Not tenant-scoped: platform infrastructure, like `GitHubInstallation`.
model GitHubHostWebhookSecret {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Lowercase `host[:port]`, as `X-GitHub-Enterprise-Host` spells it.
  host             String   @unique
  secretCiphertext Bytes    @map("secret_ciphertext")
  secretNonce      Bytes    @map("secret_nonce")
  secretAuthTag    Bytes    @map("secret_auth_tag")
  secretKeyVersion Int      @map("secret_key_version")
  secretLastFour   String   @map("secret_last_four")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("github_host_webhook_secrets")
}

/// Platform GitHub credentials for one approved host that is NOT the instance's.
///
/// The `GitHubConfig` singleton holds the instance's PAT and App, valid on the
/// instance's own host family and nowhere else (`githubHostScope.ts`). A
/// repository on another approved host (`github.repositoryHosts`) is reached
/// with that host's own platform credential, recorded here, exactly as an
/// instance repository is reached with the instance's. The rule is the same:
/// a credential is only ever sent to the host family it belongs to.
///
/// `host` is the lowercase `host[:port]` of the host *family* — `github.com` for
/// both github.com and api.github.com, `<tenant>.ghe.com` for both of a data
/// residency tenant's names. A GitHub Enterprise Server's web and API share a
/// hostname. Credentials for the instance's own family are refused at the API.
///
/// Every column but the key is optional: a host may have a PAT, an App, or
/// both. An App needs `appId` and the private key together; which installation
/// it mints for comes from the repository's `GitHubInstallation` on this host.
/// Webhook secrets stay on `GitHubHostWebhookSecret`: that table's rows mean "this
/// host signs with its own secret", which a credentials-only row must not imply.
///
/// Not tenant-scoped: platform infrastructure, like `GitHubInstallation`.
model GitHubHostCredential {
  id                      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  host                    String   @unique
  tokenCiphertext         Bytes?   @map("token_ciphertext")
  tokenNonce              Bytes?   @map("token_nonce")
  tokenAuthTag            Bytes?   @map("token_auth_tag")
  tokenKeyVersion         Int?     @map("token_key_version")
  tokenLastFour           String?  @map("token_last_four")
  appId                   String?  @map("app_id")
  appPrivateKeyCiphertext Bytes?   @map("app_private_key_ciphertext")
  appPrivateKeyNonce      Bytes?   @map("app_private_key_nonce")
  appPrivateKeyAuthTag    Bytes?   @map("app_private_key_auth_tag")
  appPrivateKeyKeyVersion Int?     @map("app_private_key_key_version")
  appPrivateKeyLastFour   String?  @map("app_private_key_last_four")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("github_host_credentials")
}


/// An npm package registry the workspace proxy fronts, with its upstream
/// credential. The agent never sees `token*`: the worker injects it upstream
/// at the proxy and the container holds only a per-workspace proxy token.
/// `teamId` null means the registry is visible to every team. `npmScopes`
/// empty marks the default registry for unscoped packages.
model PackageRegistry {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String   @unique
  ecosystem           String   @default("npm")
  upstreamUrl         String   @map("upstream_url")
  npmScopes           String[] @default([]) @map("npm_scopes")
  accessMode          String   @default("lockfile") @map("access_mode")
  allowPrivateNetwork Boolean  @default(false) @map("allow_private_network")
  authKind            String   @default("bearer") @map("auth_kind")
  teamId              String?  @map("team_id") @db.Uuid
  team                Team?    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  isActive            Boolean  @default(true) @map("is_active")

  tokenCiphertext Bytes?  @map("token_ciphertext")
  tokenNonce      Bytes?  @map("token_nonce")
  tokenAuthTag    Bytes?  @map("token_auth_tag")
  tokenKeyVersion Int?    @map("token_key_version")
  tokenLastFour   String? @map("token_last_four")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([teamId])
  @@map("package_registries")
}

/// A GitHub App installation on one GitHub account (organization or user).
///
/// The singleton `GitHubConfig` carries the App's own credentials, which are
/// genuinely instance-wide. *Where* the App is installed is not: reaching
/// repositories across several GitHub organizations means several installations,
/// each minting its own token and each answering permission questions only about
/// its own account.
///
/// Not tenant-scoped. An installation is platform infrastructure, like the App
/// credentials themselves — teams reach one by owning a Connection that points
/// at it, not by owning the installation.
model GitHubInstallation {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// The GitHub host family the installation lives on: empty for the
  /// instance's own, otherwise the host key of a `GitHubHostCredential` (see
  /// there). A numeric installation id is only unique per GitHub host, so the
  /// pair is the identity. Empty rather than null so the composite unique below
  /// is an ordinary index — a nullable column would make it a partial one
  /// (NULLs compare distinct), DDL Prisma cannot express.
  host           String  @default("")
  /// GitHub's numeric installation id, as a string (it is an opaque identifier
  /// and every use of it is URL interpolation). Unique per `host`.
  installationId String  @map("installation_id")
  /// The organization or user login the App is installed on. Display only —
  /// GitHub is authoritative, and this is not used to route lookups.
  accountLogin   String  @map("account_login")
  isActive       Boolean @default(true) @map("is_active")
  /// Why a retired installation is retired, when a GitHub webhook did it:
  /// `webhook:suspend` or `webhook:deleted`. Null for an active installation and
  /// for one an admin retired. A webhook only ever reverses its own retirement
  /// (`unsuspend` reactivates a `webhook:suspend` row), so a manual retirement is
  /// never undone by GitHub, and any admin change to `isActive` clears it.
  retiredReason  String? @map("retired_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  connections Connection[]

  @@unique([host, installationId])
  @@map("github_installations")
}

/// A directed edge in the repo dependency graph: `fromRepo` depends on `toRepo`.
/// Nodes are git_repo Connections. See docs/history/repo-dependency-graph-rfc.md.
///
/// A row is either a *resolved edge* (`toRepoId` set) or an *unresolved suggestion*
/// (`toRepoId` null, `toRef` set) — a detected dependency on a package whose repo is
/// not onboarded yet. Uniqueness, the no-self-edge rule, the shape guard, and the
/// status/source enums are partial-index / CHECK constraints in the hand-written
/// migration `20260618000001_custom_constraints_and_indexes` (Prisma’s DSL cannot express them).
model RepoDependency {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fromRepoId    String      @map("from_repo_id") @db.Uuid
  fromRepo      Connection  @relation("RepoDependencyFrom", fields: [fromRepoId], references: [id], onDelete: Cascade)
  /// The dependency repo. Null for an unresolved suggestion (see `toRef`).
  toRepoId      String?     @map("to_repo_id") @db.Uuid
  toRepo        Connection? @relation("RepoDependencyTo", fields: [toRepoId], references: [id], onDelete: Cascade)
  /// Raw unresolved dependency string for a suggestion; null once resolved to a repo.
  toRef         String?     @map("to_ref")
  /// Edge semantics: "code" | "runtime" | "build" | "api" | "data".
  kind          String      @default("code")
  /// Provenance: "manual" | "manifest" | "git_signal" | "inferred".
  source        String      @default("manual")
  /// 1.0 for deterministic sources; <1 for LLM inference.
  confidence    Float       @default(1)
  /// "active" | "proposed" | "dismissed" (sticky veto) | "unresolved" (suggestion).
  status        String      @default("active")
  /// Provenance detail — matched package name, manifest path, importing file, etc.
  detail        Json?
  detectedAt    DateTime    @default(now()) @map("detected_at") @db.Timestamptz
  confirmedById String?     @map("confirmed_by_id") @db.Uuid
  confirmedAt   DateTime?   @map("confirmed_at") @db.Timestamptz
  dismissedById String?     @map("dismissed_by_id") @db.Uuid
  dismissedAt   DateTime?   @map("dismissed_at") @db.Timestamptz
  updatedAt     DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([fromRepoId])
  @@index([toRepoId])
  @@map("repo_dependencies")
}

/// Top-level tenant boundary (P5 multi-org). Every Team belongs to exactly one
/// Organization. The config cascade has an ORGANIZATION tier between TEAM and GLOBAL.
/// `monthlyBudgetUsdCents` is optional; when set, work-request creation is rejected
/// once the org's spend for the current calendar month meets or exceeds the cap.
model Organization {
  id                          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                        String   @unique
  slug                        String   @unique
  isActive                    Boolean  @default(true) @map("is_active")
  /// Optional monthly spend cap in USD cents. Null = no cap enforced.
  monthlyBudgetUsdCents       Int?     @map("monthly_budget_usd_cents")
  /// Percent of monthly cap at which to start warning (0-100). Null = no alert.
  budgetAlertThresholdPercent Int?     @map("budget_alert_threshold_percent")
  /// When true, an ORG_ADMIN's invite creates an active, approved account. Platform-ADMIN-set only.
  trustedInvites              Boolean  @default(false) @map("trusted_invites")
  createdAt                   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  teams               Team[]
  agents              Agent[]
  providerCredentials ProviderCredential[]
  memberships         OrganizationMembership[]
  monthlyUsages       OrgMonthlyUsage[]
  /// Connection-less requests charged to this org (`RunInput.billingOrgId`).
  billedRunInputs     RunInput[]
  slackWorkspaces     SlackWorkspace[]
  slackChannels       SlackChannel[]
  memoryItems         MemoryItem[]             @relation("OrgMemoryItems")
  agentTraces         AgentTrace[]             @relation("OrgAgentTraces")
  agentTranscripts    AgentTranscript[]        @relation("OrgAgentTranscripts")
  knowledgeItems      KnowledgeItem[]
  humanErrorBaselines HumanErrorBaseline[]
  attributedWorkflowRuns WorkflowRun[] @relation("WorkflowRunAttributedOrganization")
  reportDigestSubscriptions ReportDigestSubscription[]

  configSettings    ConfigSetting[]
  configPermissions ConfigPermission[]
  skills            Skill[]
  skillSources      SkillSource[]

  @@map("organizations")
}

model Team {
  id                   String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                 String       @unique
  slug                 String       @unique
  description          String       @default("")
  isActive             Boolean      @default(true) @map("is_active")
  /// Owning Organization (P5). Required: a team always nests under one org.
  orgId                String       @map("org_id") @db.Uuid
  organization         Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  /// Per-team additions to the phase-6 shell-step image allowlist. The built-in
  /// images (BUILTIN_SHELL_IMAGES in shared/workflow/shellImageAllowlist.ts) are
  /// always allowed; entries here grant additional `image:tag` strings.
  /// Managed by team admins via the gateway.
  shellImageAllowlist  String[]     @default([]) @map("shell_image_allowlist")
  egressAllowlist      String[]     @default([]) @map("egress_allowlist")
  /// Phase-7 optional Slack channel ID (e.g. `C0123456`) for per-step failure
  /// notifications. When set + SLACK_BOT_TOKEN is configured, the worker posts
  /// a message on FAILED step records that aren't expected to retry. Null disables.
  slackNotifyChannel   String?      @map("slack_notify_channel")
  /// Phase-8 opt-in for terminal-run notifications. When true and a notify
  /// channel is resolvable (originating channel on the WorkRequest, or
  /// `slackNotifyChannel`), the worker also posts on SUCCESS / final FAILED
  /// from `finalizeWorkflowRun`. Default false so existing teams don't get
  /// a sudden notification firehose.
  slackNotifySuccess   Boolean      @default(false) @map("slack_notify_success")
  /// Default persona prompt for all channel assistants belonging to this team.
  /// Channel-level personaPrompt overrides this. Null = no team-wide persona.
  defaultPersonaPrompt String?      @map("default_persona_prompt")
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  memberships           TeamMembership[]
  repositories          Connection[]
  servicePrincipals     ServicePrincipal[]
  /// Repositories other teams have shared with this one (see `ConnectionTeamShare`).
  sharedRepositories    ConnectionTeamShare[]
  /// Schedules this team owns (see `ScheduledWorkRequest.teamId`).
  scheduledWorkRequests ScheduledWorkRequest[] @relation("ScheduleTeam")
  /// Event automations this team owns that belong to no repository (`Automation.teamId`).
  automations           Automation[]
  /// URLs other services post signed events to (`EventEndpoint`).
  eventEndpoints        EventEndpoint[]
  workflowTemplates     WorkflowTemplate[]
  attributedWorkflowRuns WorkflowRun[]          @relation("WorkflowRunAttributedTeam")
  reportDigestSubscriptions ReportDigestSubscription[]
  shellAudits           WorkflowShellAudit[]
  providerCredentials   ProviderCredential[]
  agents                Agent[]
  slackChannels         SlackChannel[]
  configSettings        ConfigSetting[]
  configPermissions     ConfigPermission[]
  memoryItems           MemoryItem[]           @relation("TeamMemoryItems")
  agentTraces           AgentTrace[]           @relation("TeamAgentTraces")
  agentTranscripts      AgentTranscript[]      @relation("TeamAgentTranscripts")
  callbackEndpoints     CallbackEndpoint[]
  autonomyPolicies      AutonomyPolicy[]
  skills                Skill[]
  skillSources          SkillSource[]
  ownedKnowledgeItems   KnowledgeItem[]         @relation("KnowledgeOwnerTeam")
  originKnowledgeItems  KnowledgeItem[]         @relation("KnowledgeOriginTeam")
  knowledgeGrants       KnowledgeItemTeamGrant[]
  packageRegistries     PackageRegistry[]

  @@index([orgId])
  @@map("teams")
}

model TeamMembership {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId    String   @map("team_id") @db.Uuid
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  role      Role     @default(ENGINEER)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([userId, teamId])
  @@index([userId])
  @@index([teamId])
  @@map("team_memberships")
}

/// Org-level membership (P5 RBAC). Users must be a member of an org to access
/// org-scoped resources and to submit work to teams within that org.
/// Platform ADMINs bypass these checks implicitly (no membership row required).
model OrganizationMembership {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String       @map("user_id") @db.Uuid
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId        String       @map("org_id") @db.Uuid
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  role         OrgRole      @default(ORG_MEMBER)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz

  @@unique([userId, orgId])
  @@index([orgId])
  @@map("organization_memberships")
}

/// Per-org monthly cost aggregation (P5 billing). One row per org per calendar
/// month (yearMonth = 'YYYY-MM'). Upserted by `finalizeWorkflowRun` in the worker
/// using Prisma's increment operator to avoid read-modify-write races.
model OrgMonthlyUsage {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId          String       @map("org_id") @db.Uuid
  organization   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  /// Calendar month as 'YYYY-MM', e.g. '2026-06'.
  yearMonth      String       @map("year_month")
  costUsdAccrued Decimal      @default(0) @map("cost_usd_accrued") @db.Decimal(12, 6)
  runsCompleted  Int          @default(0) @map("runs_completed")
  tokensInput    BigInt       @default(0) @map("tokens_input")
  tokensOutput   BigInt       @default(0) @map("tokens_output")
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([orgId, yearMonth])
  @@index([orgId])
  @@map("org_monthly_usage")
}

/// Manual human-error baseline used for the P5 `errorRateVsHuman` metric.
/// Teams record an audited sample of the manual process this workflow replaces.
model HumanErrorBaseline {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId        String       @map("org_id") @db.Uuid
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  /// Domain the baseline applies to, e.g. `git_repo`, `document`, `record`, `api_only`.
  domain       String
  /// Optional narrower bucket by connection/outcome type.
  outcomeType  String?      @map("outcome_type")
  /// Number of manual outcomes audited.
  sampleSize   Int          @map("sample_size")
  /// How many of those were found to be in error.
  errorCount   Int          @map("error_count")
  /// Derived rate, persisted on write to avoid division by zero on read.
  errorRate    Float        @default(0) @map("error_rate")
  /// Who recorded the baseline.
  recordedById String?      @map("recorded_by_id") @db.Uuid
  recordedBy   User?        @relation(fields: [recordedById], references: [id], onDelete: SetNull)
  recordedAt   DateTime     @default(now()) @map("recorded_at") @db.Timestamptz

  @@index([orgId, domain, outcomeType])
  @@map("human_error_baselines")
}

/// A connected Slack workspace (channel assistant). One row per installed Slack team
/// (`slackTeamId` = Slack's `T0…` id), owned by exactly one Organization so the
/// channel-level config + memory cascade resolves an `orgId`. Channels hang off
/// this; workspace-level team memory uses `MemoryItem.orgId`.
model SlackWorkspace {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Slack workspace/team id (e.g. `T0ABCDEF`). Unique per platform install.
  slackTeamId  String       @unique @map("slack_team_id")
  name         String?
  orgId        String       @map("org_id") @db.Uuid
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  isActive     Boolean      @default(true) @map("is_active")

  /// Multi-workspace install (Full multi-workspace): per-workspace bot token
  /// (`xoxb-…`) captured by the `oauth.v2.access` exchange when the app is
  /// installed into THIS workspace. The bot token is the only per-workspace
  /// secret — the signing secret + OAuth client id/secret stay singleton per app
  /// (`SlackConfig`). AES-256-GCM enveloped like every other secret. Null until
  /// the workspace completes the install flow; all Slack I/O then resolves this
  /// token (per `slackTeamId`/`slackChannelId`) and falls back to the singleton
  /// `SlackConfig.botToken` when absent, so single-workspace installs are
  /// unaffected.
  botTokenCiphertext Bytes?    @map("bot_token_ciphertext")
  botTokenNonce      Bytes?    @map("bot_token_nonce")
  botTokenAuthTag    Bytes?    @map("bot_token_auth_tag")
  botTokenKeyVersion Int?      @map("bot_token_key_version")
  botTokenLastFour   String?   @map("bot_token_last_four")
  /// Slack app id (`A…`) the install belongs to + the install's bot user id
  /// (`U…`, the bot's own Slack user — useful for per-workspace self-mention
  /// filtering). Both captured from `oauth.v2.access`. Null pre-install.
  appId              String?   @map("app_id")
  botUserId          String?   @map("bot_user_id")
  /// When the workspace last completed the bot-token install flow. Null = the
  /// workspace was auto-provisioned from an event but never installed the app
  /// (it then runs on the singleton fallback token).
  installedAt        DateTime? @map("installed_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  channels SlackChannel[]

  @@index([orgId])
  @@map("slack_workspaces")
}

/// A Slack channel where the assistant is a resident teammate (channel assistant). One shared
/// assistant per channel: `agentKey` selects which Agent drives it, resolved via
/// the config cascade with a CHANNEL tier (CHANNEL-scoped Agent rows carry this
/// channel's id). `teamId` governs RBAC + the team tier of the cascade; `orgId`
/// is denormalized for memory scoping + budget. Ambient mode + per-channel
/// budget caps live here.
model SlackChannel {
  id                               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Slack channel id (e.g. `C0ABCDEF`).
  slackChannelId                   String         @map("slack_channel_id")
  workspaceId                      String         @map("workspace_id") @db.Uuid
  workspace                        SlackWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name                             String?
  /// Team whose config + RBAC govern this channel (team tier of the cascade).
  teamId                           String         @map("team_id") @db.Uuid
  team                             Team           @relation(fields: [teamId], references: [id], onDelete: Restrict)
  /// Denormalized owning org (== workspace.org) for memory scoping + budget.
  orgId                            String         @map("org_id") @db.Uuid
  organization                     Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  /// Agent key that drives this channel's assistant. Resolved via the cascade
  /// (CHANNEL → TEAM → ORGANIZATION → GLOBAL).
  agentKey                         String         @default("channelAssistant") @map("agent_key")
  /// When true, the long-lived channel workflow proactively posts (digests,
  /// forgotten-thread follow-ups). Default false so channels are reactive only.
  ambientEnabled                   Boolean        @default(false) @map("ambient_enabled")
  /// 5-field cron for the ambient digest (null = no scheduled digest).
  ambientCron                      String?        @map("ambient_cron")
  /// Reactive interjection (Gap A): when true, a per-channel Schedule polls recent
  /// channel history and the assistant may proactively chime in (opt-in, default
  /// off so the bot is never a firehose responder).
  reactiveEnabled                  Boolean        @default(false) @map("reactive_enabled")
  /// 5-field cron for the reactive poll cadence (null = no reactive poll).
  reactiveCron                     String?        @map("reactive_cron")
  /// Cursor: the newest message timestamp the reactive pass has already evaluated.
  /// Advanced every tick so the LLM only fires on genuinely new conversation.
  lastReactiveCheckAt              DateTime?      @map("last_reactive_check_at") @db.Timestamptz
  /// Cooldown anchor: when the reactive pass last actually posted an interjection.
  /// Rate-limits proactive posts (at most one per cooldown window).
  lastReactiveAt                   DateTime?      @map("last_reactive_at") @db.Timestamptz
  /// Per-channel proactivity tuning (all nullable → use the built-in default).
  /// Reactive interjection: min gap between posts / how far back a tick scans.
  reactiveCooldownMinutes          Int?           @map("reactive_cooldown_minutes")
  reactiveLookbackMinutes          Int?           @map("reactive_lookback_minutes")
  /// Optional per-channel monthly spend cap in USD cents. Null = inherit org cap.
  monthlyBudgetUsdCents            Int?           @map("monthly_budget_usd_cents")
  /// Per-channel persona prompt injected at the top of every system prompt for
  /// this channel's assistant turns, reactive interjections, and ambient digests.
  /// Overrides the team-level defaultPersonaPrompt when set.
  personaPrompt                    String?        @map("persona_prompt")
  /// Passive memory ingestion (Gap G): when true, the ambient workflow silently
  /// extracts salient facts from human messages and writes them to channel memory
  /// without requiring an @mention. Default false (opt-in, noise-averse).
  passiveIngestEnabled             Boolean        @default(false) @map("passive_ingest_enabled")
  /// Cursor for passive ingest: the Slack `ts` string of the newest message
  /// already processed. Stored raw (no DateTime conversion) to avoid float
  /// precision loss. Null means "start from the beginning of time" (no cursor).
  passiveIngestCursor              String?        @map("passive_ingest_cursor")
  /// Private-channel reporting exclusion (Gap G — "does not report from private
  /// channels"). When true, this channel's memory is never surfaced as a SOURCE in
  /// another channel's cross-channel reads (`retrieveChannelMemory` team search) or
  /// in any org-wide proactive reporting. The channel still uses its OWN memory
  /// normally. Auto-set from Slack's `channel_type: 'group'` at provision time;
  /// admin-overridable. Default false (public).
  isPrivate                        Boolean        @default(false) @map("is_private")
  /// Org-wide proactive flagging (Gap B): when true, the ambient workflow may
  /// surface notable activity from OTHER (non-private) channels in the same org
  /// into this channel — "flags things from across the organization". Opt-in,
  /// default off; the cross-org read still excludes `isPrivate` source channels.
  orgFlaggingEnabled               Boolean        @default(false) @map("org_flagging_enabled")
  /// Cooldown anchor: when the org-flagging pass last *evaluated* (advanced once
  /// the embedding + org search ran, for the no-signals/skip/posted outcomes
  /// alike — NOT only when a flag was posted). Org flags are digest-level, so this
  /// rate-limits both the spend and the posting to at most once per ~20 h.
  lastOrgFlagCheckAt               DateTime?      @map("last_org_flag_check_at") @db.Timestamptz
  /// Org-flag evaluation cooldown in hours (null = built-in default 20).
  orgFlagCooldownHours             Int?           @map("org_flag_cooldown_hours")
  /// Persistent live session (Gap H): when true, a plain follow-up reply in a
  /// thread the assistant was recently active in continues the conversation
  /// WITHOUT a re-@mention (within a short session window). Opt-in, default off.
  followupSessionEnabled           Boolean        @default(false) @map("followup_session_enabled")
  /// Per-channel channel-memory consolidation config (Gap F). `consolidationEnabled`
  /// (default true) lets a channel opt OUT of the ambient consolidation pass; the
  /// two nullable overrides tune the cluster size + cosine-similarity threshold
  /// (null = use the built-in defaults: 3 / 0.85).
  consolidationEnabled             Boolean        @default(true) @map("consolidation_enabled")
  consolidationMinClusterSize      Int?           @map("consolidation_min_cluster_size")
  consolidationSimilarityThreshold Float?         @map("consolidation_similarity_threshold")
  /// Open-item sweep (Gap C) proactivity tuning (null = built-in default).
  /// How long an open item must be idle before the assistant nudges (default 24h),
  /// and the min gap between successive nudges of the same item (default 12h).
  openItemNudgeAfterHours          Int?           @map("open_item_nudge_after_hours")
  openItemNudgeCooldownHours       Int?           @map("open_item_nudge_cooldown_hours")
  /// When the Slack channel sync last asked Slack whether this channel is private.
  /// The sync only ever turns `isPrivate` on, never off: an admin may have made a
  /// public channel private on purpose. Null until the sync has answered once.
  privacyCheckedAt                 DateTime?      @map("privacy_checked_at") @db.Timestamptz
  /// When the sync last replaced `members` from Slack's member list. Membership
  /// gives a private channel's members its content in the dashboard, and only
  /// while this is within the sync's staleness window; null means never synced,
  /// which grants nothing.
  membersSyncedAt                  DateTime?      @map("members_synced_at") @db.Timestamptz
  isActive                         Boolean        @default(true) @map("is_active")
  createdAt                        DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                        DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  agents         Agent[]
  budgetHolds    ChannelBudgetHold[]
  memoryItems    MemoryItem[]
  members        SlackChannelMember[]
  monthlyUsage   ChannelMonthlyUsage[]
  openItems      ChannelOpenItem[]
  reportDigestSubscriptions ReportDigestSubscription[]
  threadSessions ChannelThreadSession[]
  configSettings ConfigSetting[]
  workflowRuns   WorkflowRun[]

  @@unique([workspaceId, slackChannelId])
  @@index([teamId])
  @@index([orgId])
  @@map("slack_channels")
}

/// One Slack user in a private channel, as Slack's member list last reported it.
/// Written only by the Slack channel sync, which replaces a channel's rows whole,
/// so a person who leaves the channel drops out at the next sync. Keyed by the
/// Slack user id rather than a platform user: a dashboard user matches through
/// their linked `User.slackId`, read fresh on every request.
model SlackChannelMember {
  channelId   String       @map("channel_id") @db.Uuid
  channel     SlackChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  slackUserId String       @map("slack_user_id")

  @@id([channelId, slackUserId])
  @@index([slackUserId])
  @@map("slack_channel_members")
}

/// Persistent live session (Gap H): tracks when the assistant was last active in
/// a given Slack thread, so a plain follow-up reply (no re-@mention) can continue
/// the conversation while the session is fresh. Written by the worker after each
/// channel turn; read by the gateway on an incoming non-mention thread reply.
model ChannelThreadSession {
  id                      String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  channelId               String       @map("channel_id") @db.Uuid
  channel                 SlackChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  /// Slack thread root `ts` this session belongs to.
  threadTs                String       @map("thread_ts")
  /// When the assistant last replied in this thread (the session freshness anchor).
  lastAssistantAt         DateTime     @default(now()) @map("last_assistant_at") @db.Timestamptz
  /// The most recent workflow template this thread generated, if any. Anchors
  /// conversational refinement ("also add a security review step") to the draft
  /// created earlier in the same thread. Plain UUID (no FK): if the template is
  /// deleted the refine path treats a dangling id as "nothing to refine".
  lastGeneratedTemplateId String?      @map("last_generated_template_id") @db.Uuid
  createdAt               DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([channelId, threadTs])
  @@index([channelId])
  @@map("channel_thread_sessions")
}

/// Status of a channel open item (Gap C: follow-up tracking).
enum ChannelOpenItemStatus {
  OPEN
  RESOLVED
  DISMISSED

  @@map("channel_open_item_status")
}

/// A tracked open action-item, question, or task detected by the channel
/// assistant in the conversation. Populated by the ambient sweep (Gap C) and
/// cleared when the assistant observes a resolution or the admin dismisses it.
model ChannelOpenItem {
  id           String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  channelId    String                @map("channel_id") @db.Uuid
  channel      SlackChannel          @relation(fields: [channelId], references: [id], onDelete: Cascade)
  /// Human-readable description of the open item (question, task, decision).
  description  String
  /// Slack user ID of the person who owns / was assigned the item, if known.
  ownerUserId  String?               @map("owner_user_id")
  status       ChannelOpenItemStatus @default(OPEN)
  /// Slack message timestamp that originated this item (used as a dedup anchor
  /// so the sweep never creates the same item twice).
  sourceTs     String?               @map("source_ts")
  /// When the assistant last posted a follow-up nudge for this item.
  lastNudgedAt DateTime?             @map("last_nudged_at") @db.Timestamptz
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([channelId, status])
  @@map("channel_open_items")
}

/// Per-channel monthly cost aggregation (channel assistant budget). Mirrors
/// OrgMonthlyUsage: one row per channel per calendar month, upserted by the
/// worker with `increment` to avoid read-modify-write races.
model ChannelMonthlyUsage {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  channelId      String       @map("channel_id") @db.Uuid
  channel        SlackChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  yearMonth      String       @map("year_month")
  costUsdAccrued Decimal      @default(0) @map("cost_usd_accrued") @db.Decimal(12, 6)
  runsCompleted  Int          @default(0) @map("runs_completed")
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([channelId, yearMonth])
  @@index([channelId])
  @@map("channel_monthly_usage")
}

/// One in-flight claim on a channel's remaining monthly budget.
///
/// A turn's real cost is only known after the model answers, so it increments
/// `channel_monthly_usage.cost_usd_accrued` by an estimate first and nets that
/// out when it settles. The increment alone is enough to bound concurrency, but
/// it is unrecoverable on its own: a worker that dies mid-turn never settles, and
/// the estimate stays on the ledger for the rest of the calendar month.
///
/// This row is what makes the claim reversible. `settle` deletes it; a later
/// reserve sweeps any row past `expires_at`, subtracting the amount it added
/// back off the ledger. So a lost hold costs one expiry window, not one month.
model ChannelBudgetHold {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  channelId String       @map("channel_id") @db.Uuid
  channel   SlackChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  /// The ledger row this hold was added to — pinned, so a turn spanning a month
  /// boundary settles against the row it claimed from.
  yearMonth String       @map("year_month")
  amountUsd Decimal      @map("amount_usd") @db.Decimal(12, 6)
  /// After this instant the hold is presumed abandoned and is swept.
  expiresAt DateTime     @map("expires_at") @db.Timestamptz
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz

  @@index([channelId, yearMonth])
  /// The sweep filters `channelId` + `expiresAt`; a bare `expiresAt` index would
  /// never be the access path, and this is the highest-churn table in the
  /// channel path — one insert and one delete per turn.
  @@index([channelId, expiresAt])
  @@map("channel_budget_holds")
}

model User {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                String    @unique
  /// Legacy bcrypt hash. Optional because OAuth-only / magic-link-only
  /// users have no password; better-auth stores its own credential hash
  /// in the `accounts` table.
  passwordHash         String?   @map("password_hash")
  /// Better-auth canonical fields.
  name                 String?
  emailVerified        Boolean   @default(false) @map("email_verified")
  image                String?
  slackId              String?   @unique @map("slack_id")
  /// GitHub username (the `login`, not the numeric id), captured when the user
  /// links a GitHub identity. The repo-permission projection is keyed on this:
  /// GitHub's collaborator-permission endpoint addresses a user by login, and
  /// better-auth stores only the numeric account id on `Account.accountId`, so
  /// without this column there is no way to ask GitHub about a platform user
  /// without first spending a round-trip to translate the id.
  ///
  /// Unique because one GitHub identity must not map to two platform users —
  /// the projection would then grant one user's access to the other.
  githubLogin          String?   @unique @map("github_login")
  /// The `Account.accountId` the login was read from (`{host}:{id}`, or a bare
  /// github.com id). A user can link several GitHub accounts, and a login is
  /// only comparable with the id space of the host that issued it, so ownership
  /// verification needs to know which account to check. Null on a row written
  /// before this was recorded; cleared together with `githubLogin`.
  githubLoginAccountId String?   @map("github_login_account_id")
  role                 Role      @default(ENGINEER)
  isActive             Boolean   @default(true) @map("is_active")
  /// When an account was first made active, by an admin or by the GitHub org
  /// auto-approval rule. Never cleared, so it separates a deactivated account
  /// (set) from one still waiting in the approval queue (null): auto-approval
  /// only ever acts on the second, and deactivation therefore sticks.
  approvedAt           DateTime? @map("approved_at") @db.Timestamptz
  /// Who approved: `admin`, `org_admin` for a trusted organization's org-admin
  /// invite, or `github-org:<org>` for the auto-approval rule.
  approvalSource       String?   @map("approval_source")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  preferences          Json      @default("{}") @map("preferences")

  memberships           TeamMembership[]
  orgMemberships        OrganizationMembership[]
  accessTokens          ApiToken[]
  assistantActions      AssistantAction[]
  assistantConversations AssistantConversation[]
  /// Better-auth relations.
  accounts              Account[]
  sessions              Session[]
  oauthClients          OauthClient[]
  oauthAccessTokens     OauthAccessToken[]
  oauthRefreshTokens    OauthRefreshToken[]
  oauthConsents         OauthConsent[]
  humanApprovals        HumanApproval[]
  humanStepsResolved    WorkflowHumanStep[]
  humanErrorBaselines   HumanErrorBaseline[]
  workRequests          RunInput[]
  scheduledWorkRequests ScheduledWorkRequest[]   @relation("ScheduleCreator")
  skillRevisions        SkillRevision[]          @relation("SkillRevisionCreator")
  skillSources          SkillSource[]            @relation("SkillSourceCreator")
  schedulesActingAs     ScheduledWorkRequest[]   @relation("ScheduleActsAs")
  automations           Automation[]             @relation("AutomationCreator")
  servicePrincipals     ServicePrincipal[]       @relation("ServicePrincipalCreator")
  eventEndpoints        EventEndpoint[]          @relation("EventEndpointCreator")
  configPermissions     ConfigPermission[]
  repoAccess            RepoAccess[]
  connectionCredentials ConnectionCredential[]
  knowledgeApprovals    KnowledgeItem[]         @relation("KnowledgeItemApprover")
  knowledgeEvents       KnowledgeItemEvent[]    @relation("KnowledgeEventActor")
  launchedRuns          WorkflowRun[]            @relation("WorkflowRunLauncher")
  createdShares         ConnectionTeamShare[]    @relation("ConnectionShareCreator")
  createdCallbackEndpoints CallbackEndpoint[]    @relation("CallbackEndpointCreator")
  lessonFlags           LessonFlag[]             @relation("LessonFlagAuthor")

  @@map("users")
}

/// Better-auth `Account` model — one row per linked provider per user.
/// `providerId='credential'` holds the email+password account; OAuth rows
/// carry the access/refresh/id tokens from the upstream provider.
model Account {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz
  scope                 String?
  /// Better-auth's own credential hash (scrypt) for `providerId='credential'`.
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

/// Better-auth `Session` model — one row per active browser session.
/// Distinct from `RefreshToken` (which the hand-rolled JWT path uses).
model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token     String   @unique
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  oauthAccessTokens  OauthAccessToken[]
  oauthRefreshTokens OauthRefreshToken[]

  @@index([userId])
  @@map("sessions")
}

/// Better-auth `Verification` model — short-lived tokens for email
/// verification and magic-link sign-in.
model Verification {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([identifier])
  @@map("verifications")
}

/// One run submission (P3 — generic; replaces the SWE-specific `WorkRequest`).
/// `payload` is the generic run-input bag validated against the template's
/// `inputSchema`; `connectionId` is the generic target Connection. The SWE
/// specifics (`externalTicketId`, `requestPayload`) stay as typed columns for
/// parity and are re-expressed through `payload` over the P3 slices. The
/// relation field names on related models (`workRequest`/`workRequests`) and
/// the scalar FK (`workRequestId`) are intentionally kept stable across the
/// rename so the public API shape doesn't churn.
model RunInput {
  id                      String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  externalTicketId        String      @map("external_ticket_id")
  /// True when the platform generated `externalTicketId` (a launch that named no
  /// ticket, a PRD run, a scheduled fire): a correlation key, not a ticket. The
  /// ticket view leaves these out by default.
  ticketIsSynthetic       Boolean     @default(false) @map("ticket_is_synthetic")
  description             String      @default("")
  requestPayload          String      @map("request_payload")
  /// The launch's `label`, trimmed and cut to 200 characters: what lists show as
  /// the request's title, so a text search can match it. A database trigger
  /// (migration `20261017120000_run_input_title`) derives it from `requestPayload`
  /// on every insert and update, so every launch path has it without writing it,
  /// and a value written here is replaced. Null when the payload is not a JSON
  /// object or carries no string label.
  title                   String?
  /// Generic run-input payload (P3); validated against the template's
  /// `inputSchema`. Null on rows created before this column existed.
  payload                 Json?
  /// Generic target Connection (P3). Null = not connection-scoped (or legacy
  /// rows where the linkage lives on requestPayload/ActiveWorkflow.repoId).
  connectionId     String?     @map("connection_id") @db.Uuid
  connection       Connection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  /// The organization a launch with no connection charged this request to: the
  /// org its launch decision gated (a template run's template team, a team
  /// automation's team, a service principal's team). Billing reads it only when
  /// no connection and no ledger repository places the run (`billedOrgId`), so
  /// it is null whenever the launch named a connection. Re-runs of the request
  /// inherit it.
  billingOrgId     String?       @map("billing_org_id") @db.Uuid
  billingOrg       Organization? @relation(fields: [billingOrgId], references: [id], onDelete: SetNull)
  /// Immutable source identity recorded by the authorized launch transaction.
  /// Null on legacy rows; UNKNOWN is explicit and never promoted from absent links.
  knowledgeSourceKind WorkflowRunKnowledgeSourceKind? @map("knowledge_source_kind")
  knowledgeSourceRepoId String? @map("knowledge_source_repo_id") @db.Uuid
  knowledgeSourceTeamId String? @map("knowledge_source_team_id") @db.Uuid
  knowledgeSourceOrgId String? @map("knowledge_source_org_id") @db.Uuid
  /// Authorized epic target identities, separate from caller-controlled requestPayload.
  knowledgeRepoSources Json?     @map("knowledge_repo_sources")
  slackMessageTs   String?     @map("slack_message_ts")
  /// Channel that originated the request (paired with slackMessageTs to thread
  /// per-step failure notifications back to the source conversation). Populated
  /// when the work request was created via the Slack slash command.
  slackChannelId          String?     @map("slack_channel_id")
  isCrossRepo             Boolean     @default(false) @map("is_cross_repo")
  /// The work branch the launch decided for this run, when it is not `<branchPrefix>/<ticket>`
  /// (a Jira status-change run, whose ticket can have several runs). Null for every other run.
  /// A re-run carries it, so the request keeps one branch for its whole life.
  workBranch              String?     @map("work_branch")
  /// Optional template override; null → use team default. Snapshotted into
  /// WorkflowRun at start so live edits to templates don't affect in-flight runs.
  templateId              String?     @map("template_id") @db.Uuid
  templateVersion         Int?        @map("template_version")
  /// Who submitted the request (audit). Null for pre-existing rows and
  /// webhook-originated requests without a platform user.
  requestedById           String?     @map("requested_by_id") @db.Uuid
  requestedBy             User?       @relation(fields: [requestedById], references: [id], onDelete: SetNull)
  /// The service principal that submitted the request, when a machine did
  /// rather than a person (`requestedById` is then null). Attribution and
  /// visibility only: the run uses the platform credential.
  requestedByServiceId    String?           @map("requested_by_service_id") @db.Uuid
  requestedByService      ServicePrincipal? @relation("RunInputServiceRequester", fields: [requestedByServiceId], references: [id], onDelete: SetNull)
  /// Caller-supplied `Idempotency-Key` on `POST /work-requests`. Unique per
  /// submitter; null (every key-less launch) never collides, since Postgres
  /// treats nulls as distinct in a unique index.
  idempotencyKey          String?     @map("idempotency_key")
  /// The `ActiveWorkflow` id the original 201 returned, stamped once the Temporal
  /// start succeeded. Null on a keyed row means the launch is still starting (or
  /// its cleanup failed): a replay answers "in progress" rather than success.
  /// Always null on key-less rows.
  startedActiveWorkflowId String?     @map("started_active_workflow_id") @db.Uuid
  createdAt               DateTime    @default(now()) @map("created_at") @db.Timestamptz

  contextSnapshot       ContextSnapshot?
  activeWorkflows       ActiveWorkflow[]
  workflowRuns          WorkflowRun[]
  scheduledWorkRequests ScheduledWorkRequest[]
  /// Where the run's outcome is reported, when the launch asked for a callback
  /// (docs/run-callbacks.md). Its own table, so a whole-row read of the request
  /// never carries the sealed URL or the caller's context.
  callback              RunCallback?

  @@unique([requestedById, idempotencyKey])
  @@index([connectionId])
  @@index([billingOrgId])
  @@index([requestedById])
  @@index([requestedByServiceId, createdAt])
  @@index([externalTicketId])
  @@map("run_inputs")
}

/// A standing automation: a Temporal Schedule that fires RunnableWorkflow on a
/// cron cadence against one repo (e.g. run the dependency-update template weekly).
///
/// Design notes (scheduled runs vs. interactive work requests):
/// - One Temporal Schedule exists per row (`auto-swe-scheduled-wr-<id>`). Its
///   action starts RunnableWorkflow with workflowId `sched-<id>`; Temporal
///   appends the per-fire scheduled timestamp, so each fire gets a unique
///   workflow ID and therefore a fresh WorkflowRun row.
/// - Schedule action args are static, so per-fire WorkRequest rows cannot be
///   created. Instead `workRequestId` points at one standing WorkRequest
///   created when the schedule is saved; every fire's WorkflowRun links to it.
/// - `templateId`/`templateVersion` null means "use the repo team's default
///   template". Resolution happens when the schedule is saved or updated
///   (snapshot semantics, same as work requests) — NOT at fire time.
model ScheduledWorkRequest {
  id                   String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                 String
  /// 5-field cron expression (validated conservatively at the API layer).
  cronExpression       String            @map("cron_expression")
  repoId               String            @map("repo_id") @db.Uuid
  repository           Connection        @relation(fields: [repoId], references: [id], onDelete: Cascade)
  /// Explicit template override; null → repo team default resolved at save time.
  templateId           String?           @map("template_id") @db.Uuid
  template             WorkflowTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  templateVersion      Int?              @map("template_version")
  description          String
  /// Ticket-ID prefix for fires, e.g. 'DEPS' → synthetic ticket `DEPS-sched-<id8>`.
  externalTicketPrefix String            @map("external_ticket_prefix")
  budgetTier           String            @default("STANDARD") @map("budget_tier")
  isActive             Boolean           @default(true) @map("is_active")
  createdById          String?           @map("created_by_id") @db.Uuid
  createdBy            User?             @relation("ScheduleCreator", fields: [createdById], references: [id], onDelete: SetNull)
  /// Whose identity every fire launches as: the user who last defined WHAT the
  /// schedule does (created it, or changed its description or template). Fires
  /// may use that user's own saved GitHub token, so a person editing someone
  /// else's schedule takes it over rather than borrowing their token. Null —
  /// the author was deleted, or the schedule predates this — means no launcher
  /// and only the platform credential.
  actsAsUserId         String?           @map("acts_as_user_id") @db.Uuid
  actsAsUser           User?             @relation("ScheduleActsAs", fields: [actsAsUserId], references: [id], onDelete: SetNull)
  /// Standing WorkRequest that all scheduled fires attach their WorkflowRuns to.
  workRequestId        String?           @map("work_request_id") @db.Uuid
  workRequest          RunInput?         @relation(fields: [workRequestId], references: [id], onDelete: SetNull)
  /// The team that owns the schedule: the repository's owning team or a team it
  /// is shared with. Null means the team was deleted (the migration backfilled
  /// every earlier row): managed only by ADMIN or the owning team's lead, and
  /// deactivated when the repository moves or a share is removed.
  teamId               String?           @map("team_id") @db.Uuid
  team                 Team?             @relation("ScheduleTeam", fields: [teamId], references: [id], onDelete: SetNull)
  /// Best-effort bookkeeping — authoritative fire history lives in Temporal.
  lastFiredAt          DateTime?         @map("last_fired_at") @db.Timestamptz
  nextFireAt           DateTime?         @map("next_fire_at") @db.Timestamptz
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  /// Compare-and-set token for edits, fire-by-hand takeovers and deactivations:
  /// each writes conditionally on the version it read and increments it. Not
  /// bumped by `lastFiredAt` bookkeeping, which no decision depends on.
  version              Int               @default(0)

  @@index([repoId])
  @@index([templateId])
  @@index([createdById])
  @@index([actsAsUserId])
  @@index([workRequestId])
  @@index([teamId])
  @@map("scheduled_work_requests")
}

/// An event automation (docs/automations.md): when an occurrence of `source` matches
/// `filters`, start `template` (null: the source's default) with `inputs`, within the limits.
/// It belongs to a repository (`connectionId`, managed by the repository's owning team) or, for
/// a source whose automations target a team, to a team (`teamId`, no repository; managed by the
/// team's leads). At least one is set (a hand-written CHECK); a row with a repository is a
/// repository automation whatever else it names. `filters` and `inputs` are JSON objects whose
/// shape is the source's and the template's; both are checked on save and on every fire.
model Automation {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  connectionId    String?           @map("connection_id") @db.Uuid
  connection      Connection?       @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  teamId          String?           @map("team_id") @db.Uuid
  team            Team?             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  /// For a team automation only: the repository its runs act on, one the team owns or is
  /// shared. It does not make the automation a repository's: the team keeps it, and its
  /// decisions stay on the source's owner key. Deleting the repository deletes the automation.
  targetConnectionId String?        @map("target_connection_id") @db.Uuid
  targetConnection   Connection?    @relation("AutomationTargetConnection", fields: [targetConnectionId], references: [id], onDelete: Cascade)
  name            String
  enabled         Boolean           @default(true)
  /// An event source key (`EVENT_SOURCES`), e.g. `github.workflow_run.failed`.
  source          String
  /// The source's filters (`EventSource.filters`).
  filters         Json
  /// The template options this automation sets; an empty object means the template's defaults.
  inputs          Json              @default("{}")
  /// No new run for the same scope (a branch, an issue) within this many minutes of the last.
  cooldownMinutes Int               @default(30) @map("cooldown_minutes")
  /// At most this many runs started by this automation in any 24 hours.
  maxRunsPerDay   Int               @default(10) @map("max_runs_per_day")
  /// The template a fire starts; null means the source's default.
  templateId      String?           @map("template_id") @db.Uuid
  template        WorkflowTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  createdById     String?           @map("created_by_id") @db.Uuid
  createdBy       User?             @relation("AutomationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  fires AutomationFire[]
  /// Present only for a polling source (`jira.filter.new_issue`, `jira.filter.status_changed`).
  pollState  AutomationPollState?
  seenIssues AutomationSeenIssue[]

  @@index([connectionId, source])
  @@index([teamId, source])
  @@index([targetConnectionId])
  @@index([templateId])
  @@index([createdById])
  @@map("automations")
}

/// A URL another service posts signed events to (docs/inbound-events.md). It belongs to a team,
/// whose `inbound.event` automations decide what each event starts. The secret is sealed with
/// the same AES-GCM envelope as every other stored credential; a rotation keeps the secret it
/// replaced, accepted until `previousSecretExpiresAt`.
model EventEndpoint {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId                   String    @map("team_id") @db.Uuid
  team                     Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  name                     String
  enabled                  Boolean   @default(true)
  /// `autoswe-v1`, `hmac-sha256` or `shared-secret-header`.
  scheme                   String
  /// The header an `hmac-sha256` signature or a shared secret is sent in.
  signatureHeader          String?   @map("signature_header")
  /// Text before the value in that header (`sha256=`, `Bearer `).
  signaturePrefix          String?   @map("signature_prefix")
  /// `hex` or `base64`, for `hmac-sha256`.
  signatureEncoding        String?   @map("signature_encoding")
  /// `json` or `cloudevents`.
  format                   String    @default("json")
  /// JSON Pointers (RFC 6901) into the event document.
  typePointer              String    @map("type_pointer")
  idPointer                String?   @map("id_pointer")
  subjectPointer           String?   @map("subject_pointer")
  scopePointer             String?   @map("scope_pointer")
  timePointer              String?   @map("time_pointer")
  secretCiphertext         Bytes     @map("secret_ciphertext")
  secretNonce              Bytes     @map("secret_nonce")
  secretAuthTag            Bytes     @map("secret_auth_tag")
  secretKeyVersion         Int       @map("secret_key_version")
  secretLastFour           String    @map("secret_last_four")
  previousSecretCiphertext Bytes?    @map("previous_secret_ciphertext")
  previousSecretNonce      Bytes?    @map("previous_secret_nonce")
  previousSecretAuthTag    Bytes?    @map("previous_secret_auth_tag")
  previousSecretKeyVersion Int?      @map("previous_secret_key_version")
  previousSecretLastFour   String?   @map("previous_secret_last_four")
  previousSecretExpiresAt  DateTime? @map("previous_secret_expires_at") @db.Timestamptz
  createdById              String?   @map("created_by_id") @db.Uuid
  createdBy                User?     @relation("EventEndpointCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@index([teamId])
  @@index([createdById])
  @@map("event_endpoints")
}

/// One decision an event automation made about one occurrence: started a run, or suppressed
/// it and why. Also the record the limits are decided on, so it is keyed on its OWNER
/// (`ownerKey`: a repository as `<host>/<owner>/<repo>` lowercased, anything else as
/// `@<kind>/<id>`) and outlives the automation and the connection row: deleting and recreating
/// either must not forget what was already done.
/// `dedupeKey` names the occurrence on its host; `subjectKey` is what one run is enough for (a
/// commit); `scopeKey` what cooldown and in-flight count over (a branch); `producedKey` what a
/// run itself produced (a pushed fix commit), never acted on again.
model AutomationFire {
  id                 String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  automationId       String?     @map("automation_id") @db.Uuid
  automation         Automation? @relation(fields: [automationId], references: [id], onDelete: SetNull)
  connectionId       String?     @map("connection_id") @db.Uuid
  connection         Connection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  /// Stored in `repo_key`, the column's name from before owners other than repositories: a
  /// rename would break every older gateway and worker still running during a rolling deploy.
  ownerKey           String      @map("repo_key")
  source             String
  dedupeKey          String      @unique @map("dedupe_key")
  /// One of `AUTOMATION_OUTCOMES`.
  outcome            String
  reason             String?
  scopeKey           String      @map("scope_key")
  subjectKey         String      @map("subject_key")
  producedKey        String?     @map("produced_key")
  /// The occurrence as the source saw it, for display (`workflowPath`, `event`, `runId`, …).
  facts              Json        @default("{}")
  temporalWorkflowId String?     @map("temporal_workflow_id")
  workRequestId      String?     @map("work_request_id") @db.Uuid
  /// Set when the decision was taken again (a redelivery of a failed start, or a manager's
  /// retry); a newer row then holds the occurrence's dedupe key.
  retriedAt          DateTime?   @map("retried_at") @db.Timestamptz
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz

  @@index([automationId, createdAt])
  @@index([ownerKey, scopeKey, createdAt])
  @@index([ownerKey, subjectKey])
  @@index([producedKey])
  @@index([workRequestId])
  @@index([connectionId])
  @@map("automation_fires")
}

/// What a polling automation (`jira.filter.new_issue` or `jira.filter.status_changed`) remembers between polls. The gateway
/// poller claims `leaseUntil` with a compare-and-set before it polls, so replicas never poll one
/// automation at once; `baselinedAt` is empty until the first poll has recorded what already
/// matched, and that poll starts no run.
model AutomationPollState {
  automationId String     @id @map("automation_id") @db.Uuid
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  baselinedAt  DateTime?  @map("baselined_at") @db.Timestamptz
  /// The JQL the baseline was taken for. A poll whose JQL differs takes a new baseline, so a changed
  /// query never starts runs for what it already matched, whatever order the writes landed in.
  baselineJql  String?    @map("baseline_jql")
  lastPolledAt DateTime?  @map("last_polled_at") @db.Timestamptz
  /// A fixed code (`FILTER_TOO_BROAD`, …), never text from the tracker. Null after a good poll.
  lastError    String?    @map("last_error")
  leaseUntil   DateTime?  @map("lease_until") @db.Timestamptz
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  @@map("automation_poll_states")
}

/// An issue key a polling automation has already decided on (or baselined); for
/// `jira.filter.status_changed` the key is `<issue>#<status>`, one row per pair, never pruned. It is kept apart from
/// the decision ledger on purpose: the retention sweep deletes decisions that started no run, and
/// a key kept only there would look new again once pruned. A hand-written CHECK keeps `issueKey`
/// lower-case, so one issue has one spelling.
model AutomationSeenIssue {
  automationId String     @map("automation_id") @db.Uuid
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  issueKey     String     @map("issue_key")
  firstSeenAt  DateTime   @default(now()) @map("first_seen_at") @db.Timestamptz

  @@id([automationId, issueKey])
  @@map("automation_seen_issues")
}

/// Large step outputs (diffs, logs, scan artifacts) are kept out of the
/// workflow-history context to stay under Temporal's 50MB cap. The interpreter
/// passes the artifact ID around; activities fetch the blob on demand.
///
/// `backend` is "s3" when ARTIFACT_S3_BUCKET is configured, "pg" otherwise.
/// For "pg" the bytes live in `inlineBlob`; for "s3" only `s3Key` is set.
model WorkflowArtifact {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  runId       String?      @map("run_id") @db.Uuid
  run         WorkflowRun? @relation(fields: [runId], references: [id], onDelete: Cascade)
  evidence    TrustedKnowledgeEvidence[]
  kind        String
  contentType String       @default("application/octet-stream") @map("content_type")
  sizeBytes   Int          @map("size_bytes")
  backend     String
  s3Bucket    String?      @map("s3_bucket")
  s3Key       String?      @map("s3_key")
  inlineBlob  Bytes?       @map("inline_blob")
  /// "ready" once the payload is stored. An S3 artifact's row is written
  /// "pending" before its PutObject so an object whose upload outlived its
  /// writer is still findable; the transcript sweep deletes a day-old pending
  /// row and its object (a failed upload leaves its row pending too).
/// `getArtifact` refuses a row that is not ready; readers that treat a row as
/// an available artifact filter on `status: 'ready'`.
  status      String       @default("ready")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz

  transcriptParts AgentTranscriptPart[]

  @@index([runId])
  @@map("workflow_artifacts")
}

enum KnowledgeEvidenceProducer {
  QUALITY_GATE
}

enum KnowledgeEvidenceOutcome {
  PASSED
}

enum WorkflowRunKnowledgeSourceKind {
  UNKNOWN
  REPOSITORY
  TEAM
}

/// Worker-owned, exact-attempt provenance for evidence accepted by knowledge capture.
model TrustedKnowledgeEvidence {
  id             String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  runId          String                    @map("run_id") @db.Uuid
  run            WorkflowRun               @relation(fields: [runId], references: [id], onDelete: Cascade)
  temporalRunId  String                   @map("temporal_run_id")
  recordingId    String                   @map("recording_id")
  specNodeId     String                   @map("spec_node_id")
  stepAttempt    Int                      @map("step_attempt")
  activityAttempt Int                     @default(1) @map("activity_attempt")
  evidenceCorrelation String               @map("evidence_correlation")
  producer       KnowledgeEvidenceProducer
  gateName       String                   @map("gate_name")
  outcome        KnowledgeEvidenceOutcome
  artifactId     String?                  @map("artifact_id") @db.Uuid
  artifact       WorkflowArtifact?        @relation(fields: [artifactId], references: [id], onDelete: SetNull)
  summary        String
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz

  @@unique([runId, recordingId, stepAttempt, activityAttempt, producer, gateName])
  @@index([runId, artifactId])
  @@index([artifactId])
  @@map("trusted_knowledge_evidence")
}

/// One execution of a template. `specSnapshot` is the parsed WorkflowSpec at
/// start time, so live edits to the template do not affect this run.
model WorkflowRun {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workflowId        String            @unique @map("workflow_id")
  templateId        String            @map("template_id") @db.Uuid
  template          WorkflowTemplate  @relation(fields: [templateId], references: [id], onDelete: Restrict)
  templateVersion   Int               @map("template_version")
  workRequestId     String?           @map("work_request_id") @db.Uuid
  workRequest       RunInput?         @relation(fields: [workRequestId], references: [id])
  /// The Slack channel a channel-assistant run (mention, ambient digest,
  /// reactive interjection) belongs to. Null for every other run. Relational so
  /// run visibility can reach the channel's owning team — the same metadata in
  /// `specSnapshot.channel` is JSON, which a visibility predicate cannot join.
  channelId         String?           @map("channel_id") @db.Uuid
  channel           SlackChannel?     @relation(fields: [channelId], references: [id], onDelete: SetNull)
  /// The repository this run itself acts on, when that differs from what its
  /// work request names: an epic child, whose work request is the epic's and
  /// spans every repository. Run visibility reads it so a member of one of the
  /// epic's teams reaches that team's child, not every child of the epic.
  connectionId      String?           @map("connection_id") @db.Uuid
  connection        Connection?       @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  /// Immutable knowledge source identity captured when this row is first created.
  /// Nullable for legacy rows; those executions cannot capture knowledge.
  knowledgeSourceKind WorkflowRunKnowledgeSourceKind? @map("knowledge_source_kind")
  knowledgeSourceRepoId String?         @map("knowledge_source_repo_id") @db.Uuid
  knowledgeSourceTeamId String?         @map("knowledge_source_team_id") @db.Uuid
  knowledgeSourceOrgId String?          @map("knowledge_source_org_id") @db.Uuid
  specSnapshot      Json              @map("spec_snapshot")
  contextSnapshot   Json?             @map("context_snapshot")
  /// P1/WS3 Agent-version snapshot taken at run start: a `{ agentKey: version }`
  /// map of the active GLOBAL Agent versions when the run began. resolveAgent
  /// pins to these versions for the life of the run, so editing an Agent
  /// (cutting a new version) does not change an in-flight run. Null for runs
  /// created before this column existed (they resolve the latest version).
  agentVersions     Json?             @map("agent_versions")
  /// Snapshot of every run-pinned registry setting, taken when the run began.
  /// `resolveSetting` reads these instead of the live cascade for keys marked
  /// `runPinned`, so changing a knob mid-run cannot alter a decision the run
  /// has already made (fan-out width, transition ceilings, budget tiers). Keys
  /// that are not run-pinned still re-resolve on every call, which is what lets
  /// a model or credential edit land inside an in-flight workflow. Null for
  /// runs created before this column existed — they resolve live.
  pinnedSettings    Json?             @map("pinned_settings")
  /// `{ agentKey: 'mastra' | 'claude-code' | 'pi' }`: the runtime each agent ran on,
  /// pinned the first time the run resolved it, so a later edit of the agent,
  /// its scoped overrides or the setting cannot switch it mid-run.
  agentRuntimes     Json?             @map("agent_runtimes")
  /// The connections this run may use, resolved and authorized when it was created:
  /// the workspace connection, every `connection`-typed input its template version
  /// declares with a value in the payload, and the literal ids its spec names (an
  /// `mcp` node's `connectionRef`). A node that resolves a connection outside this set
  /// is refused where it is used (`assertRunMayUseConnection`), so a template cannot
  /// reach another team's credential through a field its schema does not describe.
  /// Pinned rather than derived because the template's `inputSchema` is mutable while
  /// the spec is snapshotted: deriving from the current schema would let one edit
  /// widen a run already in flight. `Json` rather than `String[]` for the same reason
  /// its neighbours are: Prisma has no optional list, and **null ("no pin", a run
  /// created before this column existed) has to be distinct from an empty set**
  /// ("authorized nothing").
  authorizedConnectionIds Json?      @map("authorized_connection_ids")
  /// `{ [connectionId]: DetectedStack | null }` for every connection the run may use (its
  /// `authorizedConnectionIds`), as detected when the run began, so a stack scan landing
  /// mid-run cannot move a later step to another image or directory than an earlier one. A
  /// key mapped to `null` means the connection had no recorded detection when the run began
  /// (in practice a repository the scan had not reached yet), and is pinned anyway so the
  /// run is consistent with itself; an absent key, or a null column (a run created before
  /// this column existed), reads the live `Connection.detectedStack`. It is read through the
  /// run's `workflowId`; a later execution that reuses the workflow id takes a fresh
  /// snapshot, and a Temporal retry of one execution keeps the first.
  pinnedDetections  Json?             @map("pinned_detections")
  /// The Temporal run id of the execution that took `pinnedDetections`. A later execution that
  /// reuses the workflow id differs from it and re-pins; an attempt of the same execution finds it
  /// equal and keeps the pin. Separate from `temporalRunId`, which is written on create only (it
  /// names the first execution, for the launcher-credential check).
  pinnedDetectionsFor String?         @map("pinned_detections_for")
  /// Snapshot of the skill revisions the run's agents reference, taken when the
  /// run began: a `{ skillId: revision }` map. `resolveAgent` reads the pinned
  /// `SkillRevision` text instead of the live `Skill` row, so editing a skill
  /// mid-run cannot change the prompt a retry or replay sees. A skill with no
  /// entry (added to an agent after the run began) resolves its current
  /// revision. Null for runs created before this column existed.
  skillRevisions    Json?             @map("skill_revisions")
  /// Reporting-only attribution; these fields do not affect run visibility.
  attributedTeamId  String?           @map("attributed_team_id") @db.Uuid
  attributedTeam    Team?             @relation("WorkflowRunAttributedTeam", fields: [attributedTeamId], references: [id], onDelete: SetNull)
  attributedOrgId   String?           @map("attributed_org_id") @db.Uuid
  attributedOrganization Organization? @relation("WorkflowRunAttributedOrganization", fields: [attributedOrgId], references: [id], onDelete: SetNull)
  /// True when this run was routed to the canary arm (evals P2 canary).
  /// Used to split EvalResult rows for canary vs control comparison.
  isCanary          Boolean           @default(false) @map("is_canary")
  /// The defaultBranch HEAD SHA captured at workspace creation time (before agent
  /// edits). Used by the P3 historical-replay tier to replay a run deterministically
  /// against the original repo state. Null for runs created before this field existed
  /// or when capture failed.
  baselineSha       String?           @map("baseline_sha")
  /// The platform user who started this execution, from the workflow's own
  /// input — distinct from `workRequest.requestedById`, because a re-run of
  /// someone else's request is launched by whoever re-ran it. Decides whose
  /// saved GitHub credential the run may use; null (webhook, cron) means none.
  launchedById      String?           @map("launched_by_id") @db.Uuid
  launchedBy        User?             @relation("WorkflowRunLauncher", fields: [launchedById], references: [id], onDelete: SetNull)
  /// Temporal's run id for the execution that created this row. A workflow id
  /// can be started again once its previous execution closes, and this row is
  /// upserted by workflow id and never rewritten — so `launchedById` is only
  /// trusted by an activity whose own run id matches this one.
  temporalRunId     String?           @map("temporal_run_id")
  status            WorkflowRunStatus @default(RUNNING)
  startedAt         DateTime          @default(now()) @map("started_at") @db.Timestamptz
  endedAt           DateTime?         @map("ended_at") @db.Timestamptz
  updatedAt         DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  /// When the run reaper last asked Temporal about this run and found it still
  /// running. The sweep orders by it (never-checked first), so a crowd of
  /// long-lived live runs cannot keep newer stranded ones out of its batch.
  reapCheckedAt     DateTime?         @map("reap_checked_at") @db.Timestamptz
  /// Phase-8 cost denormalization. Populated by `finalizeWorkflowRun` from
  /// `WorkRequest → ActiveWorkflow.costUsdAccrued` so analytics queries don't
  /// have to re-join through the work-request graph (also keeps numbers stable
  /// if `ActiveWorkflow.costUsdAccrued` is later re-shaped).
  costUsdAccrued    Float             @default(0) @map("cost_usd_accrued")
  /// Total input tokens consumed across all agent activities in this run.
  /// Populated by `finalizeWorkflowRun` alongside `costUsdAccrued`. BigInt: a
  /// long-running run's cumulative token count can exceed the INT32 ceiling.
  tokensInputTotal  BigInt            @default(0) @map("tokens_input_total")
  /// Total output tokens consumed across all agent activities in this run.
  /// Populated by `finalizeWorkflowRun` alongside `costUsdAccrued`. BigInt: a
  /// long-running run's cumulative token count can exceed the INT32 ceiling.
  tokensOutputTotal BigInt            @default(0) @map("tokens_output_total")

  /// Phase-5 run-level analytics metadata. Populated at start/finalize.
  estimatedHumanTimeSaved Float?  @map("estimated_human_time_saved")
  outcomeDomain           String? @map("outcome_domain")
  outcomeType             String? @map("outcome_type")
  hadHumanStep            Boolean @default(false) @map("had_human_step")
  wasAutonomous           Boolean @default(false) @map("was_autonomous")
  /// Phase-5 error flag. True if any non-advisory EvalResult for this run
  /// failed (GATE, ASSERT, PII, REVIEW, or HUMAN_AUDIT).
  hasError                Boolean @default(false) @map("has_error")

  /// Per-run legal hold on agent transcripts: while set, the transcript
  /// retention sweep keeps this run's transcripts past their retention. The
  /// recorder copies these onto each transcript row it opens for the run.
  transcriptLegalHold       Boolean   @default(false) @map("transcript_legal_hold")
  transcriptLegalHoldReason String?   @map("transcript_legal_hold_reason")
  transcriptLegalHoldById   String?   @map("transcript_legal_hold_by_id")
  transcriptLegalHoldAt     DateTime? @map("transcript_legal_hold_at") @db.Timestamptz

  steps             WorkflowStep[]
  artifacts         WorkflowArtifact[]
  trustedKnowledgeEvidence TrustedKnowledgeEvidence[]
  traces            AgentTrace[]
  memoryItems       MemoryItem[]
  humanSteps        WorkflowHumanStep[]
  evalResults       EvalResult[]
  outcomeReferences WorkflowOutcomeReference[]
  autonomyDecisions AutonomyDecision[]
  outboundDeliveries OutboundDelivery[]
  transcripts       AgentTranscript[]
  attributedPullRequests PullRequest[] @relation("PullRequestAttributionRun")

  @@index([templateId])
  @@index([workRequestId])
  @@index([attributedTeamId, startedAt])
  @@index([attributedOrgId, startedAt])
  @@index([launchedById])
  @@index([channelId])
  @@index([connectionId])
  // The run list (`GET /workflow-runs`) pages newest first, optionally by status.
  @@index([startedAt])
  @@index([status, startedAt])
  @@index([endedAt, startedAt])
  @@index([updatedAt, startedAt])
  @@map("workflow_runs")
}

