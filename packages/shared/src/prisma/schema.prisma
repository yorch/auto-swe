/// Singleton workflow behaviour defaults. One row (id = "default").
/// All fields have fallback values so the row is optional — the worker
/// falls back to the baked-in defaults when no row exists.
model WorkflowDefaults {
  id String @id @default("default")

  branchPrefix    String @default("auto") @map("branch_prefix")
  prTitleTemplate String @default("[auto-swe] {{ticketId}}") @map("pr_title_template")
  prBodyTemplate  String @default("") @map("pr_body_template")
  defaultTeamSlug String @default("default") @map("default_team_slug")

  // Lesson consolidation schedule. The gateway reads these on startup and on
  // every admin save, then syncs the Temporal Schedule accordingly.
  consolidationEnabled             Boolean @default(true) @map("consolidation_enabled")
  consolidationCron                String  @default("0 3 * * 0") @map("consolidation_cron")
  consolidationMinClusterSize      Int     @default(3) @map("consolidation_min_cluster_size")
  consolidationSimilarityThreshold Float   @default(0.85) @map("consolidation_similarity_threshold")

  // Nightly eval-regression schedule. Synced to a Temporal Schedule the same way
  // as consolidation. Disabled by default — it needs a seeded benchmark dataset
  // and a worker that can reach Docker + the model provider.
  evalScheduleEnabled     Boolean @default(false) @map("eval_schedule_enabled")
  evalScheduleCron        String  @default("0 7 * * *") @map("eval_schedule_cron")
  evalScheduleDatasetSlug String  @default("swe-implementer-golden") @map("eval_schedule_dataset_slug")
  evalScheduleCandidateRef String @default("main") @map("eval_schedule_candidate_ref")
  evalScheduleBaselineRef  String @default("last-release") @map("eval_schedule_baseline_ref")

  // Eval golden-set re-validation schedule. The gateway reads these on startup
  // and on PUT /api/v1/platform/config/revalidation. Disabled by default — needs seeded
  // EvalDatasets and a Docker-capable worker.
  revalidationEnabled     Boolean  @default(false) @map("revalidation_enabled")
  revalidationCron        String   @default("0 5 * * 0") @map("revalidation_cron")
  revalidationDatasetSlug String?  @map("revalidation_dataset_slug")

  // Production canary: routes a configured fraction of work-requests to a
  // candidate agent version for fast per-change A/B comparison (evals P2).
  // Disabled by default.
  canaryEnabled          Boolean @default(false) @map("canary_enabled")
  canaryAgentKey         String? @map("canary_agent_key")
  canaryCandidateVersion Int?    @map("canary_candidate_version")
  canaryPercent          Float   @default(0) @map("canary_percent")

  // ── Tier-2 operator knobs (GLOBAL) — previously hardcoded in the worker,
  //    now DB-tunable via /admin/workflow. Consumers read them through
  //    resolveWorkflowDefaults() (cached), falling back to these defaults. ──

  // Per-tier token budgets enforced by the worker's cost tracker.
  budgetStandardInputTokens  Int @default(2000000) @map("budget_standard_input_tokens")
  budgetStandardOutputTokens Int @default(500000) @map("budget_standard_output_tokens")
  budgetLargeInputTokens     Int @default(8000000) @map("budget_large_input_tokens")
  budgetLargeOutputTokens    Int @default(2000000) @map("budget_large_output_tokens")
  budgetEpicInputTokens      Int @default(20000000) @map("budget_epic_input_tokens")
  budgetEpicOutputTokens     Int @default(5000000) @map("budget_epic_output_tokens")

  // Agent refine-loop caps (quality/cost).
  maxTddIterations  Int @default(5) @map("max_tdd_iterations")
  maxEvalIterations Int @default(3) @map("max_eval_iterations")

  // Lesson (semantic-memory) retrieval relevance knobs.
  lessonRetrievalLimit     Int   @default(5) @map("lesson_retrieval_limit")
  lessonRetrievalThreshold Float @default(0.7) @map("lesson_retrieval_threshold")

  // CI-wait strategy. `signal` blocks for a GitHub webhook; `poll` actively
  // queries the CI APIs, for deployments no inbound webhook can reach
  // (local dev, air-gapped). Nullable so an unset row keeps the env fallback.
  ciWaitMode        String? @map("ci_wait_mode")
  ciPollIntervalSec Int?    @map("ci_poll_interval_sec")
  ciPollGraceSec    Int?    @map("ci_poll_grace_sec")
  ciPollDeadlineSec Int?    @map("ci_poll_deadline_sec")

  // Eval-suite health gate + LLM-judge decision thresholds.
  evalHealthMaxFlakeRate Float @default(0.1) @map("eval_health_max_flake_rate")
  evalHealthMaxStaleRate Float @default(0.1) @map("eval_health_max_stale_rate")
  evalHealthMinKappa     Float @default(0.4) @map("eval_health_min_kappa")
  evalJudgeThreshold     Float @default(0.5) @map("eval_judge_threshold")

  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("workflow_defaults")
}

