model FigmaConfig {
  id      String  @id @default("default")
  enabled Boolean @default(false)

  // AES-256-GCM encrypted Figma personal access / REST token
  apiTokenCiphertext Bytes?  @map("api_token_ciphertext")
  apiTokenNonce      Bytes?  @map("api_token_nonce")
  apiTokenAuthTag    Bytes?  @map("api_token_auth_tag")
  apiTokenKeyVersion Int?    @map("api_token_key_version")
  apiTokenLastFour   String? @map("api_token_last_four")

  // Cap on summarized nodes per work request (bounds context/cost)
  maxNodes Int? @default(12) @map("max_nodes")

  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("figma_config")
