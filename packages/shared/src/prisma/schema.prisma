  webhookSecretNonce      Bytes?  @map("webhook_secret_nonce")
  webhookSecretAuthTag    Bytes?  @map("webhook_secret_auth_tag")
  webhookSecretKeyVersion Int?    @map("webhook_secret_key_version")
  webhookSecretLastFour   String? @map("webhook_secret_last_four")
