  epicIssueType      String? @default("Epic") @map("epic_issue_type")
  storyIssueType     String? @default("Story") @map("story_issue_type")
  defaultProjectKey  String? @map("default_project_key")

  // Inbound webhooks (secret stored with same AES-256-GCM envelope as other secrets)
