// @vitest-environment jsdom

import { fireEvent, render, screen, waitFor } from '@testing-library/react';
import { beforeAll, describe, expect, it, vi } from 'vitest';
import { ConfirmModal } from './ConfirmModal';

beforeAll(() => {
  HTMLDialogElement.prototype.showModal = function (this: HTMLDialogElement) {
    this.setAttribute('open', '');
  };
  HTMLDialogElement.prototype.close = function (this: HTMLDialogElement) {
    this.removeAttribute('open');
    this.dispatchEvent(new Event('close'));
  };
});

describe('ConfirmModal', () => {
  it('disables Cancel and the close button while an async confirm is pending', async () => {
    let resolve: () => void = () => {};
    const onConfirm = vi.fn(() => new Promise<void>((r) => (resolve = r)));
    const onClose = vi.fn();
    render(
      <ConfirmModal
        confirmLabel="Delete"
        message="Gone for good."
        onClose={onClose}
        onConfirm={onConfirm}
        open
        title="Delete thing"
      />
    );
    fireEvent.click(screen.getByRole('button', { hidden: true, name: 'Delete' }));
    await waitFor(() =>
      expect(screen.getByRole('button', { hidden: true, name: 'Cancel' })).toBeDisabled()
    );
    expect(screen.getByRole('button', { hidden: true, name: 'Close' })).toBeDisabled();
    // Escape is cancelled while pending.
    const dialog = screen.getByRole('dialog', { hidden: true });
    const cancel = new Event('cancel', { cancelable: true });
    dialog.dispatchEvent(cancel);
    expect(cancel.defaultPrevented).toBe(true);
    resolve();
    await waitFor(() => expect(onClose).toHaveBeenCalledTimes(1));
  });

  it('accepts a node message', () => {
    render(
      <ConfirmModal
        message={<strong>Runs will fail</strong>}
        onClose={() => {}}
        onConfirm={() => {}}
        open
        title="Deactivate"
      />
    );
    expect(screen.getByText('Runs will fail')).toBeTruthy();
  });

  it('keeps confirm disabled until confirmText is typed exactly', () => {
    const onConfirm = vi.fn();
    render(
      <ConfirmModal
        confirmLabel="Deactivate"
        confirmText="implementer"
        message="Careful."
        onClose={() => {}}
        onConfirm={onConfirm}
        open
        title="Deactivate agent"
      />
    );
    const confirm = screen.getByRole('button', { hidden: true, name: 'Deactivate' });
    expect(confirm).toBeDisabled();
    const input = screen.getByLabelText('Type implementer to confirm');
    fireEvent.change(input, { target: { value: 'implement' } });
    expect(confirm).toBeDisabled();
    fireEvent.change(input, { target: { value: 'implementer' } });
    expect(confirm).not.toBeDisabled();
    fireEvent.click(confirm);
    expect(onConfirm).toHaveBeenCalledTimes(1);
  });
});
