# Default executor image for JVM projects (Maven; Gradle via the repo's wrapper)
FROM eclipse-temurin:24-jdk@sha256:7493205ffe6caa8074fa8a06a276bb1c5ac41d3dd0fd43a0db66d7f776e80b3e

# git is required for workspace operations, tar for copy in/out, bash for the
# agent's shell tooling, ripgrep so Pi's grep honours .gitignore. Gradle is not
# installed: JVM repos build through their checked-in ./gradlew wrapper, which
# pins the version.
RUN apt-get update \
    && apt-get install -y --no-install-recommends git ripgrep tar bash maven \
    && rm -rf /var/lib/apt/lists/*

# No daemons in the workspace: the stray-process sweep (killStrayProcessesScript)
# SIGKILLs every process outside the keeper at every authenticated git call, so
# a Gradle or Kotlin daemon would be killed and restarted each time anyway.
ENV GRADLE_OPTS="-Dorg.gradle.daemon=false -Dkotlin.compiler.execution.strategy=in-process"

WORKDIR /workspace/target-repo

# Hand ownership of the workspace tree to the base image's non-root user
# (uid 1000 — ubuntu's stock user — so no new account is needed) so the
# executor can write files at runtime (clone, build artifacts, ~/.m2,
# ~/.gradle) without EACCES.
RUN mkdir -p /workspace && chown -R 1000:1000 /workspace

USER 1000:1000
