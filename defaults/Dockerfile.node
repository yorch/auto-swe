# Default executor image for Node.js projects
FROM node:26-alpine@sha256:143494b1da2945f061539253adc65e4f1569ddf07da2d384c022c791a9d90a4a

# Install git (required for workspace operations) and ripgrep (Pi's grep
# honours .gitignore only through it)
RUN apk add --no-cache git ripgrep

# Pre-install common global tools.
#
# Corepack is explicit now: node:24-alpine shipped `yarn`, `pnpm` and `corepack`
# on PATH, and node:26-alpine ships none of them (removed from the Node
# distribution in Node 25). Without this, an agent handed a Yarn or pnpm target
# repo hits `yarn: not found` on its first install command.
RUN npm install -g typescript corepack && corepack enable

# Pre-install package managers so a workspace with no `packageManager` pin (or
# a pin matching these versions) needs no Corepack download at run time — and
# so the registry proxy never sees an unauthenticated bootstrap fetch. The
# versions are pinned because Corepack caches by exact version.
ENV COREPACK_HOME=/usr/local/share/corepack
RUN mkdir -p "$COREPACK_HOME" && \
    corepack prepare yarn@1.22.22 --activate && \
    corepack prepare pnpm@10.34.7 --activate && \
    corepack prepare yarn@4.18.1 && \
    chown -R node:node "$COREPACK_HOME"

WORKDIR /workspace/target-repo

# Hand ownership of the workspace tree to `node` so the executor can write files
# at runtime (clone, build artifacts, etc.) without hitting EACCES.
RUN mkdir -p /workspace && chown -R node:node /workspace

USER node
